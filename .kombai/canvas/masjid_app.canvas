      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  :root{\n    --ink:#0A1F17;\n    --green:#0D5C3A;\n    --accent:#047857;\n    --tint:#F0F9F5;\n    --gold:#F59E0B;\n    --gold-tint:#FFFDF5;\n    --gold-ink:#B45309;\n    --gold-line:#FDE68A;\n    --bg:#F5F3EF;\n    --surface:#FFFFFF;\n    --border:#E8E4DE;\n    --muted:#EFECE7;\n    --text:#18181B;\n    --sec:#6B6560;\n    --tert:#9C9590;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;background:var(--surface);}\n  body{\n    font-family:'Inter','Noto Sans Tamil',system-ui,-apple-system,sans-serif;\n    -webkit-font-smoothing:antialiased;\n    color:var(--text);\n    display:flex;justify-content:center;\n  }\n\n  .phone{\n    position:relative;\n    width:390px;height:100dvh;min-height:844px;\n    background:var(--bg);\n    display:flex;flex-direction:column;\n    overflow:hidden;\n  }\n\n  /* ---------- status bar ---------- */\n  .statusbar{\n    height:44px;flex:0 0 44px;\n    padding:0 24px;\n    display:flex;align-items:center;justify-content:space-between;\n    color:var(--ink);\n    font-size:14px;font-weight:600;letter-spacing:-0.01em;\n  }\n  .statusbar .sys{display:flex;align-items:center;gap:5px;font-size:15px;}\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    flex:0 0 56px;height:56px;\n    display:flex;align-items:center;\n    padding:0 8px;\n    border-bottom:1px solid rgba(232,228,222,0.75);\n  }\n  .iconbtn{\n    width:44px;height:44px;border:0;background:transparent;\n    display:flex;align-items:center;justify-content:center;\n    border-radius:999px;color:var(--ink);\n    font-size:21px;cursor:pointer;\n    transition:transform 120ms ease, background 160ms ease;\n  }\n  .iconbtn:active{transform:scale(0.94);background:rgba(10,31,23,0.05);}\n  .topbar .route{\n    flex:1;text-align:center;\n    font-size:15px;font-weight:600;letter-spacing:-0.01em;color:var(--text);\n  }\n  .topbar .alwayspace{width:44px;height:44px;}\n\n  /* ---------- scroll ---------- */\n  .scroll{\n    flex:1 1 auto;\n    overflow-y:auto;\n    overscroll-behavior:contain;\n    padding:20px 20px 96px;\n    scrollbar-width:none;\n  }\n  .scroll::-webkit-scrollbar{display:none;}\n\n  .reveal{opacity:0;animation:rise 560ms cubic-bezier(.22,.61,.36,1) forwards;}\n  .d1{animation-delay:40ms;} .d2{animation-delay:100ms;}\n  .d3{animation-delay:160ms;} .d4{animation-delay:220ms;}\n  @keyframes rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}\n\n  /* ---------- header ---------- */\n  .cat{\n    display:inline-flex;align-items:center;\n    height:22px;padding:0 8px;\n    background:var(--muted);\n    border:1px solid var(--border);\n    border-radius:6px;\n    color:var(--sec);\n    font-size:11px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;\n  }\n  h1{\n    margin:12px 0 0;\n    font-size:24px;font-weight:600;line-height:30px;letter-spacing:-0.018em;\n    color:var(--text);\n  }\n  .published{\n    margin:8px 0 0;\n    font-size:13px;font-weight:500;color:var(--tert);\n  }\n\n  /* ---------- event metadata ---------- */\n  .meta{\n    margin-top:20px;\n    background:var(--surface);\n    border:1px solid var(--border);\n    border-radius:16px;\n    padding:4px 16px;\n    box-shadow:0 1px 3px rgba(10,31,23,0.035);\n  }\n  .meta-row{\n    display:flex;align-items:flex-start;gap:12px;\n    padding:13px 0;\n  }\n  .meta-row + .meta-row{border-top:1px solid #F1EDE7;}\n  .meta-row i{font-size:18px;line-height:20px;color:var(--accent);margin-top:1px;}\n  .meta-val{font-size:15px;font-weight:600;line-height:20px;color:var(--text);letter-spacing:-0.005em;}\n  .meta-sub{font-size:13px;font-weight:500;line-height:18px;color:var(--sec);margin-top:2px;}\n  .meta-label{\n    font-size:10.5px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;\n    color:var(--tert);margin-bottom:2px;\n  }\n\n  /* ---------- language segmented ---------- */\n  .seg{\n    position:relative;\n    margin-top:20px;\n    display:flex;\n    height:40px;\n    background:var(--muted);\n    border-radius:999px;\n    padding:4px;\n  }\n  .seg-thumb{\n    position:absolute;top:4px;bottom:4px;left:4px;\n    width:calc(50% - 4px);\n    background:var(--surface);\n    border-radius:999px;\n    box-shadow:0 1px 3px rgba(10,31,23,0.10), 0 0 0 1px rgba(10,31,23,0.03);\n    transition:transform 220ms cubic-bezier(.32,.72,0,1);\n  }\n  .seg-btn{\n    position:relative;z-index:1;\n    flex:1;border:0;background:transparent;\n    font-family:inherit;font-size:14px;font-weight:600;\n    color:var(--sec);\n    border-radius:999px;cursor:pointer;\n    transition:color 180ms ease;\n  }\n  .seg-btn.is-on{color:var(--green);}\n  .seg-btn:active{transform:scale(0.98);}\n\n  /* ---------- body ---------- */\n  .body-stack{margin-top:18px;}\n  .lang-panel{display:none;}\n  .lang-panel.is-shown{display:block;animation:langIn 180ms ease-out both;}\n  @keyframes langIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}\n\n  .lang-panel p{\n    margin:0 0 16px;\n    font-size:16px;line-height:24px;font-weight:400;\n    color:#211E1B;\n    letter-spacing:-0.003em;\n  }\n  .lang-panel p:last-child{margin-bottom:0;}\n  .lang-panel.ta p{\n    font-family:'Noto Sans Tamil','Inter',sans-serif;\n    line-height:28px;\n    font-size:16px;\n    color:#211E1B;\n  }\n\n  /* ---------- sticky action bar ---------- */\n  .actionbar{\n    position:absolute;left:0;right:0;bottom:80px;\n    height:72px;\n    display:flex;align-items:center;gap:10px;\n    padding:0 20px;\n    background:var(--bg);\n  }\n  .actionbar::before{\n    content:'';\n    position:absolute;left:0;right:0;bottom:100%;height:34px;\n    background:linear-gradient(to top, var(--bg) 24%, rgba(245,243,239,0));\n    pointer-events:none;\n  }\n  .btn{\n    height:44px;border-radius:999px;\n    display:inline-flex;align-items:center;justify-content:center;gap:8px;\n    font-family:inherit;font-size:14.5px;font-weight:600;\n    cursor:pointer;border:1px solid transparent;\n    transition:transform 120ms ease, background 160ms ease, box-shadow 160ms ease;\n    white-space:nowrap;\n  }\n  .btn:active{transform:scale(0.97);}\n  .btn-primary{\n    flex:1;\n    background:var(--green);\n    color:#fff;\n    box-shadow:0 1px 2px rgba(10,31,23,0.18), 0 6px 16px -6px rgba(13,92,58,0.45);\n    font-size:15px;\n  }\n  .btn-primary i{font-size:18px;}\n  .btn-ghost{\n    background:var(--surface);\n    border-color:var(--border);\n    color:var(--text);\n    padding:0 18px;\n    box-shadow:0 1px 2px rgba(10,31,23,0.04);\n  }\n  .btn-ghost i{font-size:17px;color:var(--sec);}\n\n  /* ---------- tab bar ---------- */\n  .tabbar{\n    flex:0 0 80px;height:80px;\n    display:flex;align-items:center;\n    padding:0 8px 8px;\n    background:var(--surface);\n    border-top:1px solid var(--border);\n  }\n  .tab{\n    flex:1;\n    display:flex;flex-direction:column;align-items:center;gap:5px;\n    color:var(--tert);\n    background:none;border:0;cursor:pointer;\n    font-family:inherit;\n    transition:transform 120ms ease;\n  }\n  .tab:active{transform:scale(0.97);}\n  .tab i{font-size:21px;line-height:21px;}\n  .tab span{font-size:11px;font-weight:600;letter-spacing:0.005em;}\n  .tab.is-on{color:var(--accent);}\n</style>\n<div class=\"phone\" data-kid=\"1\" data-name=\"mobile app phone frame container\">\n<!-- status bar -->\n<div class=\"statusbar\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<div data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"status bar clock time\" data-reason=\"time rewritten to current time every 30s by clock script\">12:38</div>\n<div class=\"sys\" data-kid=\"1-1-2\" data-name=\"status bar system icons group\">\n<i class=\"icon-signal\" data-kid=\"1-1-2-1\" data-name=\"cellular signal strength icon\"></i>\n<i class=\"icon-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi signal strength icon\"></i>\n<i class=\"icon-battery-full\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<!-- top bar -->\n<header class=\"topbar\" data-kid=\"1-2\" data-name=\"top navigation bar\">\n<button aria-label=\"Back to notices\" class=\"iconbtn\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n<i class=\"icon-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"left chevron back icon\"></i>\n</button>\n<div class=\"route\" data-kid=\"1-2-2\" data-name=\"top bar page title text\">Notices</div>\n<button aria-label=\"Share this notice\" class=\"iconbtn\" data-kid=\"1-2-3\" data-name=\"share notice button\">\n<i class=\"icon-share-2\" data-kid=\"1-2-3-1\" data-name=\"share icon\"></i>\n</button>\n</header>\n<!-- scrollable content -->\n<main class=\"scroll\" data-kid=\"1-3\" data-name=\"main scrollable content area\">\n<div class=\"reveal d1\" data-kid=\"1-3-1\" data-name=\"article header block\">\n<span class=\"cat\" data-kid=\"1-3-1-1\" data-name=\"category label badge\">Bayan</span>\n<h1 data-kid=\"1-3-1-2\" data-name=\"article headline title\">Weekly Jumu’ah Bayan</h1>\n<p class=\"published\" data-kid=\"1-3-1-3\" data-name=\"published date text\">Published 5 November 2026</p>\n</div>\n<section aria-label=\"Event details\" class=\"meta reveal d2\" data-kid=\"1-3-2\" data-name=\"event details metadata card\">\n<div class=\"meta-row\" data-kid=\"1-3-2-1\" data-name=\"event date metadata row\">\n<i class=\"icon-calendar\" data-kid=\"1-3-2-1-1\" data-name=\"calendar date icon\"></i>\n<div data-kid=\"1-3-2-1-2\" data-name=\"event date text group\">\n<div class=\"meta-label\" data-kid=\"1-3-2-1-2-1\" data-name=\"meta row category label\">Event</div>\n<div class=\"meta-val\" data-kid=\"1-3-2-1-2-2\" data-name=\"event date value text\">Friday, 6 November 2026</div>\n<div class=\"meta-sub\" data-kid=\"1-3-2-1-2-3\" data-name=\"event time range text\">12:45 PM – 1:15 PM</div>\n</div>\n</div>\n<div class=\"meta-row\" data-kid=\"1-3-2-2\" data-name=\"speaker metadata row\">\n<i class=\"icon-user\" data-kid=\"1-3-2-2-1\" data-name=\"speaker person icon\"></i>\n<div data-kid=\"1-3-2-2-2\" data-name=\"speaker name text group\">\n<div class=\"meta-label\" data-kid=\"1-3-2-2-2-1\" data-name=\"meta row speaker label\">Speaker</div>\n<div class=\"meta-val\" data-kid=\"1-3-2-2-2-2\" data-name=\"speaker name value text\">Moulavi Abdul Rahman</div>\n</div>\n</div>\n</section>\n<div aria-label=\"Language\" class=\"seg reveal d3\" data-kid=\"1-3-3\" data-name=\"language selector segmented control\" role=\"tablist\">\n<span class=\"seg-thumb\" data-kid=\"1-3-3-1\" data-name=\"segmented control sliding thumb\" id=\"segThumb\"></span>\n<button aria-selected=\"true\" class=\"seg-btn is-on\" data-kid=\"1-3-3-2\" data-lang=\"en\" data-name=\"English language tab button\" role=\"tab\">English</button>\n<button aria-selected=\"false\" class=\"seg-btn\" data-kid=\"1-3-3-3\" data-lang=\"ta\" data-name=\"Tamil language tab button\" role=\"tab\">தமிழ்</button>\n</div>\n<div class=\"body-stack reveal d4\" data-kid=\"1-3-4\" data-name=\"article body language panels wrapper\">\n<div class=\"lang-panel is-shown en\" data-kid=\"1-3-4-1\" data-name=\"English language article panel\" data-panel=\"en\">\n<p data-kid=\"1-3-4-1-1\" data-name=\"English article paragraph 1\">This week’s Jumu’ah bayan will be delivered by Moulavi Abdul Rahman. The talk covers the etiquettes of the khutbah: arriving before the bayan begins, taking a place close to the mimbar, and keeping conversation away from the prayer hall.</p>\n<p data-kid=\"1-3-4-1-2\" data-name=\"English article paragraph 2\">The Jumu’ah azan is called at 12:30 PM, the bayan begins at 12:45 PM and runs for about twenty-five minutes, and the iqamah is at 1:15 PM. Members are requested to arrive before 12:45 PM so that the first rows can be filled.</p>\n<p data-kid=\"1-3-4-1-3\" data-name=\"English article paragraph 3\">The talk is delivered in Tamil with Qur’anic references in Arabic. Printed translation notes are kept at the entrance. Please silence mobile phones before entering the prayer hall.</p>\n</div>\n<div class=\"lang-panel ta\" data-kid=\"1-3-4-2\" data-name=\"Tamil language article panel\" data-panel=\"ta\">\n<p data-kid=\"1-3-4-2-1\" data-name=\"Tamil article paragraph 1\">இந்த வார ஜும்ஆ பயான் மௌலவி அப்துல் ரஹ்மான் அவர்களால் நிகழ்த்தப்படும். பயான் தொடங்கும் முன் வந்து அமர்வது, மிம்பருக்கு அருகில் இடம் பெறுவது, தொழுகைக் கூடத்தில் பேச்சைத் தவிர்ப்பது ஆகியவை இந்த உரையின் முக்கிய அம்சங்கள்.</p>\n<p data-kid=\"1-3-4-2-2\" data-name=\"Tamil article paragraph 2\">ஜும்ஆ பாங்கு மதியம் 12:30 மணிக்கு அழைக்கப்படும், பயான் 12:45 மணிக்கு தொடங்கி சுமார் இருபத்தைந்து நிமிடங்கள் நடைபெறும். இகாமத் 1:15 மணிக்கு நடைபெறும். முதல் வரிசைகள் நிரம்பும் வகையில் 12:45 மணிக்கு முன்பே வருமாறு கேட்டுக்கொள்ளப்படுகிறது.</p>\n<p data-kid=\"1-3-4-2-3\" data-name=\"Tamil article paragraph 3\">உரை தமிழில், குர்ஆன் மேற்கோள்கள் அரபு மொழியில் அமைந்திருக்கும். மொழிபெயர்ப்புக் குறிப்புகள் நுழைவாயிலில் வைக்கப்பட்டுள்ளன. தொழுகைக் கூடத்திற்குள் நுழையும் முன் கைபேசிகளை அமைதியாக்கவும்.</p>\n</div>\n</div>\n</main>\n<!-- sticky actions -->\n<div class=\"actionbar\" data-kid=\"1-4\" data-name=\"sticky bottom action bar\">\n<button class=\"btn btn-primary\" data-kid=\"1-4-1\" data-name=\"add-to-calendar primary button\" id=\"calBtn\">\n<i class=\"icon-calendar\" data-dynamic=\"true\" data-kid=\"1-4-1-1\" data-name=\"calendar action icon\" data-reason=\"icon class swapped to check then reverted by calendar click handler\" id=\"calIcon\"></i>\n<span data-dynamic=\"true\" data-kid=\"1-4-1-2\" data-name=\"add-to-calendar button label\" data-reason=\"label text replaced with 'Added to Calendar' and reverted by calendar handler\" id=\"calLabel\">Add to Calendar</span>\n</button>\n<button aria-label=\"Share this notice\" class=\"btn btn-ghost\" data-kid=\"1-4-2\" data-name=\"share notice ghost button\">\n<i class=\"icon-share-2\" data-kid=\"1-4-2-1\" data-name=\"share icon\"></i>\n<span data-kid=\"1-4-2-2\" data-name=\"share button label text\">Share</span>\n</button>\n</div>\n<!-- tab bar -->\n<nav class=\"tabbar\" data-kid=\"1-5\" data-name=\"bottom navigation tab bar\">\n<button class=\"tab\" data-kid=\"1-5-1\" data-name=\"home tab button\"><i class=\"icon-house\" data-kid=\"1-5-1-1\" data-name=\"home tab house icon\"></i><span data-kid=\"1-5-1-2\" data-name=\"home tab label\">Home</span></button>\n<button class=\"tab\" data-kid=\"1-5-2\" data-name=\"timetable tab button\"><i class=\"icon-calendar-days\" data-kid=\"1-5-2-1\" data-name=\"timetable calendar icon\"></i><span data-kid=\"1-5-2-2\" data-name=\"timetable tab label\">Timetable</span></button>\n<button class=\"tab is-on\" data-kid=\"1-5-3\" data-name=\"notices active tab button\"><i class=\"icon-bell\" data-kid=\"1-5-3-1\" data-name=\"notices bell icon\"></i><span data-kid=\"1-5-3-2\" data-name=\"notices tab label\">Notices</span></button>\n<button class=\"tab\" data-kid=\"1-5-4\" data-name=\"settings tab button\"><i class=\"icon-settings\" data-kid=\"1-5-4-1\" data-name=\"settings gear icon\"></i><span data-kid=\"1-5-4-2\" data-name=\"settings tab label\">Settings</span></button>\n</nav>\n</div>\n<script>\n  (function () {\n    var thumb = document.getElementById('segThumb');\n    var buttons = Array.prototype.slice.call(document.querySelectorAll('.seg-btn'));\n    var panels = Array.prototype.slice.call(document.querySelectorAll('.lang-panel'));\n    var current = 'en';\n\n    function setLang(lang) {\n      if (lang === current) return;\n      current = lang;\n\n      thumb.style.transform = lang === 'ta' ? 'translateX(100%)' : 'translateX(0)';\n\n      buttons.forEach(function (b) {\n        var on = b.dataset.lang === lang;\n        b.classList.toggle('is-on', on);\n        b.setAttribute('aria-selected', on ? 'true' : 'false');\n      });\n\n      panels.forEach(function (p) {\n        p.classList.toggle('is-shown', p.dataset.panel === lang);\n      });\n    }\n\n    buttons.forEach(function (b) {\n      b.addEventListener('click', function () { setLang(b.dataset.lang); });\n    });\n\n    var calBtn = document.getElementById('calBtn');\n    var calLabel = document.getElementById('calLabel');\n    var calIcon = document.getElementById('calIcon');\n    var timer = null;\n\n    calBtn.addEventListener('click', function () {\n      if (calBtn.dataset.done === '1') return;\n      calBtn.dataset.done = '1';\n      calLabel.textContent = 'Added to Calendar';\n      calIcon.className = 'icon-check';\n      clearTimeout(timer);\n      timer = setTimeout(function () {\n        calBtn.dataset.done = '0';\n        calLabel.textContent = 'Add to Calendar';\n        calIcon.className = 'icon-calendar';\n      }, 2600);\n    });\n  })();\n</script>",
      "comments": [],
      "created": "2026-11-06T14:19:50.537541+00:00",
      "modified": "2026-11-06T14:29:36.391573+00:00",
      "id": "var_51f294891339",
      "contentHeight": 1000
    },
    "var_7095d1367d9e": {
      "type": "variant",
      "label": "Home — Next event & today's schedule",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 980,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n:root{\n  --ink:#0A1F17;\n  --ink-border:#122E22;\n  --green:#0D5C3A;\n  --accent:#047857;\n  --accent-tint:#F0F9F5;\n  --gold:#F59E0B;\n  --gold-ink:#8A5C08;\n  --gold-tint:#FFFDF5;\n  --bg:#F5F3EF;\n  --surface:#FFFFFF;\n  --border:#E8E4DE;\n  --muted:#EFECE7;\n  --text:#18181B;\n  --secondary:#6B6560;\n  --tertiary:#9C9590;\n  --danger:#DC2626;\n  --ease:cubic-bezier(0.22,1,0.36,1);\n}\n\n*{box-sizing:border-box;}\n\nhtml,body{margin:0;padding:0;background:var(--bg);}\n\n.phone{\n  width:390px;height:100vh;min-height:844px;\n  display:flex;flex-direction:column;\n  background:var(--bg);\n  overflow:hidden;\n  font-family:'Inter',system-ui,-apple-system,sans-serif;\n  color:var(--text);\n  -webkit-font-smoothing:antialiased;\n  text-rendering:optimizeLegibility;\n}\n\n/* ── status area ───────────────────────────── */\n.status{\n  height:44px;flex:none;\n  display:flex;align-items:center;justify-content:space-between;\n  padding:6px 20px 0;\n}\n.status-time{\n  font-size:12.5px;font-weight:600;letter-spacing:.01em;\n  font-variant-numeric:tabular-nums;\n}\n.status-icons{display:flex;align-items:center;gap:5px;color:#18181B;}\n.status-icons i{font-size:13px;line-height:1;}\n\n/* ── masthead ──────────────────────────────── */\n.masthead{\n  height:64px;flex:none;\n  display:flex;align-items:center;justify-content:space-between;\n  gap:12px;padding:0 16px;\n}\n.masjid{\n  margin:0;font-size:18px;font-weight:600;\n  letter-spacing:-0.02em;line-height:1.15;\n}\n.arabic{\n  font-family:'Noto Naskh Arabic',serif;font-weight:700;\n  font-size:13px;line-height:1.5;color:var(--secondary);\n  margin-top:1px;\n}\n\n.lang{\n  display:flex;align-items:center;flex:none;\n  height:30px;padding:3px;border-radius:999px;\n  background:var(--muted);\n}\n.lang-opt{\n  display:flex;align-items:center;\n  height:24px;padding:0 9px;border:0;border-radius:999px;\n  background:transparent;cursor:pointer;\n  font-family:'Inter',sans-serif;font-size:11.5px;font-weight:600;\n  color:#8A837C;line-height:1;\n  transition:background 200ms var(--ease),color 200ms var(--ease);\n}\n.lang-opt.ta{font-family:'Noto Sans Tamil','Inter',sans-serif;font-size:11px;padding:0 8px;}\n.lang-opt.on{\n  background:#fff;color:var(--green);\n  box-shadow:0 1px 2px rgba(10,31,23,.10);\n}\n.lang-opt:active{transform:scale(.97);}\n\n/* ── scrolling content ─────────────────────── */\n.content{\n  flex:1;min-height:0;\n  padding:0 16px;\n  overflow-y:auto;overflow-x:hidden;\n  scrollbar-width:none;\n}\n.content::-webkit-scrollbar{display:none;}\n\n.dateline{\n  height:28px;display:flex;align-items:center;\n  font-size:12.5px;font-weight:500;color:var(--secondary);\n}\n\n/* ── next event ────────────────────────────── */\n.next{\n  background:var(--ink);\n  border:1px solid var(--ink-border);\n  border-radius:24px;\n  padding:14px 16px 15px;\n  color:#fff;\n}\n.next-top{\n  display:flex;align-items:baseline;justify-content:space-between;gap:10px;\n}\n.next-label{\n  font-size:11px;font-weight:600;letter-spacing:.08em;\n  text-transform:uppercase;color:rgba(255,255,255,.62);\n  white-space:nowrap;\n}\n.next-ar{\n  font-family:'Noto Naskh Arabic',serif;font-weight:700;\n  font-size:19px;line-height:1;color:rgba(255,255,255,.7);\n}\n.next-mid{\n  display:flex;align-items:flex-end;justify-content:space-between;\n  gap:12px;margin-top:6px;\n}\n.next-time{\n  font-size:34px;line-height:1.06;font-weight:600;\n  letter-spacing:-0.025em;font-variant-numeric:tabular-nums;\n}\n.cd{text-align:right;padding-bottom:3px;}\n.cd-cap{\n  display:block;font-size:9.5px;font-weight:600;\n  letter-spacing:.09em;text-transform:uppercase;\n  color:rgba(255,255,255,.5);\n}\n.cd-val{\n  display:block;margin-top:2px;\n  font-size:16px;font-weight:600;letter-spacing:.02em;\n  color:var(--gold);font-variant-numeric:tabular-nums;\n}\n.next-pair{\n  display:flex;align-items:center;gap:10px;\n  margin-top:12px;padding-top:11px;\n  border-top:1px solid var(--ink-border);\n}\n.pair{display:flex;align-items:baseline;gap:6px;}\n.pair-k{\n  font-size:9.5px;font-weight:600;letter-spacing:.09em;\n  text-transform:uppercase;color:rgba(255,255,255,.45);\n}\n.pair-v{\n  font-size:13px;font-weight:500;color:rgba(255,255,255,.6);\n  font-variant-numeric:tabular-nums;\n}\n.pair.next-up{margin-left:auto;}\n.pair.next-up .pair-k{color:rgba(245,158,11,.85);}\n.pair.next-up .pair-v{color:#fff;font-weight:600;}\n.pair-arrow{\n  display:flex;align-items:center;\n  color:rgba(255,255,255,.3);font-size:11px;\n}\n\n/* ── urgent ────────────────────────────────── */\n.urgent{\n  margin-top:12px;\n  display:flex;align-items:center;gap:8px;\n  padding:11px 12px;\n  background:var(--gold-tint);\n  border:1px solid rgba(245,158,11,.34);\n  border-radius:16px;\n  cursor:pointer;\n  transition:transform 200ms var(--ease),background 200ms var(--ease);\n}\n.urgent:active{transform:scale(.97);}\n.urgent-body{flex:1;min-width:0;}\n.urgent-flag{\n  display:flex;align-items:center;gap:5px;\n  font-size:9.5px;font-weight:700;letter-spacing:.1em;\n  text-transform:uppercase;color:var(--gold-ink);\n}\n.urgent-flag .dot{\n  width:5px;height:5px;border-radius:999px;background:var(--gold);\n  flex:none;\n}\n.urgent-title{\n  display:block;margin-top:3px;\n  font-size:13px;font-weight:500;line-height:1.35;color:var(--text);\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n.urgent .chev{font-size:15px;color:#B49A6B;flex:none;}\n\n/* ── update ────────────────────────────────── */\n.update{\n  margin-top:12px;height:44px;\n  display:flex;align-items:center;gap:8px;\n  padding:0 8px 0 12px;\n  background:var(--muted);border-radius:12px;\n}\n.update .ic{font-size:14px;color:#8A837C;flex:none;}\n.update-text{\n  flex:1;min-width:0;\n  font-size:12.5px;font-weight:500;color:#18181B;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n.update-btn{\n  flex:none;height:26px;padding:0 11px;border:0;border-radius:999px;\n  background:var(--green);color:#fff;\n  font-family:'Inter',sans-serif;font-size:11.5px;font-weight:600;\n  cursor:pointer;transition:transform 200ms var(--ease);\n}\n.update-btn:active{transform:scale(.97);}\n.dismiss{\n  width:26px;height:26px;flex:none;\n  display:grid;place-items:center;\n  border:0;background:transparent;cursor:pointer;\n  color:#8A837C;font-size:13px;\n}\n\n/* ── schedule table ────────────────────────── */\n.sched{\n  margin-top:12px;\n  background:var(--surface);\n  border:1px solid var(--border);\n  border-radius:16px;\n  overflow:hidden;\n}\n.sched-head{\n  display:grid;grid-template-columns:1fr 84px 84px;\n  align-items:center;height:29px;padding:0 14px;\n  font-size:10.5px;font-weight:600;letter-spacing:.08em;\n  text-transform:uppercase;color:var(--tertiary);\n}\n.sched-head span:not(:first-child){text-align:right;}\n\n.row{\n  display:grid;grid-template-columns:1fr 84px 84px;\n  align-items:center;\n  padding:0 14px;height:52px;\n  border-top:1px solid #F2EFE9;\n}\n.row.friday{height:68px;background:rgba(4,120,87,.05);}\n.p-name{\n  display:flex;align-items:center;gap:7px;\n  font-size:15px;font-weight:500;color:var(--text);\n  line-height:1.2;\n}\n.dot-live{\n  width:5px;height:5px;border-radius:999px;\n  background:var(--accent);flex:none;\n}\n.p-sub{\n  margin-top:2px;\n  font-size:11.5px;font-weight:500;line-height:1.2;\n  color:var(--gold-ink);\n  font-variant-numeric:tabular-nums;\n}\n.p-time{\n  font-size:15px;text-align:right;color:var(--secondary);\n  font-variant-numeric:tabular-nums;\n}\n.p-iq{\n  font-size:15px;font-weight:600;text-align:right;color:var(--text);\n  font-variant-numeric:tabular-nums;\n}\n.row.friday .p-iq{color:var(--green);}\n\n.sched-foot{\n  display:flex;align-items:center;justify-content:space-between;\n  height:28px;padding:0 14px;\n  border-top:1px solid #F2EFE9;\n  font-size:11.5px;font-weight:500;color:var(--tertiary);\n}\n.sched-foot b{font-weight:500;font-variant-numeric:tabular-nums;}\n\n/* ── address ───────────────────────────────── */\n.addr{margin-top:28px;padding:0 2px;}\n.addr-line{\n  display:flex;gap:8px;align-items:flex-start;\n  font-size:12.5px;line-height:1.45;color:var(--secondary);\n}\n.addr-line i{font-size:14px;color:var(--tertiary);margin-top:1px;flex:none;}\n.maps{\n  display:inline-flex;align-items:center;gap:5px;\n  margin:8px 0 0 22px;\n  font-size:12.5px;font-weight:600;color:var(--green);\n  text-decoration:none;cursor:pointer;\n}\n.maps i{font-size:12px;}\n.maps:active{opacity:.7;}\n\n.lastupd{\n  margin:14px 2px 20px;\n  font-size:11px;color:var(--tertiary);letter-spacing:.01em;\n}\n\n/* ── tab bar ───────────────────────────────── */\n.tabbar{\n  height:80px;flex:none;\n  display:flex;align-items:center;\n  padding:8px 6px 16px;\n  background:var(--surface);\n  border-top:1px solid var(--border);\n}\n.tab{\n  flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;\n  border:0;background:transparent;cursor:pointer;padding:0;\n  color:var(--tertiary);\n  font-family:'Inter',sans-serif;\n  transition:color 200ms var(--ease);\n}\n.tab .ic{\n  width:44px;height:28px;display:grid;place-items:center;\n  border-radius:999px;font-size:19px;line-height:1;\n  transition:background 220ms var(--ease),color 220ms var(--ease);\n}\n.tab span{font-size:10.5px;font-weight:600;letter-spacing:.01em;}\n.tab.on{color:var(--green);}\n.tab.on .ic{background:var(--accent-tint);color:var(--green);}\n.tab:active .ic{transform:scale(.97);}\n\n/* ── entrance ──────────────────────────────── */\n@keyframes rise{\n  from{opacity:0;transform:translateY(9px);}\n  to{opacity:1;transform:none;}\n}\n.reveal{animation:rise 240ms var(--ease) backwards;animation-delay:var(--d,0ms);}\n</style>\n<div class=\"phone\" data-kid=\"1\" data-name=\"phone frame app container\">\n<div class=\"status\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span class=\"status-time\" data-kid=\"1-1-1\" data-name=\"status bar time\">12:32</span>\n<span class=\"status-icons\" data-kid=\"1-1-2\" data-name=\"status icons group\">\n<i class=\"icon-signal\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"></i>\n<i class=\"icon-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"></i>\n<i class=\"icon-battery-full\" data-kid=\"1-1-2-3\" data-name=\"battery icon\"></i>\n</span>\n</div>\n<header class=\"masthead\" data-kid=\"1-2\" data-name=\"app masthead header\">\n<div class=\"reveal\" data-kid=\"1-2-1\" data-name=\"masjid identity block\" style=\"--d:0ms\">\n<h1 class=\"masjid\" data-kid=\"1-2-1-1\" data-name=\"masjid name headline\">Masjidul Ihsaan</h1>\n<div class=\"arabic\" data-kid=\"1-2-1-2\" data-name=\"arabic masjid name text\">مَسْجِدُ الْإِحْسَانِ</div>\n</div>\n<div class=\"lang reveal\" data-kid=\"1-2-2\" data-name=\"language toggle pill\" style=\"--d:40ms\">\n<button class=\"lang-opt on\" data-kid=\"1-2-2-1\" data-name=\"English language option (active)\">EN</button>\n<button class=\"lang-opt ta\" data-kid=\"1-2-2-2\" data-name=\"Tamil language option\">தமிழ்</button>\n</div>\n</header>\n<main class=\"content\" data-kid=\"1-3\" data-name=\"scrollable main content\">\n<div class=\"dateline reveal\" data-kid=\"1-3-1\" data-name=\"date dateline\" style=\"--d:60ms\">Friday, 6 November 2026</div>\n<section class=\"next reveal\" data-kid=\"1-3-2\" data-name=\"next event card with countdown\" style=\"--d:80ms\">\n<div class=\"next-top\" data-kid=\"1-3-2-1\" data-name=\"next event header row\">\n<span class=\"next-label\" data-kid=\"1-3-2-1-1\" data-name=\"next event label\">Jumu'ah Iqamah</span>\n<span class=\"next-ar\" data-kid=\"1-3-2-1-2\" data-name=\"next event arabic word\">جمعة</span>\n</div>\n<div class=\"next-mid\" data-kid=\"1-3-2-2\" data-name=\"next event time and countdown row\">\n<span class=\"next-time\" data-kid=\"1-3-2-2-1\" data-name=\"next event time\">1:15 PM</span>\n<div class=\"cd\" data-kid=\"1-3-2-2-2\" data-name=\"countdown block\">\n<span class=\"cd-cap\" data-kid=\"1-3-2-2-2-1\" data-name=\"countdown caption\">Remaining</span>\n<span class=\"cd-val\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-2\" data-name=\"countdown timer value\" data-reason=\"text replaced every second by countdown script\" id=\"cd\">00:42:16</span>\n</div>\n</div>\n<div class=\"next-pair\" data-kid=\"1-3-2-3\" data-name=\"azan-to-iqamah timeline row\">\n<span class=\"pair\" data-kid=\"1-3-2-3-1\" data-name=\"azan time pair\">\n<span class=\"pair-k\" data-kid=\"1-3-2-3-1-1\" data-name=\"azan label\">Azan</span>\n<span class=\"pair-v\" data-kid=\"1-3-2-3-1-2\" data-name=\"azan time value\">12:30 PM</span>\n</span>\n<span class=\"pair-arrow\" data-kid=\"1-3-2-3-2\" data-name=\"arrow between prayer times\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-3-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"pair next-up\" data-kid=\"1-3-2-3-3\" data-name=\"iqamah time pair (highlighted)\">\n<span class=\"pair-k\" data-kid=\"1-3-2-3-3-1\" data-name=\"iqamah label\">Iqamah</span>\n<span class=\"pair-v\" data-kid=\"1-3-2-3-3-2\" data-name=\"iqamah time value\">1:15 PM</span>\n</span>\n</div>\n</section>\n<div class=\"urgent reveal\" data-kid=\"1-3-3\" data-name=\"urgent announcement banner\" style=\"--d:120ms\">\n<div class=\"urgent-body\" data-kid=\"1-3-3-1\" data-name=\"urgent announcement body\">\n<span class=\"urgent-flag\" data-kid=\"1-3-3-1-1\" data-name=\"urgent flag with dot\"><span class=\"dot\" data-kid=\"1-3-3-1-1-1\" data-name=\"pulsing dot indicator\"></span>Urgent</span>\n<span class=\"urgent-title\" data-kid=\"1-3-3-1-2\" data-name=\"urgent announcement text\">Isha Iqamah moved to 8:15 PM from this week</span>\n</div>\n<i class=\"icon-chevron-right chev\" data-kid=\"1-3-3-2\" data-name=\"right chevron icon\"></i>\n</div>\n<div class=\"update reveal\" data-kid=\"1-3-4\" data-name=\"app update banner\" style=\"--d:160ms\">\n<i class=\"icon-download ic\" data-kid=\"1-3-4-1\" data-name=\"download icon\"></i>\n<span class=\"update-text\" data-kid=\"1-3-4-2\" data-name=\"update available message\">Version 1.0.1 available</span>\n<button class=\"update-btn\" data-kid=\"1-3-4-3\" data-name=\"update call-to-action button\">Update</button>\n<button aria-label=\"Dismiss\" class=\"dismiss\" data-kid=\"1-3-4-4\" data-name=\"dismiss banner button\"><i class=\"icon-x\" data-kid=\"1-3-4-4-1\" data-name=\"close (x) icon\"></i></button>\n</div>\n<section class=\"sched reveal\" data-kid=\"1-3-5\" data-name=\"prayer schedule table\" style=\"--d:200ms\">\n<div class=\"sched-head\" data-kid=\"1-3-5-1\" data-name=\"schedule column header row\">\n<span data-kid=\"1-3-5-1-1\" data-name=\"prayer column header\">Prayer</span>\n<span data-kid=\"1-3-5-1-2\" data-name=\"azan column header\">Azan</span>\n<span data-kid=\"1-3-5-1-3\" data-name=\"iqamah column header\">Iqamah</span>\n</div>\n<div class=\"row\" data-kid=\"1-3-5-2\" data-name=\"Fajr prayer row\">\n<div class=\"p-name\" data-kid=\"1-3-5-2-1\" data-name=\"Fajr prayer name\">Fajr</div>\n<div class=\"p-time\" data-kid=\"1-3-5-2-2\" data-name=\"Fajr azan time\">5:00 AM</div>\n<div class=\"p-iq\" data-kid=\"1-3-5-2-3\" data-name=\"Fajr iqamah time\">5:30 AM</div>\n</div>\n<div class=\"row friday\" data-kid=\"1-3-5-3\" data-name=\"Jumu'ah prayer row (highlighted)\">\n<div data-kid=\"1-3-5-3-1\" data-name=\"Jumu'ah prayer name container\">\n<div class=\"p-name\" data-kid=\"1-3-5-3-1-1\" data-name=\"Jumu'ah prayer name with live dot\"><span class=\"dot-live\" data-kid=\"1-3-5-3-1-1-1\" data-name=\"live indicator dot\"></span>Jumu'ah</div>\n<div class=\"p-sub\" data-kid=\"1-3-5-3-1-2\" data-name=\"Bayan time subtitle\">Bayan 12:45 PM</div>\n</div>\n<div class=\"p-time\" data-kid=\"1-3-5-3-2\" data-name=\"Jumu'ah azan time\">12:30 PM</div>\n<div class=\"p-iq\" data-kid=\"1-3-5-3-3\" data-name=\"Jumu'ah iqamah time\">1:15 PM</div>\n</div>\n<div class=\"row\" data-kid=\"1-3-5-4\" data-name=\"Asr prayer row\">\n<div class=\"p-name\" data-kid=\"1-3-5-4-1\" data-name=\"Asr prayer name\">Asr</div>\n<div class=\"p-time\" data-kid=\"1-3-5-4-2\" data-name=\"Asr azan time\">3:45 PM</div>\n<div class=\"p-iq\" data-kid=\"1-3-5-4-3\" data-name=\"Asr iqamah time\">4:15 PM</div>\n</div>\n<div class=\"row\" data-kid=\"1-3-5-5\" data-name=\"Maghrib prayer row\">\n<div class=\"p-name\" data-kid=\"1-3-5-5-1\" data-name=\"Maghrib prayer name\">Maghrib</div>\n<div class=\"p-time\" data-kid=\"1-3-5-5-2\" data-name=\"Maghrib azan time\">6:00 PM</div>\n<div class=\"p-iq\" data-kid=\"1-3-5-5-3\" data-name=\"Maghrib iqamah time\">6:10 PM</div>\n</div>\n<div class=\"row\" data-kid=\"1-3-5-6\" data-name=\"Isha prayer row\">\n<div class=\"p-name\" data-kid=\"1-3-5-6-1\" data-name=\"Isha prayer name\">Isha</div>\n<div class=\"p-time\" data-kid=\"1-3-5-6-2\" data-name=\"Isha azan time\">7:30 PM</div>\n<div class=\"p-iq\" data-kid=\"1-3-5-6-3\" data-name=\"Isha iqamah time\">8:15 PM</div>\n</div>\n<div class=\"sched-foot\" data-kid=\"1-3-5-7\" data-name=\"schedule footer with sunrise\">\n<span data-kid=\"1-3-5-7-1\" data-name=\"Sunrise label\">Sunrise</span>\n<b data-kid=\"1-3-5-7-2\" data-name=\"Sunrise time value\">6:01 AM</b>\n</div>\n</section>\n<div class=\"addr reveal\" data-kid=\"1-3-6\" data-name=\"masjid address block\" style=\"--d:240ms\">\n<div class=\"addr-line\" data-kid=\"1-3-6-1\" data-name=\"address line with pin\">\n<i class=\"icon-map-pin\" data-kid=\"1-3-6-1-1\" data-name=\"map pin icon\"></i>\n<span data-kid=\"1-3-6-1-2\" data-name=\"address street text\">Skylab Avenue, Sithalapakkam, Tambaram</span>\n</div>\n<a class=\"maps\" data-kid=\"1-3-6-2\" data-name=\"open in Google Maps link\">\n        Open in Google Maps\n        <i class=\"icon-arrow-up-right\" data-kid=\"1-3-6-2-1\" data-name=\"external link arrow icon\"></i>\n</a>\n</div>\n<div class=\"lastupd reveal\" data-kid=\"1-3-7\" data-name=\"last updated timestamp\" style=\"--d:280ms\">Last updated 12:30 PM</div>\n</main>\n<nav class=\"tabbar\" data-kid=\"1-4\" data-name=\"bottom tab navigation bar\">\n<button class=\"tab on\" data-kid=\"1-4-1\" data-name=\"Home tab (active)\">\n<span class=\"ic\" data-kid=\"1-4-1-1\" data-name=\"Home tab icon wrapper\"><i class=\"icon-clock\" data-kid=\"1-4-1-1-1\" data-name=\"clock icon\"></i></span>\n<span data-kid=\"1-4-1-2\" data-name=\"Home tab label\">Home</span>\n</button>\n<button class=\"tab\" data-kid=\"1-4-2\" data-name=\"Timetable tab\">\n<span class=\"ic\" data-kid=\"1-4-2-1\" data-name=\"Timetable tab icon wrapper\"><i class=\"icon-calendar\" data-kid=\"1-4-2-1-1\" data-name=\"calendar icon\"></i></span>\n<span data-kid=\"1-4-2-2\" data-name=\"Timetable tab label\">Timetable</span>\n</button>\n<button class=\"tab\" data-kid=\"1-4-3\" data-name=\"Notices tab\">\n<span class=\"ic\" data-kid=\"1-4-3-1\" data-name=\"Notices tab icon wrapper\"><i class=\"icon-bell\" data-kid=\"1-4-3-1-1\" data-name=\"bell icon\"></i></span>\n<span data-kid=\"1-4-3-2\" data-name=\"Notices tab label\">Notices</span>\n</button>\n<button class=\"tab\" data-kid=\"1-4-4\" data-name=\"Settings tab\">\n<span class=\"ic\" data-kid=\"1-4-4-1\" data-name=\"Settings tab icon wrapper\"><i class=\"icon-settings\" data-kid=\"1-4-4-1-1\" data-name=\"gear icon\"></i></span>\n<span data-kid=\"1-4-4-2\" data-name=\"Settings tab label\">Settings</span>\n</button>\n</nav>\n</div>\n<script>\n(function(){\n  var el = document.getElementById('cd');\n  if(!el) return;\n  var left = 42 * 60 + 16;\n  function pad(n){ return n < 10 ? '0' + n : '' + n; }\n  function fmt(s){\n    var h = Math.floor(s / 3600);\n    var m = Math.floor((s % 3600) / 60);\n    return pad(h) + ':' + pad(m) + ':' + pad(s % 60);\n  }\n  el.textContent = fmt(left);\n  setInterval(function(){\n    left = left > 0 ? left - 1 : 0;\n    el.textContent = fmt(left);\n  }, 1000);\n})();\n</script>",
