        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  body {\n    margin: 0;\n    min-height: 100vh;\n    background: #E7E2DA;\n    font-family: 'Inter', -apple-system, system-ui, sans-serif;\n    color: #18181B;\n    -webkit-font-smoothing: antialiased;\n  }\n  .ta { font-family: 'Noto Sans Tamil', 'Inter', sans-serif; }\n\n  .phone {\n    position: relative;\n    width: 100%;\n    max-width: 390px;\n    height: 844px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    background: #F5F3EF;\n    box-shadow: 0 18px 44px rgba(10, 31, 23, 0.13);\n  }\n\n  /* ---------- status bar ---------- */\n  .status {\n    height: 44px;\n    flex: 0 0 44px;\n    background: #0A1F17;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 22px 0 26px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #FFFFFF;\n    letter-spacing: 0.01em;\n  }\n  .status-icons { display: flex; align-items: center; gap: 7px; font-size: 15px; color: #FFFFFF; }\n\n  /* ---------- masthead ---------- */\n  .mast {\n    flex: 0 0 auto;\n    background: #0A1F17;\n    padding: 6px 16px 18px 20px;\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  .mast-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }\n  .mast h1 {\n    margin: 0;\n    font-size: 25px;\n    line-height: 30px;\n    font-weight: 600;\n    letter-spacing: -0.022em;\n    color: #FFFFFF;\n  }\n  .mast-sub {\n    display: flex;\n    align-items: baseline;\n    gap: 9px;\n  }\n  .count {\n    font-size: 13px;\n    font-weight: 400;\n    color: #7EA091;\n    letter-spacing: 0;\n    white-space: nowrap;\n  }\n\n  .lang {\n    display: flex;\n    padding: 2px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.07);\n    border: 1px solid rgba(255,255,255,0.13);\n    height: 32px;\n    box-sizing: border-box;\n  }\n  .lang button {\n    appearance: none;\n    border: 0;\n    background: transparent;\n    padding: 0 13px;\n    border-radius: 999px;\n    font-family: inherit;\n    font-size: 12.5px;\n    font-weight: 600;\n    line-height: 28px;\n    color: #9DBBAE;\n    cursor: pointer;\n    transition: transform 120ms ease, color 160ms ease;\n  }\n  .lang button.on { background: #F5F3EF; color: #0A1F17; }\n  .lang button:active { transform: scale(0.97); }\n\n  /* ---------- filters ---------- */\n  .filters {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 12px 16px;\n    background: #F5F3EF;\n  }\n  .sel {\n    flex: 1 1 auto;\n    height: 44px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 0 14px;\n    background: #FFFFFF;\n    border: 1px solid #E8E4DE;\n    border-radius: 12px;\n    font-size: 14px;\n    font-weight: 500;\n    color: #18181B;\n    cursor: pointer;\n    transition: transform 120ms ease, border-color 160ms ease;\n    font-family: inherit;\n    text-align: left;\n  }\n  .sel:active { transform: scale(0.97); }\n  .sel i { font-size: 15px; color: #9C9590; }\n\n  .chip {\n    flex: 0 0 auto;\n    height: 44px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 0 14px;\n    background: transparent;\n    border: 1px solid #E1DCD4;\n    border-radius: 12px;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 500;\n    color: #6B6560;\n    cursor: pointer;\n    transition: transform 120ms ease, background-color 160ms ease, border-color 160ms ease;\n  }\n  .chip:active { transform: scale(0.97); }\n  .chip i { font-size: 14px; color: #A29B94; }\n\n  /* ---------- list ---------- */\n  .list {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow-y: auto;\n    background: #FFFFFF;\n    scrollbar-width: none;\n  }\n  .list::-webkit-scrollbar { display: none; }\n\n  .updated {\n    padding: 13px 16px 9px;\n    font-size: 13px;\n    line-height: 16px;\n    font-weight: 400;\n    color: #9C9590;\n  }\n\n  @keyframes rise {\n    from { opacity: 0; transform: translateY(8px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n  .row {\n    display: block;\n    padding: 14px 16px 15px;\n    border-top: 1px solid #F0ECE6;\n    cursor: pointer;\n    animation: rise 180ms cubic-bezier(0.22, 0.61, 0.36, 1) both;\n    transition: transform 120ms ease, background-color 140ms ease;\n  }\n  .row:active { background: #FAF8F4; transform: scale(0.995); }\n  .d1 { animation-delay: 40ms; }\n  .d2 { animation-delay: 80ms; }\n  .d3 { animation-delay: 120ms; }\n  .d4 { animation-delay: 160ms; }\n\n  .row-top { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }\n  .cat {\n    font-size: 11px;\n    line-height: 14px;\n    font-weight: 600;\n    letter-spacing: 0.085em;\n    text-transform: uppercase;\n    color: #6B6560;\n    white-space: nowrap;\n  }\n  .urgent {\n    display: inline-flex;\n    align-items: center;\n    gap: 3px;\n    background: #F59E0B;\n    color: #2A1A00;\n    font-size: 9.5px;\n    line-height: 12px;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    padding: 2px 6px 2px 5px;\n    border-radius: 4px;\n  }\n  .spacer { flex: 1 1 auto; }\n  .pub {\n    font-size: 12px;\n    line-height: 15px;\n    font-weight: 400;\n    color: #9C9590;\n    white-space: nowrap;\n  }\n\n  .row h2 {\n    margin: 0;\n    font-size: 16px;\n    line-height: 22px;\n    font-weight: 600;\n    letter-spacing: -0.011em;\n    color: #18181B;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n  .excerpt {\n    margin: 5px 0 0;\n    font-size: 13px;\n    line-height: 19px;\n    font-weight: 400;\n    color: #8A837D;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n  .meta {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    margin-top: 9px;\n  }\n  .meta .who {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    line-height: 16px;\n    font-weight: 500;\n    color: #4A443F;\n  }\n  .meta .who i { font-size: 13px; color: #A29B94; }\n  .meta .when {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    line-height: 16px;\n    font-weight: 400;\n    color: #6B6560;\n  }\n  .meta .when i { font-size: 13px; color: #B0A9A2; }\n\n  /* ---------- tab bar ---------- */\n  .tabs {\n    flex: 0 0 80px;\n    height: 80px;\n    background: #FFFFFF;\n    border-top: 1px solid #E8E4DE;\n    display: flex;\n    align-items: flex-start;\n    padding-top: 9px;\n    box-sizing: border-box;\n  }\n  .tab {\n    flex: 1 1 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 5px;\n    background: none;\n    border: 0;\n    padding: 4px 0 0;\n    font-family: inherit;\n    font-size: 21px;\n    color: #9C9590;\n    cursor: pointer;\n    transition: transform 120ms ease, color 160ms ease;\n  }\n  .tab:active { transform: scale(0.94); }\n  .tab span {\n    font-size: 11px;\n    line-height: 13px;\n    font-weight: 500;\n    letter-spacing: 0.005em;\n  }\n  .tab.on { color: #047857; }\n  .tab.on span { font-weight: 600; }\n</style>\n<div class=\"phone\" data-kid=\"1\" data-name=\"phone app frame container\">\n<div class=\"status\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock time\">4:02</span>\n<div class=\"status-icons\" data-kid=\"1-1-2\" data-name=\"status bar icon group\">\n<i class=\"icon-signal\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"></i>\n<i class=\"icon-wifi\" data-kid=\"1-1-2-2\" data-name=\"wi-fi signal icon\"></i>\n<i class=\"icon-battery-full\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<header class=\"mast\" data-kid=\"1-2\" data-name=\"app masthead header\">\n<div class=\"mast-row\" data-kid=\"1-2-1\" data-name=\"masthead title row\">\n<div class=\"mast-sub\" data-kid=\"1-2-1-1\" data-name=\"masthead title group\">\n<h1 data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">Notices</h1>\n<span class=\"count\" data-kid=\"1-2-1-1-2\" data-name=\"published notices count\">4 published</span>\n</div>\n<div class=\"lang\" data-kid=\"1-2-1-2\" data-name=\"language toggle pill\">\n<button class=\"on\" data-kid=\"1-2-1-2-1\" data-name=\"English language toggle button\" type=\"button\">EN</button>\n<button class=\"ta\" data-kid=\"1-2-1-2-2\" data-name=\"Tamil language toggle button\" type=\"button\">தமிழ்</button>\n</div>\n</div>\n</header>\n<div class=\"filters\" data-kid=\"1-3\" data-name=\"filter bar\">\n<button class=\"sel\" data-kid=\"1-3-1\" data-name=\"category dropdown selector\" type=\"button\">\n<span data-kid=\"1-3-1-1\" data-name=\"dropdown selected value label\">All categories</span>\n<i class=\"icon-chevron-down\" data-kid=\"1-3-1-2\" data-name=\"dropdown chevron-down icon\"></i>\n</button>\n<button class=\"chip\" data-kid=\"1-3-2\" data-name=\"urgent filter chip\" type=\"button\">\n<i class=\"icon-alert-triangle\" data-kid=\"1-3-2-1\" data-name=\"alert triangle icon\"></i>\n<span data-kid=\"1-3-2-2\" data-name=\"urgent filter label\">Urgent</span>\n</button>\n</div>\n<main class=\"list\" data-kid=\"1-4\" data-name=\"scrollable notices list\">\n<div class=\"updated\" data-kid=\"1-4-1\" data-name=\"last updated timestamp\">Last updated 4:02 PM</div>\n<article class=\"row d1\" data-kid=\"1-4-2\" data-name=\"schedule change notice card\">\n<div class=\"row-top\" data-kid=\"1-4-2-1\" data-name=\"notice meta header row\">\n<span class=\"cat\" data-kid=\"1-4-2-1-1\" data-name=\"notice category label\">Schedule Change</span>\n<span class=\"urgent\" data-kid=\"1-4-2-1-2\" data-name=\"urgent priority badge\">Urgent</span>\n<span class=\"spacer\" data-kid=\"1-4-2-1-3\" data-name=\"meta row flex spacer\"></span>\n<span class=\"pub\" data-kid=\"1-4-2-1-4\" data-name=\"notice publish date\">4 Nov</span>\n</div>\n<h2 data-kid=\"1-4-2-2\" data-name=\"notice headline\">Isha Iqamah moved to 8:15 PM from this week</h2>\n<p class=\"excerpt\" data-kid=\"1-4-2-3\" data-name=\"notice excerpt summary\">Isha Iqamah is now 8:15 PM starting Monday 2 November. Azan remains at 7:30 PM as printed on the timetable. Please arrive early as the hall fills quickly after Maghrib.</p>\n</article>\n<article class=\"row d2\" data-kid=\"1-4-3\" data-name=\"bayan notice card\">\n<div class=\"row-top\" data-kid=\"1-4-3-1\" data-name=\"notice meta header row\">\n<span class=\"cat\" data-kid=\"1-4-3-1-1\" data-name=\"notice category label\">Bayan</span>\n<span class=\"spacer\" data-kid=\"1-4-3-1-2\" data-name=\"meta row flex spacer\"></span>\n<span class=\"pub\" data-kid=\"1-4-3-1-3\" data-name=\"notice publish date\">5 Nov</span>\n</div>\n<h2 data-kid=\"1-4-3-2\" data-name=\"notice headline\">Weekly Jumu'ah Bayan</h2>\n<p class=\"excerpt\" data-kid=\"1-4-3-3\" data-name=\"notice excerpt summary\">This week's bayan will be delivered by Moulavi Abdul Rahman after the 12:30 PM Jumu'ah Azan. The topic is the etiquettes of the Friday prayer. Brothers are requested to be seated by 12:40 PM.</p>\n<div class=\"meta\" data-kid=\"1-4-3-4\" data-name=\"notice author and time meta\">\n<span class=\"who\" data-kid=\"1-4-3-4-1\" data-name=\"author byline with icon\"><i class=\"icon-user\" data-kid=\"1-4-3-4-1-1\" data-name=\"user silhouette icon\"></i>Moulavi Abdul Rahman</span>\n<span class=\"when\" data-kid=\"1-4-3-4-2\" data-name=\"event date and time label\"><i class=\"icon-calendar\" data-kid=\"1-4-3-4-2-1\" data-name=\"calendar icon\"></i>Fri 6 Nov, 12:45 PM</span>\n</div>\n</article>\n<article class=\"row d3\" data-kid=\"1-4-4\" data-name=\"community notice card\">\n<div class=\"row-top\" data-kid=\"1-4-4-1\" data-name=\"notice meta header row\">\n<span class=\"cat\" data-kid=\"1-4-4-1-1\" data-name=\"notice category label\">Community</span>\n<span class=\"spacer\" data-kid=\"1-4-4-1-2\" data-name=\"meta row flex spacer\"></span>\n<span class=\"pub\" data-kid=\"1-4-4-1-3\" data-name=\"notice publish date\">1 Nov</span>\n</div>\n<h2 data-kid=\"1-4-4-2\" data-name=\"notice headline\">Weekend Madrasa Admission Open</h2>\n<p class=\"excerpt\" data-kid=\"1-4-4-3\" data-name=\"notice excerpt summary\">Admission for the weekend madrasa is open for children aged 6 to 14. Classes run on Saturday and Sunday from 9:00 AM to 11:30 AM. Collect the form from the masjid office after any prayer.</p>\n<div class=\"meta\" data-kid=\"1-4-4-4\" data-name=\"notice author and time meta\">\n<span class=\"who\" data-kid=\"1-4-4-4-1\" data-name=\"author byline with icon\"><i class=\"icon-user\" data-kid=\"1-4-4-4-1-1\" data-name=\"user silhouette icon\"></i>Masjid Committee</span>\n</div>\n</article>\n<article class=\"row d4\" data-kid=\"1-4-5\" data-name=\"ramadan notice card\">\n<div class=\"row-top\" data-kid=\"1-4-5-1\" data-name=\"notice meta header row\">\n<span class=\"cat\" data-kid=\"1-4-5-1-1\" data-name=\"notice category label\">Ramadan</span>\n<span class=\"spacer\" data-kid=\"1-4-5-1-2\" data-name=\"meta row flex spacer\"></span>\n<span class=\"pub\" data-kid=\"1-4-5-1-3\" data-name=\"notice publish date\">28 Oct</span>\n</div>\n<h2 data-kid=\"1-4-5-2\" data-name=\"notice headline\">Ramadan Timetable Preparation Meeting</h2>\n<p class=\"excerpt\" data-kid=\"1-4-5-3\" data-name=\"notice excerpt summary\">The committee will meet to prepare the Ramadan timetable and the Taraweeh arrangements. Members who can help with the schedule should attend after Isha. Please bring last year's timetable for reference.</p>\n</article>\n<div data-kid=\"1-4-6\" data-name=\"list bottom padding spacer\" style=\"height: 18px;\"></div>\n</main>\n<nav class=\"tabs\" data-kid=\"1-5\" data-name=\"bottom tab navigation bar\">\n<button class=\"tab\" data-kid=\"1-5-1\" data-name=\"home tab button\" type=\"button\">\n<i class=\"icon-house\" data-kid=\"1-5-1-1\" data-name=\"home house icon\"></i>\n<span data-kid=\"1-5-1-2\" data-name=\"home tab label\">Home</span>\n</button>\n<button class=\"tab\" data-kid=\"1-5-2\" data-name=\"timetable tab button\" type=\"button\">\n<i class=\"icon-calendar\" data-kid=\"1-5-2-1\" data-name=\"calendar icon\"></i>\n<span data-kid=\"1-5-2-2\" data-name=\"timetable tab label\">Timetable</span>\n</button>\n<button class=\"tab on\" data-kid=\"1-5-3\" data-name=\"active notices tab button\" type=\"button\">\n<i class=\"icon-bell\" data-kid=\"1-5-3-1\" data-name=\"bell notification icon\"></i>\n<span data-kid=\"1-5-3-2\" data-name=\"notices tab label\">Notices</span>\n</button>\n<button class=\"tab\" data-kid=\"1-5-4\" data-name=\"settings tab button\" type=\"button\">\n<i class=\"icon-settings\" data-kid=\"1-5-4-1\" data-name=\"gear settings icon\"></i>\n<span data-kid=\"1-5-4-2\" data-name=\"settings tab label\">Settings</span>\n</button>\n</nav>\n</div>",
