    "var_2ce00f7a8857": {
      "type": "variant",
      "label": "Settings — Masjid configuration",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7070,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap');\n\n:root{\n  --ink:#0A1F17;\n  --ink-border:#122E22;\n  --primary:#0D5C3A;\n  --primary-hover:#094229;\n  --accent:#047857;\n  --accent-tint:#F0F9F5;\n  --gold:#F59E0B;\n  --gold-tint:#FFFDF5;\n  --gold-ink:#B45309;\n  --bg:#F7F6F2;\n  --surface:#FFFFFF;\n  --border:#E6E2DB;\n  --hair:#EFECE7;\n  --field:#FAF9F6;\n  --text:#18181B;\n  --secondary:#6B6560;\n  --tertiary:#9C9590;\n}\n\n*{box-sizing:border-box;}\nhtml,body{margin:0;padding:0;background:var(--bg);}\nbody{\n  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;\n  color:var(--text);\n  font-size:14px;\n  line-height:1.45;\n  -webkit-font-smoothing:antialiased;\n  -moz-osx-font-smoothing:grayscale;\n}\n.tnum{font-variant-numeric:tabular-nums;}\n\n/* ── top nav ─────────────────────────────────────────── */\n.topnav{\n  height:64px;background:var(--ink);\n  border-bottom:1px solid var(--ink-border);\n  display:flex;align-items:center;\n  padding:0 24px;gap:28px;\n}\n.brand{display:flex;align-items:center;gap:10px;margin-right:8px;}\n.mark{\n  width:26px;height:26px;border-radius:7px;\n  background:rgba(167,213,196,.14);\n  display:flex;align-items:center;justify-content:center;\n  color:#A7D5C4;flex:0 0 26px;\n}\n.brand-name{font-size:15px;font-weight:600;color:#F5F3EF;letter-spacing:-.01em;}\n.navlinks{display:flex;align-items:center;gap:2px;height:64px;}\n.navlink{\n  position:relative;\n  display:flex;align-items:center;height:64px;\n  padding:0 14px;\n  font-size:14px;font-weight:500;\n  color:#A7D5C4;text-decoration:none;\n  transition:color 200ms cubic-bezier(.22,1,.36,1);\n}\n.navlink:hover{color:#E8F4EE;}\n.navlink.active{color:#FFFFFF;font-weight:600;}\n.navlink.active::after{\n  content:'';position:absolute;left:0;right:0;bottom:0;\n  height:2px;background:#A7D5C4;\n}\n.navright{margin-left:auto;display:flex;align-items:center;gap:18px;}\n.nav-ghost{\n  display:flex;align-items:center;gap:6px;\n  height:34px;padding:0 12px;border-radius:8px;\n  border:1px solid rgba(167,213,196,.24);\n  color:#CFE5DA;font-size:13px;font-weight:500;\n  background:transparent;text-decoration:none;cursor:pointer;\n  font-family:inherit;\n  transition:background 200ms,color 200ms,border-color 200ms;\n}\n.nav-ghost:hover{background:rgba(167,213,196,.12);color:#fff;}\n.nav-signout{\n  font-size:13px;font-weight:500;color:#8FBBA8;\n  text-decoration:none;background:none;border:0;cursor:pointer;\n  font-family:inherit;\n  transition:color 200ms;\n}\n.nav-signout:hover{color:#fff;}\n\n/* ── page ────────────────────────────────────────────── */\n.page{padding:24px 24px 40px;max-width:1440px;margin:0 auto;}\n\n.title-row{\n  display:flex;align-items:flex-start;justify-content:space-between;\n  gap:24px;padding-bottom:20px;\n}\nh1{\n  margin:0;font-size:28px;line-height:1.2;font-weight:600;\n  letter-spacing:-.02em;color:var(--text);\n}\n.subtitle{\n  margin:6px 0 0;font-size:13px;color:var(--secondary);\n  font-weight:400;\n  display:flex;align-items:center;gap:10px;\n}\n.subtitle .rule-sep{\n  display:inline-block;width:1px;height:11px;background:#D8D3CA;flex:0 0 1px;\n}\n\n.btn-primary{\n  display:inline-flex;align-items:center;justify-content:center;gap:8px;\n  height:40px;padding:0 18px;\n  background:var(--primary);color:#fff;\n  border:0;border-radius:10px;\n  font-family:inherit;font-size:13.5px;font-weight:600;\n  cursor:pointer;white-space:nowrap;\n  box-shadow:0 1px 2px rgba(10,31,23,.14);\n  transition:background 200ms cubic-bezier(.22,1,.36,1),box-shadow 200ms,transform 200ms;\n}\n.btn-primary:hover{background:var(--primary-hover);box-shadow:0 2px 6px rgba(10,31,23,.18);}\n.btn-primary:active{transform:scale(.985);}\n.btn-primary svg{width:16px;height:16px;flex:0 0 16px;}\n\n/* ── layout ──────────────────────────────────────────── */\n.layout{display:grid;grid-template-columns:200px 1fr;gap:40px;align-items:start;}\n\n.rail{position:sticky;top:88px;padding-top:2px;}\n.rail-nav{display:flex;flex-direction:column;gap:2px;}\n.rail-link{\n  display:block;\n  padding:8px 0;\n  font-size:13.5px;font-weight:500;\n  color:var(--secondary);text-decoration:none;\n  transition:color 200ms cubic-bezier(.22,1,.36,1);\n  cursor:pointer;\n}\n.rail-link:hover{color:var(--text);}\n.rail-link.active{color:var(--primary);font-weight:600;}\n.rail-rule{height:1px;background:var(--border);margin:16px 0 12px;}\n.rail-meta{\n  font-size:11px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;\n  color:var(--tertiary);margin-bottom:8px;\n}\n\n/* ── panels ──────────────────────────────────────────── */\n.stack{display:flex;flex-direction:column;gap:20px;min-width:0;}\n\n.panel{\n  background:var(--surface);\n  border:1px solid var(--border);\n  border-radius:14px;\n  overflow:hidden;\n}\n.panel-head{\n  height:52px;\n  display:flex;align-items:center;justify-content:space-between;\n  gap:16px;\n  padding:0 16px;\n  border-bottom:1px solid var(--hair);\n}\n.panel-head h2{\n  margin:0;font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--text);\n  display:flex;align-items:center;gap:8px;\n}\n.panel-head h2 svg{width:15px;height:15px;color:var(--primary);flex:0 0 15px;}\n.panel-note{font-size:12px;color:var(--tertiary);font-weight:500;}\n.panel-body{padding:16px;}\n\n/* ── fields ──────────────────────────────────────────── */\n.field{min-width:0;}\n.field > label{\n  display:block;\n  font-size:12px;font-weight:500;color:var(--secondary);\n  margin-bottom:6px;letter-spacing:.005em;\n}\n.control{\n  width:100%;height:40px;\n  padding:0 12px;\n  background:var(--field);\n  border:1px solid var(--border);\n  border-radius:10px;\n  font-family:inherit;font-size:13.5px;color:var(--text);\n  display:flex;align-items:center;\n  transition:border-color 200ms,border-radius 200ms;\n  outline:none;\n}\ninput.control{\n  -webkit-appearance:none;appearance:none;\n}\n.field input:focus,.field .control:focus{\n  border-color:var(--primary);\n  border-radius:10px;\n  box-shadow:0 0 0 3px rgba(13,92,58,.14);\n}\n.control.ta{\n  font-family:'Noto Sans Tamil','Inter',sans-serif;\n  font-size:15px;\n}\n.control.ar{\n  font-family:'Noto Naskh Arabic',serif;\n  font-weight:700;\n  font-size:17px;\n  line-height:1.9;\n  direction:rtl;\n  text-align:left;\n  letter-spacing:0;\n}\n.control.mono{\n  font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;\n  font-size:13px;\n  font-variant-numeric:tabular-nums;\n}\n.select{\n  position:relative;\n  justify-content:space-between;\n  gap:8px;\n  cursor:pointer;\n}\n.select:hover{border-color:#D9D4CB;}\n.select svg{width:15px;height:15px;color:var(--tertiary);flex:0 0 15px;}\n.suffix{\n  display:flex;align-items:center;gap:8px;\n}\n.suffix svg{width:14px;height:14px;color:var(--tertiary);flex:0 0 14px;}\n\n.row-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}\n.row-2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}\n.row-2-1{display:grid;grid-template-columns:1fr 2fr;gap:16px;}\n.mt16{margin-top:16px;}\n.mt14{margin-top:14px;}\n\n/* ── identity preview ────────────────────────────────── */\n.preview{\n  margin-top:18px;\n  background:var(--bg);\n  border:1px solid var(--hair);\n  border-radius:12px;\n  padding:12px 16px 13px;\n}\n.preview-label{\n  display:flex;align-items:center;justify-content:space-between;\n  font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;\n  color:var(--tertiary);\n  padding-bottom:10px;\n  border-bottom:1px solid #E9E5DD;\n}\n.preview-body{\n  display:flex;align-items:center;justify-content:space-between;\n  gap:32px;padding-top:10px;\n}\n.lang-switch{\n  display:inline-flex;flex:0 0 auto;gap:2px;padding:3px;\n  background:#FFFFFF;border:1px solid #DED9D0;border-radius:999px;\n}\n.lang-switch span{\n  display:inline-block;padding:4px 11px;border-radius:999px;\n  font-size:11.5px;font-weight:600;color:#6B6560;line-height:1.25;\n}\n.lang-switch span.on{background:var(--primary);color:#fff;}\n.lang-switch span.ta-lbl{font-family:'Noto Sans Tamil','Inter',sans-serif;font-weight:500;}\n.preview-copy{min-width:0;}\n.pv-ar{\n  font-family:'Noto Naskh Arabic',serif;font-weight:700;\n  font-size:21px;line-height:1.7;letter-spacing:0;\n  color:#12362A;\n  text-align:left;direction:rtl;unicode-bidi:isolate;\n  width:fit-content;\n}\n.pv-en{\n  font-size:15.5px;font-weight:600;letter-spacing:-.015em;\n  color:#132A22;margin-top:1px;\n}\n.pv-ta{\n  font-family:'Noto Sans Tamil','Inter',sans-serif;\n  font-size:13px;color:#6B6560;margin-top:5px;\n}\n\n/* ── admins ──────────────────────────────────────────── */\n.admin-list{border:1px solid var(--hair);border-radius:10px;overflow:hidden;}\n.admin-row{\n  display:flex;align-items:center;justify-content:space-between;gap:16px;\n  height:44px;padding:0 14px;\n  background:#FCFBF9;\n  border-bottom:1px solid var(--hair);\n}\n.admin-row:last-child{border-bottom:0;}\n.admin-id{\n  display:flex;align-items:center;gap:9px;\n  font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;\n  font-size:13px;color:#3F3A35;\n  letter-spacing:-.01em;\n}\n.admin-id svg{width:13px;height:13px;color:#B4AEA6;flex:0 0 13px;}\n.admin-date{font-size:12.5px;color:var(--tertiary);white-space:nowrap;}\n.readonly{\n  display:inline-flex;align-items:center;gap:5px;\n  height:22px;padding:0 8px;border-radius:6px;\n  background:var(--hair);color:var(--secondary);\n  font-size:11px;font-weight:500;letter-spacing:.01em;\n}\n.readonly svg{width:11px;height:11px;flex:0 0 11px;}\n\n.footer-note{\n  margin-top:18px;\n  font-size:12px;color:var(--tertiary);\n}\n\n/* ── motion ──────────────────────────────────────────── */\n@keyframes riseIn{\n  from{opacity:0;transform:translateY(7px);}\n  to{opacity:1;transform:none;}\n}\n.reveal{animation:riseIn 420ms cubic-bezier(.22,1,.36,1) both;}\n.d1{animation-delay:50ms;}\n.d2{animation-delay:100ms;}\n.d3{animation-delay:150ms;}\n.d4{animation-delay:200ms;}\n.d5{animation-delay:250ms;}\n.d6{animation-delay:300ms;}\n</style>\n<nav class=\"topnav\" data-kid=\"1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1\" data-name=\"brand logo and name group\">\n<span class=\"mark\" data-kid=\"1-1-1\" data-name=\"brand logo mark container\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"mosque icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n<path d=\"M4 21V11a8 8 0 0 1 16 0v10\"></path><path d=\"M9 21v-5a3 3 0 0 1 6 0v5\"></path>\n</svg>\n</span>\n<span class=\"brand-name\" data-kid=\"1-1-2\" data-name=\"brand name text\">Masjidul Ihsaan</span>\n</div>\n<div class=\"navlinks\" data-kid=\"1-2\" data-name=\"main navigation links group\">\n<a class=\"navlink reveal d1\" data-kid=\"1-2-1\" data-name=\"dashboard nav link\" href=\"#\">Dashboard</a>\n<a class=\"navlink reveal d1\" data-kid=\"1-2-2\" data-name=\"timetable nav link\" href=\"#\">Timetable</a>\n<a class=\"navlink reveal d1\" data-kid=\"1-2-3\" data-name=\"announcements nav link\" href=\"#\">Announcements</a>\n<a class=\"navlink active reveal d1\" data-kid=\"1-2-4\" data-name=\"settings nav link (active)\" href=\"#\">Settings</a>\n</div>\n<div class=\"navright\" data-kid=\"1-3\" data-name=\"nav right side action group\">\n<a class=\"nav-ghost reveal d1\" data-kid=\"1-3-1\" data-name=\"view public site ghost button\" href=\"#\">\n<span data-kid=\"1-3-1-1\" data-name=\"view public site button text\">View public site</span>\n<svg aria-hidden=\"true\" data-kid=\"1-3-1-2\" data-name=\"external link arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"width:13px;height:13px;\" viewbox=\"0 0 24 24\">\n<path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path>\n</svg>\n</a>\n<button class=\"nav-signout\" data-kid=\"1-3-2\" data-name=\"sign out button\" type=\"button\">Sign out</button>\n</div>\n</nav>\n<div class=\"page\" data-kid=\"2\" data-name=\"settings page container\">\n<div class=\"title-row reveal d2\" data-kid=\"2-1\" data-name=\"page title row\">\n<div data-kid=\"2-1-1\" data-name=\"page title block\">\n<h1 data-kid=\"2-1-1-1\" data-name=\"settings page heading\">Settings</h1>\n<p class=\"subtitle\" data-kid=\"2-1-1-2\" data-name=\"page subtitle with mosque name and updated date\">\n<span data-kid=\"2-1-1-2-1\" data-name=\"mosque name in subtitle\">Masjidul Ihsaan</span>\n<span class=\"rule-sep\" data-kid=\"2-1-1-2-2\" data-name=\"subtitle separator rule\"></span>\n<span data-kid=\"2-1-1-2-3\" data-name=\"last updated date text\">Updated 2 November 2026</span>\n</p>\n</div>\n<button class=\"btn-primary\" data-kid=\"2-1-2\" data-name=\"save configuration primary button\" type=\"button\">\n<svg aria-hidden=\"true\" data-kid=\"2-1-2-1\" data-name=\"document save icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z\"></path><path d=\"M17 21v-8H7v8\"></path><path d=\"M7 3v5h8\"></path>\n</svg>\n<span data-kid=\"2-1-2-2\" data-name=\"save configuration button text\">Save configuration</span>\n</button>\n</div>\n<div class=\"layout\" data-kid=\"2-2\" data-name=\"settings page two-column layout\">\n<aside class=\"rail reveal d3\" data-kid=\"2-2-1\" data-name=\"left rail navigation sidebar\">\n<nav class=\"rail-nav\" data-kid=\"2-2-1-1\" data-name=\"section anchor navigation links\">\n<a class=\"rail-link active\" data-kid=\"2-2-1-1-1\" data-name=\"identity section rail link (active)\" href=\"#identity\">Identity</a>\n<a class=\"rail-link\" data-kid=\"2-2-1-1-2\" data-name=\"location and contact section rail link\" href=\"#location\">Location and contact</a>\n<a class=\"rail-link\" data-kid=\"2-2-1-1-3\" data-name=\"Android distribution section rail link\" href=\"#android\">Android distribution</a>\n</nav>\n<div class=\"rail-rule\" data-kid=\"2-2-1-2\" data-name=\"rail separator rule\"></div>\n<div class=\"rail-meta\" data-kid=\"2-2-1-3\" data-name=\"access section label\">Access</div>\n<a class=\"rail-link\" data-kid=\"2-2-1-4\" data-name=\"administrators section rail link\" href=\"#admins\">Authorized administrators</a>\n</aside>\n<div class=\"stack\" data-kid=\"2-2-2\" data-name=\"main content panel stack\">\n<!-- Identity -->\n<section class=\"panel reveal d3\" data-kid=\"2-2-2-1\" data-name=\"identity settings panel\" id=\"identity\">\n<div class=\"panel-head\" data-kid=\"2-2-2-1-1\" data-name=\"identity panel header\">\n<h2 data-kid=\"2-2-2-1-1-1\" data-name='panel title \"Identity\"'>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"mosque icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M3 21h18\"></path><path d=\"M5 21V9l7-5 7 5v12\"></path><path d=\"M10 21v-6h4v6\"></path>\n</svg>\n            Identity\n          </h2>\n</div>\n<div class=\"panel-body\" data-kid=\"2-2-2-1-2\" data-name=\"identity panel body\">\n<div class=\"row-3\" data-kid=\"2-2-2-1-2-1\" data-name=\"mosque name three-column row\">\n<div class=\"field\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"English name field\">\n<label data-kid=\"2-2-2-1-2-1-1-1\" data-name=\"English name label\" for=\"name-en\">English name</label>\n<input class=\"control\" data-kid=\"2-2-2-1-2-1-1-2\" data-name=\"English name text input\" id=\"nameEn\" name=\"name_en\" spellcheck=\"false\" type=\"text\" value=\"Masjidul Ihsaan\"/>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"Tamil name field\">\n<label data-kid=\"2-2-2-1-2-1-2-1\" data-name=\"Tamil name label\" for=\"name-ta\">Tamil name</label>\n<input class=\"control ta\" data-kid=\"2-2-2-1-2-1-2-2\" data-name=\"Tamil name text input\" id=\"nameTa\" name=\"name_ta\" type=\"text\" value=\"மஸ்ஜிதுல் இஹ்சான்\"/>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-1-2-1-3\" data-name=\"Arabic name field\">\n<label data-kid=\"2-2-2-1-2-1-3-1\" data-name=\"Arabic name label\" for=\"name-ar\">Arabic name</label>\n<input class=\"control ar\" data-kid=\"2-2-2-1-2-1-3-2\" data-name=\"Arabic name text input (RTL)\" dir=\"rtl\" id=\"nameAr\" name=\"name_ar\" type=\"text\" value=\"مَسْجِدُ الْإِحْسَانِ\"/>\n</div>\n</div>\n<div class=\"preview\" data-kid=\"2-2-2-1-2-2\" data-name=\"app header preview area\">\n<div class=\"preview-label\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"preview label bar\">\n<span data-kid=\"2-2-2-1-2-2-1-1\" data-name=\"preview label text\">App header preview</span>\n</div>\n<div class=\"preview-body\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"preview body row with language switch\">\n<div class=\"preview-copy\" data-kid=\"2-2-2-1-2-2-2-1\" data-name=\"multilingual preview text block\">\n<div class=\"pv-ar\" data-kid=\"2-2-2-1-2-2-2-1-1\" data-name=\"Arabic preview text (RTL)\">مَسْجِدُ الْإِحْسَانِ</div>\n<div class=\"pv-en\" data-kid=\"2-2-2-1-2-2-2-1-2\" data-name=\"English preview text\">Masjidul Ihsaan</div>\n<div class=\"pv-ta\" data-kid=\"2-2-2-1-2-2-2-1-3\" data-name=\"Tamil preview text\">மஸ்ஜிதுல் இஹ்சான்</div>\n</div>\n<div aria-label=\"Language\" class=\"lang-switch\" data-kid=\"2-2-2-1-2-2-2-2\" data-name=\"language toggle switch\" role=\"group\">\n<span class=\"on\" data-kid=\"2-2-2-1-2-2-2-2-1\" data-name=\"English toggle option (selected)\">EN</span>\n<span class=\"ta-lbl\" data-kid=\"2-2-2-1-2-2-2-2-2\" data-name=\"Tamil toggle option\">தமிழ்</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Location and contact -->\n<section class=\"panel reveal d4\" data-kid=\"2-2-2-2\" data-name=\"location and contact panel\" id=\"location\">\n<div class=\"panel-head\" data-kid=\"2-2-2-2-1\" data-name=\"location panel header\">\n<h2 data-kid=\"2-2-2-2-1-1\" data-name='panel title \"Location and contact\"'>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"map pin icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n</svg>\n            Location and contact\n          </h2>\n<span class=\"panel-note tnum\" data-kid=\"2-2-2-2-1-2\" data-name=\"coordinates note text\">12.8942° N, 80.1898° E</span>\n</div>\n<div class=\"panel-body\" data-kid=\"2-2-2-2-2\" data-name=\"location panel body\">\n<div class=\"field\" data-kid=\"2-2-2-2-2-1\" data-name=\"address field\">\n<label data-kid=\"2-2-2-2-2-1-1\" data-name=\"address label\" for=\"address\">Address</label>\n<input class=\"control\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"address text input\" id=\"address\" name=\"address\" type=\"text\" value=\"Skylab Avenue, Sithalapakkam, Tambaram, Tamil Nadu 600045, India\"/>\n</div>\n<div class=\"row-2 mt16\" data-kid=\"2-2-2-2-2-2\" data-name=\"maps and phone two-column row\">\n<div class=\"field\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"Google Maps URL field\">\n<label data-kid=\"2-2-2-2-2-2-1-1\" data-name=\"Google Maps URL label\" for=\"maps\">Google Maps URL</label>\n<div class=\"control suffix\" data-kid=\"2-2-2-2-2-2-1-2\" data-name=\"maps URL input with external link icon\" style=\"justify-content:space-between;\">\n<input aria-label=\"Google Maps URL\" data-kid=\"2-2-2-2-2-2-1-2-1\" data-name=\"maps URL text input\" style=\"all:unset;flex:1;min-width:0;font-family:inherit;font-size:13.5px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\" type=\"text\" value=\"https://maps.app.goo.gl/wPgTiSDwAh24Xoa49\"/>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-2-2-2-1-2-2\" data-name=\"external link icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path>\n</svg>\n</div>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-2-2-2-2\" data-name=\"contact phone field\">\n<label data-kid=\"2-2-2-2-2-2-2-1\" data-name=\"contact phone label\" for=\"phone\">Contact phone</label>\n<input class=\"control\" data-kid=\"2-2-2-2-2-2-2-2\" data-name=\"contact phone input\" id=\"phone\" name=\"contact_phone\" type=\"tel\" value=\"+91 94440 00000\"/>\n</div>\n</div>\n<div class=\"row-3 mt16\" data-kid=\"2-2-2-2-2-3\" data-name=\"latitude / longitude / timezone row\">\n<div class=\"field\" data-kid=\"2-2-2-2-2-3-1\" data-name=\"latitude field\">\n<label data-kid=\"2-2-2-2-2-3-1-1\" data-name=\"latitude label\" for=\"lat\">Latitude</label>\n<input class=\"control mono\" data-kid=\"2-2-2-2-2-3-1-2\" data-name=\"latitude text input\" id=\"lat\" inputmode=\"decimal\" name=\"latitude\" type=\"text\" value=\"12.894208\"/>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-2-2-3-2\" data-name=\"longitude field\">\n<label data-kid=\"2-2-2-2-2-3-2-1\" data-name=\"longitude label\" for=\"lng\">Longitude</label>\n<input class=\"control mono\" data-kid=\"2-2-2-2-2-3-2-2\" data-name=\"longitude text input\" id=\"lng\" inputmode=\"decimal\" name=\"longitude\" type=\"text\" value=\"80.1898496\"/>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-2-2-3-3\" data-name=\"timezone field\">\n<label data-kid=\"2-2-2-2-2-3-3-1\" data-name=\"timezone label\" for=\"tz\">Timezone</label>\n<div aria-expanded=\"false\" class=\"control select\" data-kid=\"2-2-2-2-2-3-3-2\" data-name=\"timezone combobox\" id=\"tz\" role=\"combobox\" tabindex=\"0\">\n<span data-kid=\"2-2-2-2-2-3-3-2-1\" data-name=\"selected timezone value text\" style=\"font-family:'JetBrains Mono',ui-monospace,monospace;font-size:13px;\">Asia/Kolkata</span>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-2-2-3-3-2-2\" data-name=\"dropdown chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"m6 9 6 6 6-6\"></path>\n</svg>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Android distribution -->\n<section class=\"panel reveal d5\" data-kid=\"2-2-2-3\" data-name=\"Android distribution panel\" id=\"android\">\n<div class=\"panel-head\" data-kid=\"2-2-2-3-1\" data-name=\"Android distribution panel header\">\n<h2 data-kid=\"2-2-2-3-1-1\" data-name='panel title \"Android distribution\"'>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"smartphone icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<rect height=\"20\" rx=\"2.5\" width=\"12\" x=\"6\" y=\"2\"></rect><path d=\"M11 18h2\"></path>\n</svg>\n            Android distribution\n          </h2>\n<span class=\"panel-note\" data-kid=\"2-2-2-3-1-2\" data-name='panel note \"Served from GitHub releases\"'>Served from GitHub releases</span>\n</div>\n<div class=\"panel-body\" data-kid=\"2-2-2-3-2\" data-name=\"Android panel body\">\n<div class=\"row-2-1\" data-kid=\"2-2-2-3-2-1\" data-name=\"version and APK URL row\">\n<div class=\"field\" data-kid=\"2-2-2-3-2-1-1\" data-name=\"latest app version field\">\n<label data-kid=\"2-2-2-3-2-1-1-1\" data-name=\"latest app version label\" for=\"version\">Latest app version</label>\n<input class=\"control mono\" data-kid=\"2-2-2-3-2-1-1-2\" data-name=\"latest app version text input\" id=\"version\" name=\"latest_version\" type=\"text\" value=\"1.0.0\"/>\n</div>\n<div class=\"field\" data-kid=\"2-2-2-3-2-1-2\" data-name=\"APK download URL field\">\n<label data-kid=\"2-2-2-3-2-1-2-1\" data-name=\"APK download URL label\" for=\"apk\">APK download URL</label>\n<input class=\"control mono\" data-kid=\"2-2-2-3-2-1-2-2\" data-name=\"APK download URL input\" id=\"apk\" name=\"apk_url\" style=\"font-size:12.5px;\" type=\"url\" value=\"https://github.com/ladderflow/masjid-app/releases/latest/download/masjidul-ihsaan.apk\"/>\n</div>\n</div>\n<div class=\"footer-note\" data-kid=\"2-2-2-3-2-2\" data-name=\"release footer note text\">Last release 1.0.0 on 2 November 2026 at 09:14 IST</div>\n</div>\n</section>\n<!-- Authorized administrators -->\n<section class=\"panel reveal d6\" data-kid=\"2-2-2-4\" data-name=\"authorized administrators panel\" id=\"admins\">\n<div class=\"panel-head\" data-kid=\"2-2-2-4-1\" data-name=\"administrators panel header\">\n<h2 data-kid=\"2-2-2-4-1-1\" data-name='panel title \"Authorized committee administrators\"'>\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-4-1-1-1\" data-name=\"shield check icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z\"></path><path d=\"m9 12 2 2 4-4\"></path>\n</svg>\n            Authorized committee administrators\n          </h2>\n<span class=\"readonly\" data-kid=\"2-2-2-4-1-2\" data-name=\"read-only badge\">\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-4-1-2-1\" data-name=\"lock icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<rect height=\"11\" rx=\"2\" width=\"18\" x=\"3\" y=\"11\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path>\n</svg>\n            Read only\n          </span>\n</div>\n<div class=\"panel-body\" data-kid=\"2-2-2-4-2\" data-name=\"administrators panel body\">\n<div class=\"admin-list\" data-kid=\"2-2-2-4-2-1\" data-name=\"admin list container\">\n<div class=\"admin-row\" data-kid=\"2-2-2-4-2-1-1\" data-name=\"admin row 1\">\n<span class=\"admin-id\" data-kid=\"2-2-2-4-2-1-1-1\" data-name=\"admin UUID with user avatar icon\">\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-4-2-1-1-1-1\" data-name=\"user avatar icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"></circle><path d=\"M4 21a8 8 0 0 1 16 0\"></path></svg>\n                9c2f14a8-6d31-4be5-8a07-1c9d2f5e7b40\n              </span>\n<span class=\"admin-date\" data-kid=\"2-2-2-4-2-1-1-2\" data-name=\"admin added date\">Added 12 October 2026</span>\n</div>\n<div class=\"admin-row\" data-kid=\"2-2-2-4-2-1-2\" data-name=\"admin row 2\">\n<span class=\"admin-id\" data-kid=\"2-2-2-4-2-1-2-1\" data-name=\"admin UUID with user avatar icon\">\n<svg aria-hidden=\"true\" data-kid=\"2-2-2-4-2-1-2-1-1\" data-name=\"user avatar icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"></circle><path d=\"M4 21a8 8 0 0 1 16 0\"></path></svg>\n                e41b7d05-2ca9-4f8b-93d6-8b1a4c6f2d17\n              </span>\n<span class=\"admin-date\" data-kid=\"2-2-2-4-2-1-2-2\" data-name=\"admin added date\">Added 3 November 2026</span>\n</div>\n</div>\n</div>\n</section>\n</div>\n</div>\n</div>\n<script>\n  document.querySelectorAll('.reveal').forEach(function(el){\n    el.addEventListener('animationend', function(){ el.style.animation = 'none'; }, {once:true});\n  });\n  document.querySelectorAll('.rail-link').forEach(function(link){\n    link.addEventListener('click', function(){\n      document.querySelectorAll('.rail-link').forEach(function(l){ l.classList.remove('active'); });\n      link.classList.add('active');\n    });\n  });\n</script>\n",
