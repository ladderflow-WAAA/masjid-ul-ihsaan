      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  *,*::before,*::after{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:#F7F6F2;color:#18181B;\n    font-family:'Inter','Noto Sans Tamil',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;\n    font-size:14px;\n  }\n\n  .shell{\n    display:grid;grid-template-columns:605px 1fr;\n    min-height:100vh;\n  }\n  .brand,.pane{align-self:stretch;}\n\n  /* ── left: identity ─────────────────────────────── */\n  .brand{\n    background:#0A1F17;border-right:1px solid #122E22;\n    padding:56px 56px 52px;\n    display:flex;flex-direction:column;justify-content:space-between;\n  }\n  .ar{\n    font-family:'Noto Naskh Arabic',serif;font-weight:700;\n    font-size:43px;line-height:1.95;color:#F5F3EF;\n    margin:0 0 2px;letter-spacing:0;\n    text-align:left;direction:rtl;unicode-bidi:isolate;\n  }\n  .en{\n    margin:0;font-size:24px;font-weight:600;letter-spacing:-0.02em;\n    color:#F5F3EF;line-height:1.25;\n  }\n  .ta{\n    margin-top:8px;font-family:'Noto Sans Tamil',sans-serif;\n    font-size:15px;font-weight:400;color:#8FBAA8;line-height:1.6;\n  }\n\n  .brand-foot{border-top:1px solid #122E22;padding-top:26px;}\n  .fact{\n    display:flex;align-items:flex-start;gap:11px;\n    margin-bottom:13px;color:#A7C9BB;font-size:13px;line-height:1.55;\n  }\n  .fact:last-of-type{margin-bottom:0;}\n  .fact i{font-size:15px;color:#6E9585;margin-top:1px;flex:none;}\n\n  .next{\n    margin-top:30px;padding-top:18px;\n    border-top:1px solid rgba(245,158,11,0.5);\n    display:flex;align-items:baseline;justify-content:space-between;gap:16px;\n  }\n  .next-label{\n    font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;\n    color:#7FA694;\n  }\n  .next-time{\n    font-size:15px;font-weight:600;color:#F5F3EF;\n    font-variant-numeric:tabular-nums;letter-spacing:-0.01em;\n  }\n\n  /* ── right: form ────────────────────────────────── */\n  .pane{\n    background:#F7F6F2;position:relative;\n    display:flex;align-items:center;justify-content:center;\n    padding:88px 48px;\n  }\n  .pub{\n    position:absolute;top:30px;right:38px;\n    display:inline-flex;align-items:center;gap:7px;\n    padding:8px 11px;border-radius:8px;\n    font-size:13px;font-weight:500;color:#0D5C3A;text-decoration:none;\n    transition:background 200ms cubic-bezier(0.22,1,0.36,1);\n  }\n  .pub i{font-size:14px;}\n  .pub:hover{background:#EFECE7;}\n\n  .wrap{width:400px;max-width:100%;}\n  h2{\n    margin:0;font-size:28px;font-weight:600;letter-spacing:-0.02em;\n    color:#18181B;line-height:1.2;\n  }\n  .rule{height:1px;background:#E6E2DB;margin:22px 0 26px;}\n\n  .field{margin-bottom:16px;}\n  .field label{\n    display:block;font-size:12px;font-weight:500;color:#6B6560;\n    margin-bottom:7px;letter-spacing:0;\n  }\n  .inp{position:relative;}\n  .inp > i{\n    position:absolute;left:13px;top:50%;transform:translateY(-50%);\n    font-size:16px;color:#9C9590;pointer-events:none;\n  }\n  input{\n    width:100%;height:44px;\n    border:1px solid #E6E2DB;border-radius:10px;\n    background:#FFFFFF;color:#18181B;\n    font-family:inherit;font-size:14px;\n    padding:0 44px 0 40px;\n    outline:none;\n    transition:border-color 200ms cubic-bezier(0.22,1,0.36,1),\n               box-shadow 200ms cubic-bezier(0.22,1,0.36,1),\n               background 200ms;\n  }\n  input::placeholder{color:#9C9590;font-size:13.5px;}\n  input:focus{\n    border-color:#0D5C3A;\n    box-shadow:0 0 0 3px rgba(13,92,58,0.13);\n  }\n  input:-webkit-autofill{-webkit-box-shadow:0 0 0 40px #FFFFFF inset;}\n\n  .peek{\n    position:absolute;right:5px;top:50%;transform:translateY(-50%);\n    width:34px;height:34px;border:0;background:transparent;border-radius:8px;\n    display:grid;place-items:center;cursor:pointer;color:#9C9590;\n    transition:color 200ms,background 200ms;\n  }\n  .pane .peek i{position:static;transform:none;font-size:16px;color:inherit;}\n  .peek:hover{color:#6B6560;background:#F7F6F2;}\n\n  .submit{\n    width:100%;height:44px;margin-top:10px;\n    border:0;border-radius:10px;\n    background:#0D5C3A;color:#FFFFFF;\n    font-family:inherit;font-size:13.5px;font-weight:600;letter-spacing:0.005em;\n    cursor:pointer;\n    transition:background 200ms cubic-bezier(0.22,1,0.36,1),\n               transform 140ms cubic-bezier(0.22,1,0.36,1),\n               box-shadow 200ms;\n    box-shadow:0 1px 2px rgba(10,31,23,0.16);\n  }\n  .pub i,.foot i{flex:none;}\n  .btn-inner{display:inline-flex;align-items:center;gap:8px;}\n  .submit i{font-size:15px;}\n  .submit:hover{background:#094229;}\n  .submit:active{transform:scale(0.985);}\n  .submit:focus-visible{outline:none;box-shadow:0 0 0 2px #F7F6F2,0 0 0 4px rgba(13,92,58,0.45);}\n\n  .err{\n    margin-top:18px;\n    background:#FEF2F2;border:1px solid #FECACA;border-radius:10px;\n    padding:12px 14px;\n    display:flex;align-items:flex-start;gap:10px;\n    font-size:12.5px;line-height:1.55;color:#991B1B;\n  }\n  .err i{font-size:16px;color:#DC2626;margin-top:1px;flex:none;}\n\n  .foot{\n    margin-top:26px;padding-top:20px;border-top:1px solid #E6E2DB;\n  }\n  .foot p{\n    margin:0 0 14px;font-size:13px;line-height:1.55;color:#9C9590;\n  }\n  .back{\n    display:inline-flex;align-items:center;gap:7px;\n    font-size:13px;font-weight:600;color:#0D5C3A;text-decoration:none;\n    transition:color 200ms;\n  }\n  .back i{font-size:14px;}\n  .back:hover{color:#094229;}\n  .back:hover span{text-decoration:underline;text-underline-offset:3px;}\n\n  /* ── motion ─────────────────────────────────────── */\n  @keyframes rise{from{opacity:0;transform:translateY(9px);}to{opacity:1;transform:translateY(0);}}\n  @keyframes slide{from{opacity:0;transform:translateX(-10px);}to{opacity:1;transform:translateX(0);}}\n  .r{opacity:0;animation:rise 520ms cubic-bezier(0.22,1,0.36,1) forwards;}\n  .s{opacity:0;animation:slide 620ms cubic-bezier(0.22,1,0.36,1) forwards;}\n\n  @media (prefers-reduced-motion: reduce){\n    .r,.s{animation:none;opacity:1;}\n    *{transition:none !important;}\n  }\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n<aside class=\"brand\" data-kid=\"1-1\" data-name=\"mosque brand identity sidebar\">\n<div class=\"brand-top\" data-kid=\"1-1-1\" data-name=\"mosque name heading group\">\n<div class=\"ar s\" data-kid=\"1-1-1-1\" data-name=\"Arabic mosque name script\" dir=\"rtl\" style=\"animation-delay:0ms\">مَسْجِدُ الْإِحْسَانِ</div>\n<h1 class=\"en s\" data-kid=\"1-1-1-2\" data-name=\"English mosque name headline\" style=\"animation-delay:70ms\">Masjidul Ihsaan</h1>\n<div class=\"ta s\" data-kid=\"1-1-1-3\" data-name=\"Tamil mosque name text\" style=\"animation-delay:110ms\">மஸ்ஜிதுல் இஹ்சான்</div>\n</div>\n<div class=\"brand-foot s\" data-kid=\"1-1-2\" data-name=\"brand contact footer\" style=\"animation-delay:170ms\">\n<div class=\"fact\" data-kid=\"1-1-2-1\" data-name=\"mosque address row\">\n<i class=\"icon-map-pin\" data-kid=\"1-1-2-1-1\" data-name=\"map pin icon\"></i>\n<span data-kid=\"1-1-2-1-2\" data-name=\"address text\">Skylab Avenue, Sithalapakkam,<br data-kid=\"1-1-2-1-2-1\" data-name=\"line break in address\"/>Tambaram, Tamil Nadu 600131</span>\n</div>\n<div class=\"fact\" data-kid=\"1-1-2-2\" data-name=\"mosque phone number row\">\n<i class=\"icon-phone\" data-kid=\"1-1-2-2-1\" data-name=\"phone icon\"></i>\n<span data-kid=\"1-1-2-2-2\" data-name=\"phone number text\">+91 94440 00000</span>\n</div>\n<div class=\"next\" data-kid=\"1-1-2-3\" data-name=\"next prayer callout row\">\n<span class=\"next-label\" data-kid=\"1-1-2-3-1\" data-name=\"prayer label text\">Jumu’ah Iqamah</span>\n<span class=\"next-time\" data-kid=\"1-1-2-3-2\" data-name=\"next prayer time text\">1:15 PM</span>\n</div>\n</div>\n</aside>\n<main class=\"pane\" data-kid=\"1-2\" data-name=\"main content pane with login form\">\n<a class=\"pub r\" data-kid=\"1-2-1\" data-name=\"public timetable link\" href=\"#\" style=\"animation-delay:60ms\">\n      Public timetable <i class=\"icon-external-link\" data-kid=\"1-2-1-1\" data-name=\"external link icon\"></i>\n</a>\n<div class=\"wrap\" data-kid=\"1-2-2\" data-name=\"login form wrapper\">\n<h2 class=\"r\" data-kid=\"1-2-2-1\" data-name=\"login form headline\" style=\"animation-delay:120ms\">Committee Portal</h2>\n<div class=\"rule r\" data-kid=\"1-2-2-2\" data-name=\"decorative divider rule\" style=\"animation-delay:150ms\"></div>\n<form data-kid=\"1-2-2-3\" data-name=\"admin sign-in form\" onsubmit=\"return false;\">\n<div class=\"field r\" data-kid=\"1-2-2-3-1\" data-name=\"email field wrapper\" style=\"animation-delay:190ms\">\n<label data-kid=\"1-2-2-3-1-1\" data-name=\"email field label\" for=\"email\">Admin Email</label>\n<div class=\"inp\" data-kid=\"1-2-2-3-1-2\" data-name=\"email input wrapper\">\n<i class=\"icon-mail\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"mail icon\"></i>\n<input autocomplete=\"username\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"email input field\" id=\"email\" placeholder=\"committee@masjidulihsaan.org\" type=\"email\" value=\"committee@masjidulihsaan.org\"/>\n</div>\n</div>\n<div class=\"field r\" data-kid=\"1-2-2-3-2\" data-name=\"password field wrapper\" style=\"animation-delay:230ms\">\n<label data-kid=\"1-2-2-3-2-1\" data-name=\"password field label\" for=\"password\">Password</label>\n<div class=\"inp\" data-kid=\"1-2-2-3-2-2\" data-name=\"password input wrapper\">\n<i class=\"icon-lock\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"lock icon\"></i>\n<input autocomplete=\"current-password\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"password input field\" data-reason=\"input type toggled between password and text by peek button script\" id=\"password\" placeholder=\"••••••••••••\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"peek\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"show password toggle button\" data-reason=\"aria-label rewritten by peek script to Show/Hide password\" id=\"peek\" type=\"button\">\n<i class=\"icon-eye\" data-kid=\"1-2-2-3-2-2-3-1\" data-name=\"eye icon\" id=\"peekIcon\"></i>\n</button>\n</div>\n</div>\n<button class=\"submit r\" data-kid=\"1-2-2-3-3\" data-name=\"submit sign-in button\" style=\"animation-delay:270ms\" type=\"submit\">\n<span class=\"btn-inner\" data-kid=\"1-2-2-3-3-1\" data-name=\"submit button label\">Sign In</span>\n</button>\n</form>\n<div class=\"err r\" data-kid=\"1-2-2-4\" data-name=\"access denied error message\" role=\"alert\" style=\"animation-delay:330ms\">\n<i class=\"icon-alert-circle\" data-kid=\"1-2-2-4-1\" data-name=\"error alert icon\"></i>\n<span data-kid=\"1-2-2-4-2\" data-name=\"error message text\">Access denied: This account is not listed in the authorized masjid administrators table.</span>\n</div>\n<div class=\"foot r\" data-kid=\"1-2-2-5\" data-name=\"form footer\" style=\"animation-delay:380ms\">\n<p data-kid=\"1-2-2-5-1\" data-name=\"access restriction notice text\">Access is restricted to authorized masjid committee administrators.</p>\n<a class=\"back\" data-kid=\"1-2-2-5-2\" data-name=\"back to public timetable link\" href=\"#\"><i class=\"icon-arrow-left\" data-kid=\"1-2-2-5-2-1\" data-name=\"arrow left icon\"></i><span data-kid=\"1-2-2-5-2-2\" data-name=\"back link text\">Back to public timetable</span></a>\n</div>\n</div>\n</main>\n</div>\n<script>\n  (function () {\n    var input = document.getElementById('password');\n    var btn = document.getElementById('peek');\n    var icon = document.getElementById('peekIcon');\n    btn.addEventListener('click', function () {\n      var shown = input.type === 'text';\n      input.type = shown ? 'password' : 'text';\n      icon.className = shown ? 'icon-eye' : 'icon-eye-off';\n      btn.setAttribute('aria-label', shown ? 'Show password' : 'Hide password');\n      input.focus();\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-11-06T14:23:40.870586+00:00",
      "modified": "2026-11-06T14:24:55.549970+00:00",
      "id": "var_ee71fc5ac9f8",
      "contentHeight": 1000
    },
    "var_1b84a002af40": {
      "type": "variant",
      "label": "Dashboard — Coverage & today",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3990,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500&family=Noto+Naskh+Arabic:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n:root{\n  --ink:#0A1F17; --ink-border:#122E22; --primary:#0D5C3A; --primary-hover:#094229;\n  --accent:#047857; --tint:#F0F9F5; --gold:#F59E0B; --gold-ink:#B45309;\n  --bg:#F7F6F2; --surface:#FFFFFF; --border:#E6E2DB; --muted:#EFECE7;\n  --text:#18181B; --secondary:#6B6560; --tertiary:#9C9590; --sage:#A7D5C4;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:var(--bg);}\nbody{\n  font-family:'Inter','Noto Sans Tamil',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  color:var(--text);\n  -webkit-font-smoothing:antialiased;\n  -moz-osx-font-smoothing:grayscale;\n  font-size:14px;\n  line-height:1.45;\n}\n.num{font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\" 1;}\n\n/* ── nav ───────────────────────────────────────────── */\n.nav{background:var(--ink);border-bottom:1px solid var(--ink-border);height:64px;}\n.nav-wrap{max-width:1440px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px;}\n\n.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#F5F3EF;}\n.brand-mark{width:26px;height:26px;border-radius:8px;background:rgba(167,213,196,.10);\n  border:1px solid rgba(167,213,196,.22);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.brand-mark svg{width:15px;height:15px;display:block;color:var(--sage);}\n.brand-name{font-size:15px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;}\n\n.nav-mid{display:flex;align-items:center;gap:2px;margin-left:18px;}\n.nav-link{\n  position:relative;display:inline-flex;align-items:center;height:64px;\n  padding:0 14px;font-size:13.5px;font-weight:500;color:var(--sage);\n  text-decoration:none;transition:color 200ms cubic-bezier(.22,1,.36,1);\n}\n.nav-link:hover{color:#F5F3EF;}\n.nav-link.active{color:#F5F3EF;font-weight:600;}\n.nav-link.active::after{\n  content:\"\";position:absolute;left:14px;right:14px;bottom:-1px;height:2px;\n  background:var(--sage);border-radius:2px 2px 0 0;\n}\n\n.nav-right{display:flex;align-items:center;gap:6px;}\n.ghost{\n  display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 10px;\n  color:var(--sage);font-size:13px;font-weight:500;text-decoration:none;border-radius:8px;\n  transition:color 200ms cubic-bezier(.22,1,.36,1),background-color 200ms cubic-bezier(.22,1,.36,1);\n}\n.ghost:hover{color:#F5F3EF;background:rgba(255,255,255,.06);}\n.ghost i{font-size:14px;}\n.nav-sep{width:1px;height:18px;background:rgba(167,213,196,.22);margin:0 4px;}\n\n/* ── page ──────────────────────────────────────────── */\n.wrap{max-width:1440px;margin:0 auto;padding:24px;}\n\n.title-row{height:64px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}\nh1{margin:0;font-size:28px;font-weight:600;letter-spacing:-0.02em;line-height:1.2;color:var(--text);}\n.title-date{font-size:14px;color:var(--secondary);padding-top:7px;}\n\n/* coverage */\n.coverage{\n  height:80px;background:var(--surface);border:1px solid var(--border);border-radius:14px;\n  padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:24px;\n}\n.cov-label{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--tertiary);}\n.cov-line{display:flex;align-items:baseline;gap:14px;margin-top:2px;}\n.cov-value{font-size:22px;font-weight:600;letter-spacing:-0.015em;color:var(--text);}\n.cov-sub{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--secondary);}\n.dot{width:6px;height:6px;border-radius:50%;background:var(--accent);display:inline-block;flex:0 0 auto;}\n\n.btn-secondary{\n  display:inline-flex;align-items:center;justify-content:center;gap:7px;\n  height:40px;padding:0 16px;border-radius:10px;background:var(--surface);\n  border:1px solid var(--border);color:var(--text);font-size:13px;font-weight:600;\n  text-decoration:none;white-space:nowrap;cursor:pointer;\n  transition:background-color 200ms cubic-bezier(.22,1,.36,1),border-color 200ms cubic-bezier(.22,1,.36,1);\n}\n.btn-secondary:hover{background:#FBFAF7;border-color:#DAD5CC;}\n.btn-secondary i{font-size:14px;color:var(--secondary);}\n\n/* facts strip */\n.facts{height:40px;display:flex;align-items:center;gap:18px;padding:0 2px;}\n.fact{display:inline-flex;align-items:baseline;gap:6px;font-size:13px;color:var(--secondary);}\n.fact b{font-size:14px;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums;}\n.fact-div{width:1px;height:14px;background:var(--border);flex:0 0 auto;}\n\n/* ── panels ────────────────────────────────────────── */\n.grid{display:grid;grid-template-columns:820px 552px;gap:20px;align-items:stretch;}\n.panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;display:flex;flex-direction:column;}\n.p-head{height:48px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 16px;}\n.p-title{font-size:15px;font-weight:600;letter-spacing:-0.01em;color:var(--text);}\n.p-sub{font-size:13px;color:var(--secondary);}\n\n/* today table */\n.t-head{display:grid;grid-template-columns:1fr 100px 100px;padding:0 16px;height:32px;align-items:center;\n  border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:#FBFAF7;}\n.t-head span{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--tertiary);}\n.t-head .r{text-align:right;}\ntbody{display:block;}\n.row{display:grid;grid-template-columns:1fr 100px 100px;align-items:center;height:36px;padding:0 16px;border-bottom:1px solid #F1EEE8;}\n.row:last-child{border-bottom:none;}\n.prayer{font-size:13.5px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:10px;}\n.time{font-size:13px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-0.01em;}\n.time.azan{color:var(--secondary);}\n.time.iq{color:var(--text);font-weight:600;}\n.row.sunrise{background:#FCFBF8;}\n.sunrise .p-name{font-size:13px;font-weight:500;color:var(--secondary);}\n.sunrise .time{color:var(--secondary);font-weight:400;}\n\n.row.jumu{height:52px;background:var(--tint);}\n.row.jumu .prayer{flex-direction:column;align-items:flex-start;gap:1px;}\n.jumu-name{font-size:13.5px;font-weight:600;color:var(--primary);}\n.bayan{font-size:11.5px;font-weight:500;color:var(--gold-ink);letter-spacing:.01em;}\n.jumu .time.iq{color:var(--primary);}\n\n.p-foot{height:44px;margin-top:auto;display:flex;align-items:center;padding:0 16px;border-top:1px solid var(--border);}\n.foot-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--primary);\n  text-decoration:none;transition:opacity 200ms;}\n.foot-link:hover{opacity:.75;}\n.foot-link i{font-size:14px;}\n\n/* recent announcements */\n.ann{display:block;padding:0 16px;height:64px;border-bottom:1px solid #F1EEE8;text-decoration:none;\n  transition:background-color 200ms cubic-bezier(.22,1,.36,1);}\n.ann:hover{background:#FBFAF7;}\n.ann-in{height:64px;display:flex;align-items:center;justify-content:space-between;gap:18px;}\n.ann-main{min-width:0;flex:1;}\n.ann-title{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-0.005em;}\n.ann-meta{display:flex;align-items:center;gap:9px;margin-top:3px;}\n.cat{font-size:11px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:var(--tertiary);}\n.urgent{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;\n  letter-spacing:.05em;text-transform:uppercase;color:var(--gold-ink);}\n.urgent .dot{background:var(--gold);width:5px;height:5px;}\n.status{font-size:12px;color:var(--tertiary);white-space:nowrap;flex:0 0 auto;}\n.status.draft{display:inline-flex;align-items:center;gap:6px;color:var(--secondary);}\n.status.draft::before{content:\"\";width:6px;height:6px;border-radius:50%;border:1px solid #C9C2B7;display:inline-block;}\n\n.btn-primary{\n  display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:40px;\n  padding:0 20px;\n  -webkit-appearance:none;appearance:none;\n  background:var(--primary);color:#FFFFFF;border:0;border-radius:10px;\n  font-family:'Inter',system-ui,sans-serif;font-size:13px;font-weight:600;\n  letter-spacing:0;line-height:1;cursor:pointer;text-decoration:none;\n  transition:background-color 200ms cubic-bezier(.22,1,.36,1);\n}\n.btn-primary > span{display:block;line-height:1;}\n.btn-primary:hover{background:var(--primary-hover);}\n.recent-foot{margin-top:auto;padding:16px;border-top:1px solid var(--border);}\n\n/* motion */\n@keyframes rise{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}\n.a{animation:rise 340ms cubic-bezier(.22,1,.36,1) both;}\n.d1{animation-delay:.03s}.d2{animation-delay:.08s}.d3{animation-delay:.13s}\n.d4{animation-delay:.18s}.d5{animation-delay:.23s}.d6{animation-delay:.28s}\n\na:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px;}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"top navigation bar\">\n<div class=\"nav-wrap\" data-kid=\"1-1\" data-name=\"nav layout container\">\n<div data-kid=\"1-1-1\" data-name=\"left navigation group\" style=\"display:flex;align-items:center;\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"mosque brand logo link\" href=\"#\">\n<span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark icon container\">\n<svg data-kid=\"1-1-1-1-1-1\" data-name=\"mosque dome brand icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n<path d=\"M12 3.5c2.2 1.4 3.6 3.1 3.6 5.1 0 1-.4 1.9-1.1 2.6\"></path>\n<path d=\"M5 20v-6.2a7 7 0 0 1 14 0V20\"></path>\n<path d=\"M3 20h18\"></path>\n<path d=\"M10.4 20v-3.2a1.6 1.6 0 0 1 3.2 0V20\"></path>\n</svg>\n</span>\n<span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"mosque brand name text\">Masjidul Ihsaan</span>\n</a>\n<nav class=\"nav-mid\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"nav-link active\" data-kid=\"1-1-1-2-1\" data-name=\"Dashboard nav link (active)\" href=\"#\">Dashboard</a>\n<a class=\"nav-link\" data-kid=\"1-1-1-2-2\" data-name=\"Timetable nav link\" href=\"#\">Timetable</a>\n<a class=\"nav-link\" data-kid=\"1-1-1-2-3\" data-name=\"Announcements nav link\" href=\"#\">Announcements</a>\n<a class=\"nav-link\" data-kid=\"1-1-1-2-4\" data-name=\"Settings nav link\" href=\"#\">Settings</a>\n</nav>\n</div>\n<div class=\"nav-right\" data-kid=\"1-1-2\" data-name=\"right navigation actions\">\n<a class=\"ghost\" data-kid=\"1-1-2-1\" data-name=\"View public site ghost link\" href=\"#\">View public site <i class=\"icon-external-link\" data-kid=\"1-1-2-1-1\" data-name=\"external link icon\"></i></a>\n<span class=\"nav-sep\" data-kid=\"1-1-2-2\" data-name=\"nav separator divider\"></span>\n<a class=\"ghost\" data-kid=\"1-1-2-3\" data-name=\"Sign out ghost link\" href=\"#\">Sign out</a>\n</div>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"2\" data-name=\"main dashboard page\">\n<div class=\"title-row a d1\" data-kid=\"2-1\" data-name=\"page title row\">\n<h1 data-kid=\"2-1-1\" data-name=\"dashboard page headline\">Dashboard</h1>\n<div class=\"title-date\" data-kid=\"2-1-2\" data-name=\"dashboard date heading\">Friday, 6 November 2026</div>\n</div>\n<section class=\"coverage a d2\" data-kid=\"2-2\" data-name=\"timetable coverage summary card\" style=\"margin-bottom:20px;\">\n<div data-kid=\"2-2-1\" data-name=\"coverage label and value group\">\n<div class=\"cov-label\" data-kid=\"2-2-1-1\" data-name=\"timetable coverage label\">Timetable coverage</div>\n<div class=\"cov-line\" data-kid=\"2-2-1-2\" data-name=\"coverage value line\">\n<span class=\"cov-value num\" data-kid=\"2-2-1-2-1\" data-name=\"coverage value text\">24 days ahead</span>\n<span class=\"cov-sub\" data-kid=\"2-2-1-2-2\" data-name=\"coverage published-until subtitle\"><i class=\"dot\" data-kid=\"2-2-1-2-2-1\" data-name=\"status indicator dot\"></i>Published to 30 November 2026</span>\n</div>\n</div>\n<a class=\"btn-secondary\" data-kid=\"2-2-2\" data-name=\"edit timetable secondary button\" href=\"#\">Edit timetable <i class=\"icon-chevron-right\" data-kid=\"2-2-2-1\" data-name=\"chevron right icon\"></i></a>\n</section>\n<div class=\"facts a d3\" data-kid=\"2-3\" data-name=\"stats facts strip\" style=\"margin-bottom:20px;\">\n<div class=\"fact\" data-kid=\"2-3-1\" data-name=\"push subscribers stat\"><b data-kid=\"2-3-1-1\" data-name=\"push subscribers count\">142</b><span data-kid=\"2-3-1-2\" data-name=\"push subscribers label\">push subscribers</span></div>\n<span class=\"fact-div\" data-kid=\"2-3-2\" data-name=\"stat divider\"></span>\n<div class=\"fact\" data-kid=\"2-3-3\" data-name=\"published notices stat\"><b data-kid=\"2-3-3-1\" data-name=\"published notices count\">4</b><span data-kid=\"2-3-3-2\" data-name=\"published notices label\">published notices</span></div>\n<span class=\"fact-div\" data-kid=\"2-3-4\" data-name=\"stat divider\"></span>\n<div class=\"fact\" data-kid=\"2-3-5\" data-name=\"draft stat\"><b data-kid=\"2-3-5-1\" data-name=\"draft count\">1</b><span data-kid=\"2-3-5-2\" data-name=\"draft label\">draft</span></div>\n<span class=\"fact-div\" data-kid=\"2-3-6\" data-name=\"stat divider\"></span>\n<div class=\"fact\" data-kid=\"2-3-7\" data-name=\"urgent notice stat\"><b data-kid=\"2-3-7-1\" data-name=\"urgent notice count\">1</b><span data-kid=\"2-3-7-2\" data-name=\"urgent notice label\">urgent notice</span></div>\n</div>\n<div class=\"grid\" data-kid=\"2-4\" data-name=\"main content two-column grid\">\n<section class=\"panel a d4\" data-kid=\"2-4-1\" data-name=\"today's prayer times panel\">\n<div class=\"p-head\" data-kid=\"2-4-1-1\" data-name=\"panel header\">\n<div class=\"p-title\" data-kid=\"2-4-1-1-1\" data-name=\"prayer times panel title\">Today’s prayer times</div>\n<div class=\"p-sub\" data-kid=\"2-4-1-1-2\" data-name=\"prayer times date subheading\">Friday 6 November</div>\n</div>\n<div class=\"t-head\" data-kid=\"2-4-1-2\" data-name=\"prayer table header row\">\n<span data-kid=\"2-4-1-2-1\" data-name=\"prayer column header\">Prayer</span>\n<span class=\"r\" data-kid=\"2-4-1-2-2\" data-name=\"azan column header\">Azan</span>\n<span class=\"r\" data-kid=\"2-4-1-2-3\" data-name=\"iqamah column header\">Iqamah</span>\n</div>\n<div class=\"row\" data-kid=\"2-4-1-3\" data-name=\"Fajr prayer row\">\n<div class=\"prayer\" data-kid=\"2-4-1-3-1\" data-name=\"Fajr prayer label\">Fajr</div>\n<div class=\"time azan\" data-kid=\"2-4-1-3-2\" data-name=\"Fajr azan time\">5:00 AM</div>\n<div class=\"time iq\" data-kid=\"2-4-1-3-3\" data-name=\"Fajr iqamah time\">5:30 AM</div>\n</div>\n<div class=\"row sunrise\" data-kid=\"2-4-1-4\" data-name=\"sunrise row\">\n<div class=\"prayer\" data-kid=\"2-4-1-4-1\" data-name=\"sunrise label wrapper\"><span class=\"p-name\" data-kid=\"2-4-1-4-1-1\" data-name=\"sunrise label\">Sunrise</span></div>\n<div class=\"time\" data-kid=\"2-4-1-4-2\" data-name=\"sunrise time\">6:01 AM</div>\n<div class=\"time\" data-kid=\"2-4-1-4-3\" data-name=\"sunrise em dash placeholder\">—</div>\n</div>\n<div class=\"row jumu\" data-kid=\"2-4-1-5\" data-name=\"Jumu'ah row\">\n<div class=\"prayer\" data-kid=\"2-4-1-5-1\" data-name=\"Jumu'ah label group\">\n<span class=\"jumu-name\" data-kid=\"2-4-1-5-1-1\" data-name=\"Jumu'ah prayer name\">Jumu’ah</span>\n<span class=\"bayan num\" data-kid=\"2-4-1-5-1-2\" data-name=\"bayan time subtitle\">Bayan 12:45 PM</span>\n</div>\n<div class=\"time azan\" data-kid=\"2-4-1-5-2\" data-name=\"Jumu'ah azan time\">12:30 PM</div>\n<div class=\"time iq\" data-kid=\"2-4-1-5-3\" data-name=\"Jumu'ah iqamah time\">1:15 PM</div>\n</div>\n<div class=\"row\" data-kid=\"2-4-1-6\" data-name=\"Asr prayer row\">\n<div class=\"prayer\" data-kid=\"2-4-1-6-1\" data-name=\"Asr prayer label\">Asr</div>\n<div class=\"time azan\" data-kid=\"2-4-1-6-2\" data-name=\"Asr azan time\">3:45 PM</div>\n<div class=\"time iq\" data-kid=\"2-4-1-6-3\" data-name=\"Asr iqamah time\">4:15 PM</div>\n</div>\n<div class=\"row\" data-kid=\"2-4-1-7\" data-name=\"Maghrib prayer row\">\n<div class=\"prayer\" data-kid=\"2-4-1-7-1\" data-name=\"Maghrib prayer label\">Maghrib</div>\n<div class=\"time azan\" data-kid=\"2-4-1-7-2\" data-name=\"Maghrib azan time\">6:00 PM</div>\n<div class=\"time iq\" data-kid=\"2-4-1-7-3\" data-name=\"Maghrib iqamah time\">6:10 PM</div>\n</div>\n<div class=\"row\" data-kid=\"2-4-1-8\" data-name=\"Isha prayer row\">\n<div class=\"prayer\" data-kid=\"2-4-1-8-1\" data-name=\"Isha prayer label\">Isha</div>\n<div class=\"time azan\" data-kid=\"2-4-1-8-2\" data-name=\"Isha azan time\">7:30 PM</div>\n<div class=\"time iq\" data-kid=\"2-4-1-8-3\" data-name=\"Isha iqamah time\">8:15 PM</div>\n</div>\n<div class=\"p-foot\" data-kid=\"2-4-1-9\" data-name=\"prayer panel footer\">\n<a class=\"foot-link\" data-kid=\"2-4-1-9-1\" data-name=\"edit timetable footer link\" href=\"#\">Edit timetable <i class=\"icon-chevron-right\" data-kid=\"2-4-1-9-1-1\" data-name=\"chevron right icon\"></i></a>\n</div>\n</section>\n<section class=\"panel a d5\" data-kid=\"2-4-2\" data-name=\"recent announcements panel\">\n<div class=\"p-head\" data-kid=\"2-4-2-1\" data-name=\"announcements panel header\">\n<div class=\"p-title\" data-kid=\"2-4-2-1-1\" data-name=\"announcements panel title\">Recent announcements</div>\n<div class=\"p-sub num\" data-kid=\"2-4-2-1-2\" data-name=\"announcements count subheading\">4 of 5</div>\n</div>\n<a class=\"ann\" data-kid=\"2-4-2-2\" data-name=\"first announcement link (urgent schedule change)\" href=\"#\">\n<div class=\"ann-in\" data-kid=\"2-4-2-2-1\" data-name=\"announcement inner layout\">\n<div class=\"ann-main\" data-kid=\"2-4-2-2-1-1\" data-name=\"announcement main content\">\n<div class=\"ann-title\" data-kid=\"2-4-2-2-1-1-1\" data-name=\"announcement title text\">Isha Iqamah moved to 8:15 PM from this week</div>\n<div class=\"ann-meta\" data-kid=\"2-4-2-2-1-1-2\" data-name=\"announcement meta row\">\n<span class=\"cat\" data-kid=\"2-4-2-2-1-1-2-1\" data-name=\"announcement category label\">Schedule change</span>\n<span class=\"urgent\" data-kid=\"2-4-2-2-1-1-2-2\" data-name=\"urgent badge\"><i class=\"dot\" data-kid=\"2-4-2-2-1-1-2-2-1\" data-name=\"urgent indicator dot\"></i>Urgent</span>\n</div>\n</div>\n<span class=\"status\" data-kid=\"2-4-2-2-1-2\" data-name=\"announcement status text\">Push sent 4 Nov</span>\n</div>\n</a>\n<a class=\"ann\" data-kid=\"2-4-2-3\" data-name=\"second announcement link (weekly bayan)\" href=\"#\">\n<div class=\"ann-in\" data-kid=\"2-4-2-3-1\" data-name=\"announcement inner layout\">\n<div class=\"ann-main\" data-kid=\"2-4-2-3-1-1\" data-name=\"announcement main content\">\n<div class=\"ann-title\" data-kid=\"2-4-2-3-1-1-1\" data-name=\"announcement title text\">Weekly Jumu’ah Bayan</div>\n<div class=\"ann-meta\" data-kid=\"2-4-2-3-1-1-2\" data-name=\"announcement meta row\"><span class=\"cat\" data-kid=\"2-4-2-3-1-1-2-1\" data-name=\"announcement category label\">Bayan</span></div>\n</div>\n<span class=\"status\" data-kid=\"2-4-2-3-1-2\" data-name=\"announcement status text\">Published 5 Nov</span>\n</div>\n</a>\n<a class=\"ann\" data-kid=\"2-4-2-4\" data-name=\"third announcement link (madrasa admission)\" href=\"#\">\n<div class=\"ann-in\" data-kid=\"2-4-2-4-1\" data-name=\"announcement inner layout\">\n<div class=\"ann-main\" data-kid=\"2-4-2-4-1-1\" data-name=\"announcement main content\">\n<div class=\"ann-title\" data-kid=\"2-4-2-4-1-1-1\" data-name=\"announcement title text\">Weekend Madrasa Admission Open</div>\n<div class=\"ann-meta\" data-kid=\"2-4-2-4-1-1-2\" data-name=\"announcement meta row\"><span class=\"cat\" data-kid=\"2-4-2-4-1-1-2-1\" data-name=\"announcement category label\">Community</span></div>\n</div>\n<span class=\"status\" data-kid=\"2-4-2-4-1-2\" data-name=\"announcement status text\">Published 1 Nov</span>\n</div>\n</a>\n<a class=\"ann\" data-kid=\"2-4-2-5\" data-name=\"fourth announcement link (Ramadan draft)\" href=\"#\" style=\"border-bottom:none;\">\n<div class=\"ann-in\" data-kid=\"2-4-2-5-1\" data-name=\"announcement inner layout\">\n<div class=\"ann-main\" data-kid=\"2-4-2-5-1-1\" data-name=\"announcement main content\">\n<div class=\"ann-title\" data-kid=\"2-4-2-5-1-1-1\" data-name=\"announcement title text\">Ramadan Timetable Preparation Meeting</div>\n<div class=\"ann-meta\" data-kid=\"2-4-2-5-1-1-2\" data-name=\"announcement meta row\"><span class=\"cat\" data-kid=\"2-4-2-5-1-1-2-1\" data-name=\"announcement category label\">Ramadan</span></div>\n</div>\n<span class=\"status draft\" data-kid=\"2-4-2-5-1-2\" data-name=\"draft status pill\">Draft</span>\n</div>\n</a>\n<div class=\"recent-foot\" data-kid=\"2-4-2-6\" data-name=\"announcements panel footer\">\n<button class=\"btn-primary\" data-kid=\"2-4-2-6-1\" data-name=\"new announcement primary button\" type=\"button\"><span data-kid=\"2-4-2-6-1-1\" data-name=\"button label span\">New announcement</span></button>\n</div>\n</section>\n</div>\n</main>\n<script>\n(function(){\n  var els = document.querySelectorAll('.a');\n  els.forEach(function(el){\n    el.addEventListener('animationend', function(){ el.style.animation = 'none'; }, {once:true});\n  });\n})();\n</script>",
