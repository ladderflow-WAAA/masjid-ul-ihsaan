      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n*{box-sizing:border-box}\nhtml,body{height:100%}\nbody{margin:0;background:#F5F3EF;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#18181B;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\n.tn{font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\" 1}\n.ta{font-family:'Noto Sans Tamil','Inter',sans-serif}\n\n.phone{width:100%;height:100vh;min-height:844px;display:flex;flex-direction:column;background:#F5F3EF;overflow:hidden;position:relative}\n\n/* status bar */\n.statusbar{flex:none;height:44px;background:#0A1F17;color:#fff;display:flex;align-items:flex-end;justify-content:space-between;padding:0 20px 9px}\n.status-time{font-size:13px;font-weight:600;letter-spacing:.01em}\n.status-icons{display:flex;align-items:center;gap:5px;font-size:14px;color:#fff}\n.status-icons i{display:inline-flex;line-height:1}\n\n/* masthead */\n.masthead{flex:none;background:#0A1F17;padding:2px 16px 17px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px}\n.m-title{margin:0;font-size:21px;font-weight:600;line-height:1.2;color:#FFFFFF;letter-spacing:-0.02em}\n.m-sub{margin-top:3px;font-size:11.5px;font-weight:500;color:#8FB8A8;letter-spacing:.005em}\n.lang{flex:none;display:flex;align-items:center;gap:2px;height:30px;padding:3px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.13);margin-top:1px}\n.lang button{border:0;background:transparent;color:#9DBFB1;font-family:inherit;font-size:11.5px;font-weight:600;height:24px;padding:0 11px;border-radius:999px;cursor:pointer;transition:background .18s ease,color .18s ease}\n.lang button:active{transform:scale(.97)}\n.lang button.on{background:#F5F3EF;color:#0A1F17}\n.lang button.ta{padding:0 9px;font-size:11px}\n\n/* controls */\n.controls{flex:none;padding:12px 16px 0}\n.monthrow{display:flex;align-items:center;gap:9px}\n.monthcard{flex:1;min-width:0;height:44px;display:flex;align-items:center;gap:7px;padding:0 4px 0 13px;background:#FFFFFF;border:1px solid #E8E4DE;border-radius:13px;box-shadow:0 1px 2px rgba(16,24,20,.035)}\n.monthcard .cal{display:inline-flex;font-size:17px;color:#9C9590;line-height:1}\n.monthlabel{flex:1;font-size:14px;font-weight:600;letter-spacing:-0.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.iconbtn{width:32px;height:32px;border:0;border-radius:9px;background:transparent;color:#5F5A54;display:inline-flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;transition:background .16s ease,transform .16s ease}\n.iconbtn:active{background:#EFECE7;transform:scale(.94)}\n.today-btn{height:44px;padding:0 3px;border:0;background:transparent;color:#0D5C3A;font-family:inherit;font-size:12.5px;font-weight:600;letter-spacing:.01em;cursor:pointer;transition:opacity .16s ease}\n.today-btn:active{opacity:.55}\n\n.seg{display:flex;height:40px;padding:3px;margin-top:10px;background:#EFECE7;border-radius:12px}\n.seg button{flex:1;border:0;border-radius:9px;background:transparent;color:#6B6560;font-family:inherit;font-size:13px;font-weight:600;letter-spacing:.005em;cursor:pointer;transition:background .18s ease,color .18s ease,box-shadow .18s ease}\n.seg button:active{transform:scale(.985)}\n.seg button.on{background:#0D5C3A;color:#FFFFFF;box-shadow:0 1px 3px rgba(10,31,23,.22)}\n\n.caption{margin:11px 2px 10px;font-size:13px;font-weight:400;color:#6B6560;letter-spacing:.002em}\n\n/* table */\n.tablecard{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;margin:0 16px 12px;background:#FFFFFF;border:1px solid #E8E4DE;border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,20,.04)}\n.hscroll{flex:1;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}\n.hscroll::-webkit-scrollbar{width:0;height:0;display:none}\ntable{width:476px;border-collapse:separate;border-spacing:0;table-layout:fixed}\n\nthead th{position:sticky;top:0;z-index:3;height:37px;padding:0;background:#FCFBF9;border-bottom:1px solid #E8E4DE;font-size:10px;font-weight:700;letter-spacing:.075em;text-transform:uppercase;color:#8A847D;text-align:center;white-space:nowrap;vertical-align:middle}\nthead th.c-date{left:0;z-index:6;text-align:left;padding-left:14px}\nthead th .stack{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;line-height:10px}\nthead th .stack .a{font-size:10px;font-weight:700;letter-spacing:.07em;color:#B45309}\nthead th .stack .b{font-size:10px;font-weight:700;letter-spacing:.07em;color:#A8A29B}\n\ntbody tr{transition:background .18s ease}\ntbody td{height:52px;padding:0;background:#FFFFFF;border-bottom:1px solid #F2EFEA;text-align:center;vertical-align:middle;font-size:13px;font-weight:500;color:#18181B;white-space:nowrap;font-variant-numeric:tabular-nums}\ntbody tr:last-child td{border-bottom:0}\ntbody td.c-date{position:sticky;left:0;z-index:2;text-align:left;padding-left:14px;border-right:1px solid #F2EFEA;background:#FFFFFF}\ntbody td.jumval{color:#B45309;font-weight:600}\n\n.daycell{display:flex;flex-direction:column;justify-content:center;gap:1px;line-height:1}\n.daynum{font-size:15px;font-weight:600;line-height:18px;letter-spacing:-0.015em;color:#18181B;font-variant-numeric:tabular-nums}\n.daywd{font-size:9.5px;font-weight:600;line-height:12px;letter-spacing:.075em;text-transform:uppercase;color:#A8A29B}\n.jummark{font-size:9px;font-weight:700;line-height:11px;letter-spacing:.055em;text-transform:uppercase;color:#B45309}\n\ntr.today td{background:#F0F9F5;border-bottom-color:#DCEFE6}\ntr.today td.c-date{background:#F0F9F5;border-right-color:#DCEFE6}\ntr.today td.c-date::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:#0D5C3A}\ntr.today .daynum{color:#0D5C3A;font-weight:700}\ntr.today .daywd{color:#0D5C3A}\n\n.fade{position:absolute;top:0;right:0;bottom:0;width:58px;background:linear-gradient(to right,rgba(255,255,255,0) 0%,rgba(255,255,255,.42) 34%,rgba(255,255,255,.86) 72%,#FFFFFF 100%);pointer-events:none;z-index:7}\n.scrollhint{position:absolute;right:6px;top:50%;transform:translateY(-50%);z-index:8;width:25px;height:25px;border-radius:50%;background:#FFFFFF;border:1px solid #E2DDD5;color:#6B6560;display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:0 1px 5px rgba(16,24,20,.10);pointer-events:none}\n\n/* tab bar */\n.tabbar{flex:none;height:80px;display:flex;align-items:center;gap:2px;padding:0 10px 8px;background:#FFFFFF;border-top:1px solid #E8E4DE}\n.tab{flex:1;height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;border:0;background:transparent;border-radius:12px;color:#A8A29B;font-family:inherit;font-size:10px;font-weight:600;letter-spacing:.02em;cursor:pointer;transition:color .18s ease,transform .16s ease}\n.tab i{font-size:20px;line-height:1;display:inline-flex}\n.tab:active{transform:scale(.97)}\n.tab.on{color:#0D5C3A}\n.tab.on i{color:#0D5C3A}\n</style>\n<div class=\"phone\" data-kid=\"1\" data-name=\"phone app layout container\">\n<div class=\"statusbar\" data-kid=\"1-1\" data-name=\"status bar\">\n<span class=\"status-time tn\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">12:58</span>\n<span class=\"status-icons\" data-kid=\"1-1-2\" data-name=\"status bar icons container\"><i class=\"icon-signal\" data-kid=\"1-1-2-1\" data-name=\"signal strength icon\"></i><i class=\"icon-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi connection icon\"></i><i class=\"icon-battery-full\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i></span>\n</div>\n<header class=\"masthead\" data-kid=\"1-2\" data-name=\"masthead header\">\n<div data-kid=\"1-2-1\" data-name=\"title block container\">\n<h1 class=\"m-title\" data-kid=\"1-2-1-1\" data-name=\"app title heading\">Timetable</h1>\n<div class=\"m-sub\" data-kid=\"1-2-1-2\" data-name=\"mosque name subtitle\">Masjidul Ihsaan</div>\n</div>\n<div aria-label=\"Language\" class=\"lang\" data-kid=\"1-2-2\" data-name=\"language switcher tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"on\" data-kid=\"1-2-2-1\" data-name=\"English language tab button\" role=\"tab\">EN</button>\n<button aria-selected=\"false\" class=\"ta\" data-kid=\"1-2-2-2\" data-name=\"Tamil language tab button\" role=\"tab\">தமிழ்</button>\n</div>\n</header>\n<div class=\"controls\" data-kid=\"1-3\" data-name=\"controls section\">\n<div class=\"monthrow\" data-kid=\"1-3-1\" data-name=\"month navigation row\">\n<div class=\"monthcard\" data-kid=\"1-3-1-1\" data-name=\"month picker card\">\n<span class=\"cal\" data-kid=\"1-3-1-1-1\" data-name=\"calendar icon wrapper\"><i class=\"icon-calendar\" data-kid=\"1-3-1-1-1-1\" data-name=\"calendar icon\"></i></span>\n<span class=\"monthlabel\" data-kid=\"1-3-1-1-2\" data-name=\"selected month label\">November 2026</span>\n<button aria-label=\"Previous month\" class=\"iconbtn\" data-kid=\"1-3-1-1-3\" data-name=\"previous month button\"><i class=\"icon-chevron-left\" data-kid=\"1-3-1-1-3-1\" data-name=\"left chevron icon\"></i></button>\n<button aria-label=\"Next month\" class=\"iconbtn\" data-kid=\"1-3-1-1-4\" data-name=\"next month button\"><i class=\"icon-chevron-right\" data-kid=\"1-3-1-1-4-1\" data-name=\"right chevron icon\"></i></button>\n</div>\n<button class=\"today-btn\" data-kid=\"1-3-1-2\" data-name=\"jump to today button\">Today</button>\n</div>\n<div aria-label=\"Time shown in table\" class=\"seg\" data-kid=\"1-3-2\" data-name=\"prayer time type segmented control\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"on\" data-kid=\"1-3-2-1\" data-name=\"Iqamah time type tab\" role=\"tab\">Iqamah</button>\n<button aria-selected=\"false\" data-kid=\"1-3-2-2\" data-name=\"Azan time type tab\" role=\"tab\">Azan</button>\n</div>\n<div class=\"caption\" data-kid=\"1-3-3\" data-name=\"table caption text\">Iqamah times · 1–30 November</div>\n</div>\n<section aria-label=\"November 2026 prayer times\" class=\"tablecard\" data-kid=\"1-4\" data-name=\"timetable card section\">\n<div class=\"hscroll\" data-kid=\"1-4-1\" data-name=\"horizontally scrolling table container\">\n<table data-kid=\"1-4-1-1\" data-name=\"prayer times table\">\n<colgroup data-kid=\"1-4-1-1-1\" data-name=\"table column group\">\n<col data-kid=\"1-4-1-1-1-1\" data-name=\"date column\" style=\"width:76px\"/>\n<col data-kid=\"1-4-1-1-1-2\" data-name=\"Fajr column\" style=\"width:80px\"/>\n<col data-kid=\"1-4-1-1-1-3\" data-name=\"Jumu'ah/Dhuhr column\" style=\"width:80px\"/>\n<col data-kid=\"1-4-1-1-1-4\" data-name=\"Asr column\" style=\"width:80px\"/>\n<col data-kid=\"1-4-1-1-1-5\" data-name=\"Maghrib column\" style=\"width:80px\"/>\n<col data-kid=\"1-4-1-1-1-6\" data-name=\"Isha column\" style=\"width:80px\"/>\n</colgroup>\n<thead data-kid=\"1-4-1-1-2\" data-name=\"table header\">\n<tr data-kid=\"1-4-1-1-2-1\" data-name=\"header row\">\n<th class=\"c-date\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"date column header\">Date</th>\n<th data-kid=\"1-4-1-1-2-1-2\" data-name=\"Fajr column header\">Fajr</th>\n<th data-kid=\"1-4-1-1-2-1-3\" data-name=\"Jumu'ah Dhuhr column header\"><span class=\"stack\" data-kid=\"1-4-1-1-2-1-3-1\" data-name=\"stacked header label wrapper\"><span class=\"a\" data-kid=\"1-4-1-1-2-1-3-1-1\" data-name=\"Jumu'ah top label\">Jum</span><span class=\"b\" data-kid=\"1-4-1-1-2-1-3-1-2\" data-name=\"Dhuhr bottom label\">Dhuhr</span></span></th>\n<th data-kid=\"1-4-1-1-2-1-4\" data-name=\"Asr column header\">Asr</th>\n<th data-kid=\"1-4-1-1-2-1-5\" data-name=\"Maghrib column header\">Maghrib</th>\n<th data-kid=\"1-4-1-1-2-1-6\" data-name=\"Isha column header\">Isha</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-4-1-1-3\" data-name=\"table body\">\n<tr data-