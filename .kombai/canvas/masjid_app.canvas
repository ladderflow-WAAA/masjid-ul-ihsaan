      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;700&display=swap');\n\n:root{\n  --ink:#0A1F17; --ink-br:#122E22;\n  --green:#0D5C3A; --green-h:#094229; --accent:#047857; --tint:#F0F9F5;\n  --gold:#F59E0B; --gold-ink:#B45309; --gold-tint:#FFFDF5;\n  --bg:#F7F6F2; --surface:#FFFFFF; --border:#E6E2DB; --hair:#EFECE7;\n  --text:#18181B; --sec:#6B6560; --ter:#9C9590;\n  --danger:#DC2626; --danger-bg:#FEF2F2;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{\n  background:var(--bg);\n  font-family:'Inter','Noto Sans Tamil',system-ui,-apple-system,sans-serif;\n  color:var(--text);\n  -webkit-font-smoothing:antialiased;\n  min-width:1440px;\n}\n.wrap{width:1440px;margin:0 auto}\n\n/* ── top nav ───────────────────────────────────────────── */\n.nav{\n  height:64px;background:var(--ink);border-bottom:1px solid var(--ink-br);\n  display:flex;align-items:center;gap:36px;padding:0 24px;\n}\n.brand{display:flex;align-items:center;gap:10px;flex:0 0 auto}\n.mark{width:22px;height:24px;flex:0 0 auto}\n.brand-name{font-size:15px;font-weight:600;color:#F7F6F2;letter-spacing:-0.01em;white-space:nowrap}\n.links{display:flex;align-items:center;gap:2px;margin-left:8px}\n.nlink{\n  height:32px;padding:0 12px;display:inline-flex;align-items:center;\n  border-radius:8px;font-size:13px;font-weight:500;color:#9DBFAF;\n  text-decoration:none;transition:background 200ms cubic-bezier(.22,1,.36,1),color 200ms;\n}\n.lnk:hover{color:#fff;background:rgba(255,255,255,.06)}\n.nav-active{color:#FFFFFF;background:#14302A;font-weight:600}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:18px}\n.navlink{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#9DBFAF;text-decoration:none}\n.nav-signout{\n  height:32px;padding:0 14px;display:inline-flex;align-items:center;\n  border:1px solid rgba(255,255,255,.16);border-radius:10px;\n  font-size:13px;font-weight:500;color:#E6EDE9;background:transparent;\n}\n.svg{width:15px;height:15px;flex:none;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n\n/* ── page head ─────────────────────────────────────────── */\n.page{padding:24px 24px 28px}\n.title-row{display:flex;align-items:flex-end;justify-content:space-between;height:64px}\nh1{margin:0;font-size:28px;font-weight:600;letter-spacing:-.02em;line-height:1.1}\n.sub{margin:6px 0 0;font-size:14px;color:var(--sec)}\n.viewlink{\n  display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:500;\n  color:var(--sec);text-decoration:none;padding-bottom:4px;\n}\n.toolbar{margin-top:16px}\n\n/* ── save bar ──────────────────────────────────────────── */\n.savebar{\n  height:56px;background:var(--surface);border:1px solid var(--border);border-radius:12px;\n  display:flex;align-items:center;justify-content:space-between;padding:0 16px;\n  box-shadow:0 1px 2px rgba(24,24,27,.04);\n}\n.sb-left,.right{display:flex;align-items:center}\n.monthpill{\n  display:flex;align-items:center;background:var(--hair);border:1px solid var(--border);\n  border-radius:999px;padding:3px;height:34px;\n}\n.mbtn{\n  width:26px;height:26px;display:flex;align-items:center;justify-content:center;\n  border:0;background:transparent;color:var(--text);border-radius:50%;cursor:pointer;\n  transition:background .2s cubic-bezier(.22,1,.36,1);\n}\n.mbtn:hover{background:#fff}\n.month{font-size:13px;font-weight:600;min-width:116px;text-align:center;padding:0 8px}\n.today-btn{\n  background:none;border:0;margin-left:14px;font-size:13px;font-weight:600;\n  color:var(--green);padding:8px 6px;cursor:pointer;font-family:inherit;\n}\n.vdiv{width:1px;height:20px;background:var(--border);margin:0 18px}\n.dirty{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500;color:var(--gold-ink)}\n.dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex:none}\n\n.ibtn{\n  height:36px;display:inline-flex;align-items:center;gap:7px;padding:0 13px;\n  border:1px solid var(--border);background:var(--surface);color:var(--text);\n  font-family:inherit;font-size:13px;font-weight:500;border-radius:10px;cursor:pointer;\n  transition:background .2s cubic-bezier(.22,1,.36,1),border-color .2s,color .2s;\n}\n.ibtn:hover{background:var(--bg);border-color:#D8D3CA}\n.ibtn .svg{color:var(--sec)}\n.right .ibtn{margin-left:8px}\n.primary{\n  background:var(--green);border-color:var(--green);color:#fff;font-weight:600;\n  box-shadow:0 1px 2px rgba(13,92,58,.22);\n}\n.primary:hover{background:var(--green-h);border-color:var(--green-h)}\n.primary .svg{color:#fff}\n\n/* ── grid panel ────────────────────────────────────────── */\n.panel{\n  margin-top:16px;background:var(--surface);border:1px solid var(--border);\n  border-radius:14px;overflow:hidden;box-shadow:0 1px 3px rgba(24,24,27,.05);\n}\n.scroll{height:596px;overflow-y:auto;overflow-x:hidden}\n.scroll::-webkit-scrollbar{width:10px}\n.scroll::-webkit-scrollbar-thumb{background:#DAD5CC;border-radius:8px;border:3px solid #fff}\ntable{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;font-variant-numeric:tabular-nums}\n\nthead th{\n  position:sticky;background:var(--hair);z-index:3;\n  font-weight:600;letter-spacing:.06em;text-transform:uppercase;\n  border-bottom:1px solid var(--border);\n}\nthead tr:first-child th{top:0;height:28px}\nthead tr:nth-child(2) th{top:28px;height:28px;background:#F4F1EC}\n.g1{font-size:11px;color:var(--text)}\n.g2{font-size:10px;font-weight:500;color:var(--sec);border-bottom:1px solid var(--border)}\nth.dc,td.dc{position:sticky;left:0;width:96px}\nthead th.dc{background:var(--hair);z-index:5;text-align:left;padding-left:18px;font-size:11px;color:var(--text)}\nthead th.lefty{text-align:left;padding-left:12px}\n.gstart{border-left:1px solid #DCD7CE}\n\ntbody td{\n  height:36px;font-size:13px;border-bottom:1px solid var(--hair);\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\ntd.dc{background:var(--surface);z-index:2;padding-left:18px;border-right:1px solid var(--hair)}\n.dcell{display:flex;align-items:baseline;gap:7px}\n.dnum{font-size:13px;font-weight:600;letter-spacing:-.01em}\n.dow{font-size:10px;font-weight:600;letter-spacing:.08em;color:var(--ter);text-transform:uppercase}\n.dow-today{color:var(--green)}\n.dow-fri{color:var(--gold-ink)}\n\n.c{text-align:right;padding-right:12px}\n.az{color:var(--sec)}\n.iq{color:var(--text);font-weight:600}\n.sun{color:var(--ter);text-align:right;padding-right:12px}\n.jum{color:var(--gold-ink);font-weight:600;text-align:right;padding-right:12px}\n.dash{text-align:right;padding-right:12px;color:#CFC9BF}\n\ntr.row{background:var(--surface);animation:rin .34s cubic-bezier(.22,1,.36,1) both}\ntr.row.fri{background:#FCFBF7}\ntr.row.today{background:var(--tint)}\ntr.row.today td.dc{background:var(--tint)}\ntr.row.fri td.dc{background:#FCFBF7}\ntr.row.today td.dc{box-shadow:inset 2px 0 0 var(--green)}\ntr.row.fri:hover,tr.row.today:hover{background:inherit}\n@keyframes rin{from{opacity:0}to{opacity:1}}\n\n/* dirty + invalid cells */\ntd.dirty{position:relative;color:var(--gold-ink);font-weight:600;background:var(--gold-tint)}\ntd.dirty::after{\n  content:\"\";position:absolute;top:0;right:0;width:0;height:0;\n  border-top:7px solid var(--gold);border-left:7px solid transparent;\n}\ntd.invalid{position:relative;color:var(--danger);font-weight:600;background:var(--danger-bg);box-shadow:inset 0 0 0 1px #F5B5B5}\ntd.invalid::after{\n  content:\"\";position:absolute;top:0;right:0;width:0;height:0;\n  border-top:7px solid var(--gold);border-left:7px solid transparent;\n}\n.marker{position:absolute;left:5px;top:11px;width:12px;height:12px;color:var(--danger)}\n\n/* ── grid footer ───────────────────────────────────────── */\n.gfoot{\n  height:44px;display:flex;align-items:center;justify-content:space-between;\n  padding:0 18px;border-top:1px solid var(--border);background:var(--surface);\n}\n.errline{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500;color:var(--danger)}\n.gcount{font-size:12px;color:var(--ter);font-variant-numeric:tabular-nums}\n</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"page layout container\">\n<nav class=\"nav\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n<svg aria-hidden=\"true\" class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"crescent lantern brand mark icon\" fill=\"none\" viewbox=\"0 0 22 24\">\n<path d=\"M11 1.6c2.6 2 4.2 4.6 4.2 7.7 0 2.1-1 3.9-2.6 5.1V9.6a1.6 1.6 0 0 0-3.2 0v4.8C7.8 13.2 6.8 11.4 6.8 9.3c0-3.1 1.6-5.7 4.2-7.7Z\" fill=\"#F59E0B\"></path>\n<path d=\"M4 20.5h14\" stroke=\"#A7D5C4\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path>\n<path d=\"M2.5 23.4h17\" stroke=\"#A7D5C4\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path>\n<path d=\"M11 15.5v5\" stroke=\"#F59E0B\" stroke-linecap=\"round\" stroke-width=\"1.4\"></path>\n</svg>\n<span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Masjidul Ihsaan</span>\n</div>\n<div class=\"links\" data-kid=\"1-1-2\" data-name=\"site navigation links\">\n<a class=\"nlink lnk\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"#\">Dashboard</a>\n<a class=\"nlink lnk nav-active\" data-kid=\"1-1-2-2\" data-name=\"timetable nav link (active)\" href=\"#\">Timetable</a>\n<a class=\"nlink lnk\" data-kid=\"1-1-2-3\" data-name=\"announcements nav link\" href=\"#\">Announcements</a>\n<a class=\"nlink lnk\" data-kid=\"1-1-2-4\" data-name=\"settings nav link\" href=\"#\">Settings</a>\n</div>\n<div class=\"nav-right\" data-kid=\"1-1-3\" data-name=\"right-side nav actions\">\n<a class=\"navlink\" data-kid=\"1-1-3-1\" data-name=\"view public site link\" href=\"#\">\n        View public site\n        <svg class=\"svg\" data-kid=\"1-1-3-1-1\" data-name=\"external link icon\" viewbox=\"0 0 24 24\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg>\n</a>\n<button class=\"nav-signout\" data-kid=\"1-1-3-2\" data-name=\"sign out button\" type=\"button\">Sign out</button>\n</div>\n</nav>\n<div class=\"page\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n<div class=\"title-row\" data-kid=\"1-2-1\" data-name=\"page title row\">\n<div data-kid=\"1-2-1-1\" data-name=\"page heading group\">\n<h1 data-kid=\"1-2-1-1-1\" data-name='page headline \"Timetable\"'>Timetable</h1>\n<p class=\"sub\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle month text\">November 2026</p>\n</div>\n<a class=\"viewlink\" data-kid=\"1-2-1-2\" data-name=\"open public timetable link\" href=\"#\">\n        Open public timetable\n        <svg class=\"svg\" data-kid=\"1-2-1-2-1\" data-name=\"external link icon\" viewbox=\"0 0 24 24\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg>\n</a>\n</div>\n<div class=\"toolbar\" data-kid=\"1-2-2\" data-name=\"toolbar area\">\n<div class=\"savebar\" data-kid=\"1-2-2-1\" data-name=\"save bar container\">\n<div class=\"sb-left\" data-kid=\"1-2-2-1-1\" data-name=\"save bar left actions\">\n<div class=\"monthpill\" data-kid=\"1-2-2-1-1-1\" data-name=\"month selector pill\">\n<button aria-label=\"Previous month\" class=\"mbtn\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"previous month button\" type=\"button\">\n<svg class=\"svg\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"left chevron icon\" style=\"width:15px;height:15px\" viewbox=\"0 0 24 24\"><path d=\"m15 18-6-6 6-6\"></path></svg>\n</button>\n<span class=\"month\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"current month label\" data-reason=\"label reinitialized by month navigation script\">November 2026</span>\n<button aria-label=\"Next month\" class=\"mbtn\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"next month button\" type=\"button\">\n<svg class=\"svg\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"right chevron icon\" style=\"width:15px;height:15px\" viewbox=\"0 0 24 24\"><path d=\"m9 18 6-6-6-6\"></path></svg>\n</button>\n</div>\n<button class=\"today-btn\" data-kid=\"1-2-2-1-1-2\" data-name=\"today button\" type=\"button\">Today</button>\n<span class=\"vdiv\" data-kid=\"1-2-2-1-1-3\" data-name=\"vertical divider\"></span>\n<span class=\"dirty\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-4\" data-name=\"unsaved changes indicator\" data-reason=\"change count text driven by script state\"><span class=\"dot\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"unsaved changes dot\"></span>2 unsaved changes</span>\n</div>\n<div class=\"right\" data-kid=\"1-2-2-1-2\" data-name=\"save bar right actions\">\n<button class=\"ibtn\" data-kid=\"1-2-2-1-2-1\" data-name=\"apply to range button\" type=\"button\">\n<svg class=\"svg\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"filter/sliders icon\" viewbox=\"0 0 24 24\"><line x1=\"21\" x2=\"14\" y1=\"4\" y2=\"4\"></line><line x1=\"10\" x2=\"3\" y1=\"4\" y2=\"4\"></line><line x1=\"21\" x2=\"12\" y1=\"12\" y2=\"12\"></line><line x1=\"8\" x2=\"3\" y1=\"12\" y2=\"12\"></line><line x1=\"21\" x2=\"16\" y1=\"20\" y2=\"20\"></line><line x1=\"12\" x2=\"3\" y1=\"20\" y2=\"20\"></line><line x1=\"14\" x2=\"14\" y1=\"2\" y2=\"6\"></line><line x1=\"8\" x2=\"8\" y1=\"10\" y2=\"14\"></line><line x1=\"16\" x2=\"16\" y1=\"18\" y2=\"22\"></line></svg>\n            Apply to range\n          </button>\n<button class=\"ibtn\" data-kid=\"1-2-2-1-2-2\" data-name=\"export CSV button\" type=\"button\">\n<svg class=\"svg\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"download icon\" viewbox=\"0 0 24 24\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg>\n            Export CSV\n          </button>\n<button class=\"ibtn primary\" data-kid=\"1-2-2-1-2-3\" data-name=\"save &amp; publish primary button\" type=\"button\">\n<svg class=\"svg\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"save file icon\" viewbox=\"0 0 24 24\"><path d=\"M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z\"></path><path d=\"M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7\"></path><path d=\"M7 3v4a1 1 0 0 0 1 1h7\"></path></svg>\n            Save &amp; Publish\n          </button>\n</div>\n</div>\n</div>\n<div class=\"panel\" data-kid=\"1-2-3\" data-name=\"timetable data panel\">\n<div class=\"scroll\" data-kid=\"1-2-3-1\" data-name=\"scrollable table region\">\n<table data-kid=\"1-2-3-1-1\" data-name=\"timetable data table\">\n<colgroup data-kid=\"1-2-3-1-1-1\" data-name=\"table column group\">\n<col data-kid=\"1-2-3-1-1-1-1\" data-name=\"date column definition\" style=\"width:96px\"/>\n<col data-kid=\"1-2-3-1-1-1-2\" data-name=\"Fajr Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-3\" data-name=\"Fajr Iqamah column definition\" style=\"width:90px\"/>\n<col data-kid=\"1-2-3-1-1-1-4\" data-name=\"sunrise column definition\" style=\"width:92px\"/>\n<col data-kid=\"1-2-3-1-1-1-5\" data-name=\"Dhuhr Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-6\" data-name=\"Dhuhr Iqamah column definition\" style=\"width:90px\"/>\n<col data-kid=\"1-2-3-1-1-1-7\" data-name=\"Asr Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-8\" data-name=\"Asr Iqamah column definition\" style=\"width:90px\"/>\n<col data-kid=\"1-2-3-1-1-1-9\" data-name=\"Maghrib Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-10\" data-name=\"Maghrib Iqamah column definition\" style=\"width:90px\"/>\n<col data-kid=\"1-2-3-1-1-1-11\" data-name=\"Isha Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-12\" data-name=\"Isha Iqamah column definition\" style=\"width:90px\"/>\n<col data-kid=\"1-2-3-1-1-1-13\" data-name=\"Jumu'ah Azan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-14\" data-name=\"Jumu'ah Bayan column definition\" style=\"width:90px\"/><col data-kid=\"1-2-3-1-1-1-15\" data-name=\"Jumu'ah Iqamah column definition\" style=\"width:90px\"/>\n</colgroup>\n<thead data-kid=\"1-2-3-1-1-2\" data-name=\"table header\">\n<tr data-kid=\"1-2-3-1-1-2-1\" data-name=\"primary header row\">\n<th class=\"dc\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"date column header\" rowspan=\"2\">Date</th>\n<th class=\"g1 gstart\" colspan=\"2\" data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"Fajr group header\">Fajr</th>\n<th class=\"g1 gstart lefty\" data-kid=\"1-2-3-1-1-2-1-3\" data-name=\"sunrise column header\" rowspan=\"2\">Sunrise</th>\n<th class=\"g1 gstart\" colspan=\"2\" data-kid=\"1-2-3-1-1-2-1-4\" data-name=\"Dhuhr group header\">Dhuhr</th>\n<th class=\"g1 gstart\" colspan=\"2\" data-kid=\"1-2-3-1-1-2-1-5\" data-name=\"Asr group header\">Asr</th>\n<th class=\"g1 gstart\" colspan=\"2\" data-kid=\"1-2-3-1-1-2-1-6\" data-name=\"Maghrib group header\">Maghrib</th>\n<th class=\"g1 gstart\" colspan=\"2\" data-kid=\"1-2-3-1-1-2-1-7\" data-name=\"Isha group header\">Isha</th>\n<th class=\"g1 gstart\" colspan=\"3\" data-kid=\"1-2-3-1-1-2-1-8\" data-name=\"Jumu'ah group header\">Jumu’ah</th>\n</tr>\n<tr data-kid=\"1-2-3-1-1-2-2\" data-name=\"sub header row\">\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"Fajr Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"Fajr Iqamah subheader\">Iqamah</th>\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-3\" data-name=\"Dhuhr Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-4\" data-name=\"Dhuhr Iqamah subheader\">Iqamah</th>\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-5\" data-name=\"Asr Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-6\" data-name=\"Asr Iqamah subheader\">Iqamah</th>\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-7\" data-name=\"Maghrib Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-8\" data-name=\"Maghrib Iqamah subheader\">Iqamah</th>\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-9\" data-name=\"Isha Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-10\" data-name=\"Isha Iqamah subheader\">Iqamah</th>\n<th class=\"g2 gstart\" data-kid=\"1-2-3-1-1-2-2-11\" data-name=\"Jumu'ah Azan subheader\">Azan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-12\" data-name=\"Jumu'ah Bayan subheader\">Bayan</th><th class=\"g2\" data-kid=\"1-2-3-1-1-2-2-13\" data-name=\"Jumu'ah Iqamah subheader\">Iqamah</th>\n</tr>\n</thead>\n<tbody data-dynamic=\"true\" data-kid=\"1-2-3-1-1-3\" data-name=\"table body with daily schedule rows\" data-reason=\"rows injected by script building 30 day rows on load\" id=\"rows\"></tbody>\n</table>\n</div>\n<div class=\"gfoot\" data-kid=\"1-2-3-2\" data-name=\"table footer bar\">\n<span class=\"errline\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1\" data-name=\"error message line\" data-reason=\"validation message text generated by script\">\n<svg class=\"svg\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-1\" data-name=\"warning triangle icon\" data-reason=\"icon injected by script\" style=\"width:14px;height:14px\" viewbox=\"0 0 24 24\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg>\n          14 Nov — Asr Azan is after Iqamah\n        </span>\n<span class=\"gcount\" data-kid=\"1-2-3-2-2\" data-name=\"date count display\">30 dates</span>\n</div>\n</div>\n</div>\n</div>\n<script>\n(function(){\n  var WB = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\n  var tbody = document.getElementById('rows');\n  var html = '';\n\n  var warnSvg = '<svg class=\"marker\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>';\n\n  function td(v, cls, extra, invalid){\n    var klass = 'c ' + cls + (extra ? ' ' + extra : '');\n    return '<td class=\"' + klass + '\" style=\"position:relative\">' +\n      (invalid ? warnSvg : '') + v + '</td>';\n  }\n\n  for (var d = 1; d <= 30; d++) {\n    var wd = WB[(d - 1) % 7];\n    var isFri = wd === 'Fri';\n    var isToday = d === 6;\n\n    var fajrAz = '5:00 AM';\n    var fajrIq = (d <= 15) ? '5:30 AM' : '5:20 AM';\n    var asrAz  = '3:45 PM';\n    var asrIq  = (d <= 20) ? '4:15 PM' : '4:10 PM';\n    var maghIq = (d <= 15) ? '6:10 PM' : '6:05 PM';\n\n    // unsaved edits\n    var dirtyFajrIq = (d === 21);\n    var dirtyAsrAz  = (d === 14);\n    if (dirtyFajrIq) fajrIq = '5:25 AM';\n    if (dirtyAsrAz)  asrAz  = '4:20 PM';\n\n    // azan may not be after iqamah\n    var invalidAsr = dirtyAsrAz;\n\n    var cls = 'row' + (isFri ? ' fri' : '') + (isToday ? ' today' : '');\n    var dowCls = 'dow' + (isToday ? ' dow-today' : (isFri ? ' dow-fri' : ''));\n    var dowLabel = isToday ? 'Today' : (isFri ? 'Jum' : wd);\n\n    html += '<tr class=\"' + cls + '\" style=\"animation-delay:' + Math.min(d * 12, 240) + 'ms\">';\n    html += '<td class=\"dc\"><span class=\"dcell\"><span class=\"dnum\">' + ('0' + d).slice(-2) + '</span><span class=\"' + dowCls + '\">' + dowLabel + '</span></span></td>';\n\n    html += td(fajrAz, 'az', 'gstart');\n    html += td(fajrIq, 'iq', dirtyFajrIq ? 'dirty' : '');\n    html += '<td class=\"sun gstart\">6:01 AM</td>';\n    html += td('12:15 PM', 'az', 'gstart');\n    html += td('12:45 PM', 'iq');\n    html += td(asrAz, 'az', 'gstart' + (invalidAsr ? ' invalid' : ''), invalidAsr);\n    html += td(asrIq, 'iq');\n    html += td('6:00 PM', 'az', 'gstart');\n    html += td(maghIq, 'iq');\n    html += td('7:30 PM', 'az', 'gstart');\n    html += td('8:15 PM', 'iq');\n\n    if (isFri) {\n      html += '<td class=\"jum gstart\">12:30 PM</td>';\n      html += '<td class=\"jum\">12:45 PM</td>';\n      html += '<td class=\"jum\">1:15 PM</td>';\n    } else {\n      html += '<td class=\"dash gstart\">&mdash;</td>';\n      html += '<td class=\"dash\">&mdash;</td>';\n      html += '<td class=\"dash\">&mdash;</td>';\n    }\n\n    html += '</tr>';\n  }\n\n  tbody.innerHTML = html;\n})();\n</script>\n",
      "comments": [],
      "created": "2026-11-06T14:24:03.424635+00:00",
      "modified": "2026-11-06T14:25:27.573076+00:00",
