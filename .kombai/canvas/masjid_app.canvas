    },
    "var_55c892df4273": {
      "type": "variant",
      "label": "Settings — Reminders & notifications",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1470,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600&family=Noto+Naskh+Arabic:wght@500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  :root{\n    --bg:#F5F3EF;\n    --surface:#FFFFFF;\n    --border:#E8E4DE;\n    --hair:#EFECE7;\n    --text:#18181B;\n    --sec:#6B6560;\n    --ter:#9C9590;\n    --ink:#0A1F17;\n    --green:#0D5C3A;\n    --accent:#047857;\n  }\n\n  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }\n\n  html,body{ margin:0; padding:0; background:#F5F3EF; }\n\n  body{\n    background:var(--bg);\n    font-family:'Inter','Noto Sans Tamil',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n    color:var(--text);\n    -webkit-font-smoothing:antialiased;\n    -moz-osx-font-smoothing:grayscale;\n  }\n\n  .tabular{ font-variant-numeric:tabular-nums; }\n\n  .phone{\n    width:390px;\n    height:844px;\n    margin:0 auto;\n    background:var(--bg);\n    display:flex;\n    flex-direction:column;\n    overflow:hidden;\n    position:relative;\n  }\n\n  /* ---------- masthead ---------- */\n  .masthead{\n    flex:0 0 auto;\n    padding:13px 16px 10px;\n    display:flex;\n    align-items:flex-start;\n    justify-content:space-between;\n    gap:12px;\n  }\n  .masthead h1{\n    margin:0;\n    font-size:27px;\n    line-height:32px;\n    font-weight:700;\n    letter-spacing:-0.7px;\n    color:var(--text);\n  }\n  .masthead .who{\n    margin:2px 0 0;\n    font-size:12.5px;\n    line-height:16px;\n    font-weight:400;\n    color:var(--ter);\n    letter-spacing:.1px;\n  }\n\n  /* ---------- segmented control ---------- */\n  .seg{\n    display:inline-flex;\n    align-items:center;\n    gap:2px;\n    padding:2px;\n    background:#F1EEE9;\n    border-radius:9px;\n    flex:0 0 auto;\n  }\n  .seg button{\n    appearance:none;\n    border:0;\n    background:transparent;\n    height:26px;\n    padding:0 11px;\n    border-radius:7px;\n    font-family:inherit;\n    font-size:12px;\n    font-weight:500;\n    color:var(--sec);\n    cursor:pointer;\n    white-space:nowrap;\n    transition:background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;\n    line-height:1;\n  }\n  .seg button.on{\n    background:var(--ink);\n    color:#FFFFFF;\n    font-weight:600;\n    box-shadow:0 1px 2px rgba(10,31,23,.22);\n  }\n  .seg.sm{ padding:2px; border-radius:8px; }\n  .seg.sm button{ height:23px; padding:0 9px; font-size:11.5px; border-radius:6px; }\n  .seg.full{ display:flex; width:100%; }\n  .seg.full button{ flex:1 1 0; padding:0 6px; font-size:12px; }\n\n  /* ---------- scroll region ---------- */\n  .scroll{\n    flex:1 1 auto;\n    overflow-y:auto;\n    overflow-x:hidden;\n    overscroll-behavior:contain;\n    padding:0 16px 20px;\n    scrollbar-width:none;\n    -ms-overflow-style:none;\n  }\n  .scroll::-webkit-scrollbar{ width:0; height:0; }\n\n  .fade{\n    position:absolute;\n    left:0;\n    right:0;\n    bottom:80px;\n    height:30px;\n    background:linear-gradient(to bottom, rgba(245,243,239,0) 0%, rgba(245,243,239,.86) 62%, #F5F3EF 100%);\n    pointer-events:none;\n  }\n\n  /* ---------- section ---------- */\n  .sect{ margin-top:11px; }\n  .sect:first-child{ margin-top:0; }\n\n  .sect-head{\n    display:flex;\n    align-items:baseline;\n    justify-content:space-between;\n    gap:10px;\n    padding:0 2px 7px;\n  }\n  .sect-head h2{\n    margin:0;\n    font-size:13px;\n    line-height:16px;\n    font-weight:600;\n    color:var(--sec);\n    letter-spacing:.1px;\n  }\n  .sect-head .meta{\n    font-size:12px;\n    line-height:16px;\n    font-weight:500;\n    color:var(--ter);\n    white-space:nowrap;\n  }\n\n  .card{\n    background:var(--surface);\n    border:1px solid var(--border);\n    border-radius:16px;\n    overflow:hidden;\n    box-shadow:0 1px 2px rgba(16,24,20,.03);\n  }\n\n  /* ---------- rows ---------- */\n  .row{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:12px;\n    min-height:45px;\n    padding:0 16px;\n  }\n  .row + .row{ border-top:1px solid var(--hair); }\n  .row .lab{\n    font-size:14.5px;\n    line-height:20px;\n    font-weight:500;\n    color:var(--text);\n    letter-spacing:-0.1px;\n  }\n  .row.tall{\n    align-items:center;\n    min-height:60px;\n    padding-top:10px;\n    padding-bottom:10px;\n  }\n\n  .press{ transition:transform 130ms cubic-bezier(.23,1,.32,1); cursor:pointer; }\n  .press:active{ transform:scale(.97); }\n\n  /* ---------- prayer rows ---------- */\n  .prow{ min-height:44px; }\n  .prow .left{ display:flex; align-items:baseline; gap:8px; min-width:0; }\n  .prow .pname{\n    font-size:14.5px;\n    line-height:20px;\n    font-weight:500;\n    letter-spacing:-0.1px;\n    color:var(--text);\n  }\n  .prow .ptime{\n    font-size:12.5px;\n    line-height:18px;\n    font-weight:400;\n    color:var(--ter);\n  }\n  .prow.off .pname{ color:#8E8881; }\n  .prow.off .ptime{ color:#BCB6AF; }\n\n  /* ---------- switch ---------- */\n  .sw{\n    position:relative;\n    flex:0 0 auto;\n    width:44px;\n    height:26px;\n    border-radius:13px;\n    background:#DAD5CE;\n    transition:background-color 180ms ease;\n  }\n  .sw::after{\n    content:'';\n    position:absolute;\n    top:3px;\n    left:3px;\n    width:20px;\n    height:20px;\n    border-radius:50%;\n    background:#FFFFFF;\n    box-shadow:0 1px 2px rgba(10,31,23,.28), 0 0 1px rgba(10,31,23,.18);\n    transition:transform 180ms cubic-bezier(.23,1,.32,1);\n  }\n  .sw.on{ background:var(--accent); }\n  .sw.on::after{ transform:translateX(18px); }\n\n  /* ---------- reminder timing ---------- */\n  .timing-row{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:12px;\n    min-height:45px;\n    padding:0 16px;\n    border-top:1px solid var(--hair);\n  }\n  .timing-row .val{\n    display:flex;\n    align-items:center;\n    gap:5px;\n    font-size:13px;\n    line-height:18px;\n    font-weight:500;\n    color:var(--green);\n    white-space:nowrap;\n  }\n  .timing-row .val i{ font-size:15px; color:var(--ter); }\n\n  .tgrid{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:8px;\n    padding:0 16px 12px;\n  }\n  .tgrid button{\n    appearance:none;\n    font-family:inherit;\n    height:36px;\n    border-radius:10px;\n    border:1px solid var(--border);\n    background:#FAF8F5;\n    font-size:13px;\n    font-weight:500;\n    color:#4E4842;\n    cursor:pointer;\n    letter-spacing:-0.1px;\n    transition:background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 130ms cubic-bezier(.23,1,.32,1);\n  }\n  .tgrid button:active{ transform:scale(.97); }\n  .tgrid button.on{\n    background:var(--ink);\n    border-color:var(--ink);\n    color:#FFFFFF;\n    font-weight:600;\n    box-shadow:0 1px 2px rgba(10,31,23,.2);\n  }\n\n  /* ---------- sound block ---------- */\n  .block{\n    padding:11px 16px 12px;\n    border-top:1px solid var(--hair);\n  }\n  .block .lab{\n    font-size:14.5px;\n    line-height:20px;\n    font-weight:500;\n    color:var(--text);\n    letter-spacing:-0.1px;\n    display:block;\n    margin-bottom:8px;\n  }\n\n  /* ---------- push / status ---------- */\n  .push-left{ min-width:0; }\n  .push-left .lab{ display:block; }\n  .push-sub{\n    display:block;\n    margin-top:2px;\n    font-size:12.5px;\n    line-height:16px;\n    font-weight:400;\n    color:var(--ter);\n  }\n\n  .flag{\n    display:inline-flex;\n    align-items:center;\n    gap:5px;\n    height:24px;\n    padding:0 9px 0 7px;\n    border-radius:999px;\n    background:#F0FDF4;\n    border:1px solid #BBF7D0;\n    color:#047857;\n    font-size:11.5px;\n    font-weight:600;\n    letter-spacing:.1px;\n    white-space:nowrap;\n  }\n  .flag i{ font-size:13px; }\n\n  /* ---------- info rows ---------- */\n  .irow{\n    display:flex;\n    align-items:center;\n    gap:11px;\n    padding:0 16px;\n    min-height:45px;\n  }\n  .irow + .irow{ border-top:1px solid var(--hair); }\n  .irow i.lead{ font-size:17px; color:var(--sec); flex:0 0 auto; }\n  .irow .txt{\n    flex:1 1 auto;\n    font-size:13.5px;\n    line-height:19px;\n    font-weight:400;\n    color:var(--text);\n    min-width:0;\n  }\n  .irow i.trail{ font-size:16px; color:#C7C1BA; flex:0 0 auto; }\n  .irow.action i.lead{ color:var(--accent); }\n  .irow.action .txt{ color:var(--accent); font-weight:600; }\n  .irow.action i.trail{ color:var(--accent); }\n  .irow .vval{ font-size:13px; color:var(--sec); font-weight:500; }\n\n  .addr{\n    display:flex;\n    align-items:flex-start;\n    gap:11px;\n    padding:12px 16px;\n  }\n  .addr i.lead{ font-size:17px; color:var(--sec); margin-top:1px; flex:0 0 auto; }\n  .addr p{\n    margin:0;\n    font-size:13.5px;\n    line-height:19px;\n    color:var(--sec);\n    font-weight:400;\n  }\n\n  /* ---------- footer ---------- */\n  .foot{\n    padding:20px 0 4px;\n    text-align:center;\n    font-size:11.5px;\n    line-height:16px;\n    color:var(--ter);\n    letter-spacing:.1px;\n  }\n\n  /* ---------- tab bar ---------- */\n  .tabbar{\n    flex:0 0 80px;\n    display:flex;\n    align-items:flex-start;\n    background:#FFFFFF;\n    border-top:1px solid var(--border);\n    padding-top:9px;\n  }\n  .tab{\n    flex:1 1 0;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    gap:4px;\n    padding:2px 0 0;\n    background:none;\n    border:0;\n    font-family:inherit;\n    cursor:pointer;\n    color:#9C9590;\n    transition:transform 130ms cubic-bezier(.23,1,.32,1);\n  }\n  .tab:active{ transform:scale(.94); }\n  .tab span{\n    font-size:10.5px;\n    line-height:13px;\n    font-weight:500;\n    letter-spacing:.1px;\n  }\n  .tab svg{ width:22px; height:22px; stroke:currentColor; stroke-width:1.75; fill:none; stroke-linecap:round; stroke-linejoin:round; }\n  .tab.on{ color:var(--accent); }\n  .tab.on span{ font-weight:600; }\n  .tab.on svg{ stroke-width:2.1; }\n</style>\n<div class=\"phone\" data-kid=\"1\" data-name=\"phone mobile app frame\">\n<div class=\"masthead\" data-kid=\"1-1\" data-name=\"settings screen masthead header\">\n<div data-kid=\"1-1-1\" data-name=\"masthead title block container\">\n<h1 data-kid=\"1-1-1-1\" data-name=\"settings page title heading\">Settings</h1>\n<p class=\"who\" data-kid=\"1-1-1-2\" data-name=\"masthead masjid name subtitle\">Masjidul Ihsaan</p>\n</div>\n<div aria-label=\"Language\" class=\"seg sm\" data-kid=\"1-1-2\" data-name=\"masthead language toggle group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"on\" data-kid=\"1-1-2-1\" data-name=\"English language toggle button\">EN</button>\n<button aria-pressed=\"false\" data-kid=\"1-1-2-2\" data-name=\"Tamil language toggle button\">தமிழ்</button>\n</div>\n</div>\n<div class=\"scroll\" data-kid=\"1-2\" data-name=\"scrollable settings content region\">\n<!-- Display -->\n<section class=\"sect\" data-kid=\"1-2-1\" data-name=\"display preferences section\">\n<div class=\"sect-head\" data-kid=\"1-2-1-1\" data-name=\"display section header row\"><h2 data-kid=\"1-2-1-1-1\" data-name=\"display section heading\">Display</h2></div>\n<div class=\"card\" data-kid=\"1-2-1-2\" data-name=\"display preferences card\">\n<div class=\"row\" data-kid=\"1-2-1-2-1\" data-name=\"language setting row\">\n<span class=\"lab\" data-kid=\"1-2-1-2-1-1\" data-name=\"language setting label\">Language</span>\n<div aria-label=\"Language\" class=\"seg\" data-kid=\"1-2-1-2-1-2\" data-name=\"language preference toggle group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"on\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"English option button\">English</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"Tamil option button\">தமிழ்</button>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-2-1-2-2\" data-name=\"time format setting row\">\n<span class=\"lab\" data-kid=\"1-2-1-2-2-1\" data-name=\"time format setting label\">Time Format</span>\n<div aria-label=\"Time format\" class=\"seg\" data-kid=\"1-2-1-2-2-2\" data-name=\"time format toggle group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"on\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"12-hour format option button\">12-Hour</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"24-hour format option button\">24-Hour</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Prayer reminders -->\n<section class=\"sect\" data-kid=\"1-2-2\" data-name=\"prayer reminders section\">\n<div class=\"sect-head\" data-kid=\"1-2-2-1\" data-name=\"prayer reminders section header\">\n<h2 data-kid=\"1-2-2-1-1\" data-name=\"prayer reminders heading\">Prayer Reminders</h2>\n<span class=\"meta\" data-kid=\"1-2-2-1-2\" data-name=\"prayer reminder status count meta text\">4 of 5 on</span>\n</div>\n<div class=\"card\" data-kid=\"1-2-2-2\" data-name=\"prayer reminders card\">\n<div class=\"row prow off\" data-kid=\"1-2-2-2-1\" data-name=\"Fajr reminder row (off)\">\n<div class=\"left\" data-kid=\"1-2-2-2-1-1\" data-name=\"Fajr name and time group\"><span class=\"pname\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"Fajr prayer name\">Fajr</span><span class=\"ptime tabular\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"Fajr prayer time\">5:30 AM</span></div>\n<div aria-checked=\"false\" aria-label=\"Fajr reminder\" class=\"sw\" data-kid=\"1-2-2-2-1-2\" data-name=\"Fajr reminder toggle switch\" role=\"switch\"></div>\n</div>\n<div class=\"row prow\" data-kid=\"1-2-2-2-2\" data-name=\"Dhuhr reminder row\">\n<div class=\"left\" data-kid=\"1-2-2-2-2-1\" data-name=\"Dhuhr name and time group\"><span class=\"pname\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"Dhuhr prayer name\">Dhuhr</span><span class=\"ptime tabular\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"Dhuhr prayer time\">12:45 PM</span></div>\n<div aria-checked=\"true\" aria-label=\"Dhuhr reminder\" class=\"sw on\" data-kid=\"1-2-2-2-2-2\" data-name=\"Dhuhr reminder toggle switch\" role=\"switch\"></div>\n</div>\n<div class=\"row prow\" data-kid=\"1-2-2-2-3\" data-name=\"Asr reminder row\">\n<div class=\"left\" data-kid=\"1-2-2-2-3-1\" data-name=\"Asr name and time group\"><span class=\"pname\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"Asr prayer name\">Asr</span><span class=\"ptime tabular\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"Asr prayer time\">4:15 PM</span></div>\n<div aria-checked=\"true\" aria-label=\"Asr reminder\" class=\"sw on\" data-kid=\"1-2-2-2-3-2\" data-name=\"Asr reminder toggle switch\" role=\"switch\"></div>\n</div>\n<div class=\"row prow\" data-kid=\"1-2-2-2-4\" data-name=\"Maghrib reminder row\">\n<div class=\"left\" data-kid=\"1-2-2-2-4-1\" data-name=\"Maghrib name and time group\"><span class=\"pname\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"Maghrib prayer name\">Maghrib</span><span class=\"ptime tabular\" data-kid=\"1-2-2-2-4-1-2\" data-name=\"Maghrib prayer time\">6:10 PM</span></div>\n<div aria-checked=\"true\" aria-label=\"Maghrib reminder\" class=\"sw on\" data-kid=\"1-2-2-2-4-2\" data-name=\"Maghrib reminder toggle switch\" role=\"switch\"></div>\n</div>\n<div class=\"row prow\" data-kid=\"1-2-2-2-5\" data-name=\"Isha reminder row\">\n<div class=\"left\" data-kid=\"1-2-2-2-5-1\" data-name=\"Isha name and time group\"><span class=\"pname\" data-kid=\"1-2-2-2-5-1-1\" data-name=\"Isha prayer name\">Isha</span><span class=\"ptime tabular\" data-kid=\"1-2-2-2-5-1-2\" data-name=\"Isha prayer time\">8:15 PM</span></div>\n<div aria-checked=\"true\" aria-label=\"Isha reminder\" class=\"sw on\" data-kid=\"1-2-2-2-5-2\" data-name=\"Isha reminder toggle switch\" role=\"switch\"></div>\n</div>\n<div class=\"timing-row press\" data-kid=\"1-2-2-2-6\" data-name=\"reminder timing picker row\">\n<span class=\"lab\" data-kid=\"1-2-2-2-6-1\" data-name=\"reminder timing label\">Reminder timing</span>\n<span class=\"val\" data-kid=\"1-2-2-2-6-2\" data-name=\"reminder timing current value display\">15 min before Iqamah <i class=\"icon-chevron-up\" data-kid=\"1-2-2-2-6-2-1\" data-name=\"upward chevron collapse icon\"></i></span>\n</div>\n<div aria-label=\"Reminder timing\" class=\"tgrid\" data-kid=\"1-2-2-2-7\" data-name=\"reminder timing options grid\" role=\"group\">\n<button aria-pressed=\"false\" data-kid=\"1-2-2-2-7-1\" data-name=\"30-minute reminder option button\">30 min</button>\n<button aria-pressed=\"true\" class=\"on\" data-kid=\"1-2-2-2-7-2\" data-name=\"15-minute reminder option button\">15 min</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-2-2-7-3\" data-name=\"5-minute reminder option button\">5 min</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-2-2-7-4\" data-name=\"at iqamah reminder option button\">At Iqamah</button>\n</div>\n<div class=\"block\" data-kid=\"1-2-2-2-8\" data-name=\"notification sound block\">\n<span class=\"lab\" data-kid=\"1-2-2-2-8-1\" data-name=\"notification sound label\">Notification sound</span>\n<div aria-label=\"Notification sound\" class=\"seg full\" data-kid=\"1-2-2-2-8-2\" data-name=\"notification sound toggle group\" role=\"group\">\n<button aria-pressed=\"true\" class=\"on\" data-kid=\"1-2-2-2-8-2-1\" data-name=\"sound with vibration option button\">Sound with vibration</button>\n<button aria-pressed=\"false\" data-kid=\"1-2-2-2-8-2-2\" data-name=\"silent option button\">Silent</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Announcement push -->\n<section class=\"sect\" data-kid=\"1-2-3\" data-name=\"announcements section\">\n<div class=\"sect-head\" data-kid=\"1-2-3-1\" data-name=\"announcements section header\"><h2 data-kid=\"1-2-3-1-1\" data-name=\"announcements heading\">Announcements</h2></div>\n<div class=\"card\" data-kid=\"1-2-3-2\" data-name=\"announcements card\">\n<div class=\"row tall\" data-kid=\"1-2-3-2-1\" data-name=\"push notifications setting row\">\n<div class=\"push-left\" data-kid=\"1-2-3-2-1-1\" data-name=\"push notifications text group\">\n<span class=\"lab\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"push notifications label\">Push notifications</span>\n<span class=\"push-sub\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"notification permission status text\">Permission: Allowed</span>\n</div>\n<div aria-checked=\"true\" aria-label=\"Announcement push notifications\" class=\"sw on\" data-kid=\"1-2-3-2-1-2\" data-name=\"announcement push toggle switch\" role=\"switch\"></div>\n</div>\n</div>\n</section>\n<!-- Reliability -->\n<section class=\"sect\" data-kid=\"1-2-4\" data-name=\"notification reliability section\">\n<div class=\"sect-head\" data-kid=\"1-2-4-1\" data-name=\"notification reliability section header\"><h2 data-kid=\"1-2-4-1-1\" data-name=\"notification reliability heading\">Notification Reliability</h2></div>\n<div class=\"card\" data-kid=\"1-2-4-2\" data-name=\"notification reliability card\">\n<div class=\"row\" data-kid=\"1-2-4-2-1\" data-name=\"exact alarms row\">\n<span class=\"lab\" data-kid=\"1-2-4-2-1-1\" data-name=\"exact alarms label\">Exact alarms</span>\n<span class=\"flag\" data-kid=\"1-2-4-2-1-2\" data-name=\"exact alarms status pill badge\"><i class=\"icon-circle-check\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"checkmark approval icon\"></i>Allowed</span>\n</div>\n<div class=\"row press\" data-kid=\"1-2-4-2-2\" data-name=\"battery settings navigation row\">\n<span class=\"lab\" data-kid=\"1-2-4-2-2-1\" data-name=\"battery settings label\">Battery settings for this phone</span>\n<i class=\"icon-chevron-right trail\" data-kid=\"1-2-4-2-2-2\" data-name=\"right chevron navigation icon\"></i>\n</div>\n</div>\n</section>\n<!-- Masjid information -->\n<section class=\"sect\" data-kid=\"1-2-5\" data-name=\"masjid information section\">\n<div class=\"sect-head\" data-kid=\"1-2-5-1\" data-name=\"masjid information section header\"><h2 data-kid=\"1-2-5-1-1\" data-name=\"masjid information heading\">Masjid Information</h2></div>\n<div class=\"card\" data-kid=\"1-2-5-2\" data-name=\"masjid information card\">\n<div class=\"addr\" data-kid=\"1-2-5-2-1\" data-name=\"masjid address block\">\n<i class=\"icon-map-pin lead\" data-kid=\"1-2-5-2-1-1\" data-name=\"map pin location icon\"></i>\n<p data-kid=\"1-2-5-2-1-2\" data-name=\"masjid address text\">Skylab Avenue, Sithalapakkam, Tambaram</p>\n</div>\n<div class=\"irow action press\" data-kid=\"1-2-5-2-2\" data-name=\"open in Google Maps action row\">\n<i class=\"icon-external-link lead\" data-kid=\"1-2-5-2-2-1\" data-name=\"external link icon\"></i>\n<span class=\"txt\" data-kid=\"1-2-5-2-2-2\" data-name=\"open in Google Maps link text\">Open in Google Maps</span>\n<i class=\"icon-chevron-right trail\" data-kid=\"1-2-5-2-2-3\" data-name=\"right chevron navigation icon\"></i>\n</div>\n<div class=\"irow press\" data-kid=\"1-2-5-2-3\" data-name=\"phone contact row\">\n<i class=\"icon-phone lead\" data-kid=\"1-2-5-2-3-1\" data-name=\"phone icon\"></i>\n<span class=\"txt tabular\" data-kid=\"1-2-5-2-3-2\" data-name=\"phone number text\">+91 94440 00000</span>\n<i class=\"icon-chevron-right trail\" data-kid=\"1-2-5-2-3-3\" data-name=\"right chevron navigation icon\"></i>\n</div>\n<div class=\"irow press\" data-kid=\"1-2-5-2-4\" data-name=\"privacy policy row\">\n<i class=\"icon-shield lead\" data-kid=\"1-2-5-2-4-1\" data-name=\"shield privacy icon\"></i>\n<span class=\"txt\" data-kid=\"1-2-5-2-4-2\" data-name=\"privacy policy text\">Privacy Policy</span>\n<i class=\"icon-external-link trail\" data-kid=\"1-2-5-2-4-3\" data-name=\"external link chevron icon\"></i>\n</div>\n<div class=\"irow\" data-kid=\"1-2-5-2-5\" data-name=\"app version row\">\n<span class=\"txt\" data-kid=\"1-2-5-2-5-1\" data-name=\"app version label\">Version</span>\n<span class=\"vval tabular\" data-kid=\"1-2-5-2-5-2\" data-name=\"app version number value\">1.0.0</span>\n</div>\n</div>\n</section>\n<div class=\"foot\" data-kid=\"1-2-6\" data-name=\"footer masjid name footer text\">Masjidul Ihsaan · மஸ்ஜிதுல் இஹ்சான்</div>\n</div>\n<div class=\"fade\" data-kid=\"1-3\" data-name=\"scroll fade gradient overlay\"></div>\n<nav class=\"tabbar\" data-kid=\"1-4\" data-name=\"bottom tab bar navigation\">\n<button class=\"tab\" data-kid=\"1-4-1\" data-name=\"home tab navigation button\">\n<svg aria-hidden=\"true\" data-kid=\"1-4-1-1\" data-name=\"house home icon\" viewbox=\"0 0 24 24\"><path d=\"M3 10a2 2 0 0 1 .7-1.5l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><path d=\"M9 21v-7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v7\"></path></svg>\n<span data-kid=\"1-4-1-2\" data-name=\"home tab label\">Home</span>\n</button>\n<button class=\"tab\" data-kid=\"1-4-2\" data-name=\"timetable tab navigation button\">\n<svg aria-hidden=\"true\" data-kid=\"1-4-2-1\" data-name=\"calendar timetable icon\" viewbox=\"0 0 24 24\"><rect height=\"17\" rx=\"3\" width=\"18\" x=\"3\" y=\"4.5\"></rect><path d=\"M3 10h18\"></path><path d=\"M8 3v3\"></path><path d=\"M16 3v3\"></path></svg>\n<span data-kid=\"1-4-2-2\" data-name=\"timetable tab label\">Timetable</span>\n</button>\n<button class=\"tab\" data-kid=\"1-4-3\" data-name=\"notices tab navigation button\">\n<svg aria-hidden=\"true\" data-kid=\"1-4-3-1\" data-name=\"bell notification icon\" viewbox=\"0 0 24 24\"><path d=\"M3.3 15.3A1 1 0 0 0 4 17h16a1 1 0 0 0 .7-1.7C19.4 14 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.4 6-2.7 7.3\"></path><path d=\"M10.3 21a2 2 0 0 0 3.4 0\"></path></svg>\n<span data-kid=\"1-4-3-2\" data-name=\"notices tab label\">Notices</span>\n</button>\n<button class=\"tab on\" data-kid=\"1-4-4\" data-name=\"settings tab navigation button (active)\">\n<svg aria-hidden=\"true\" data-kid=\"1-4-4-1\" data-name=\"gear settings icon\" viewbox=\"0 0 24 24\"><path d=\"M12.2 2h-.4a2 2 0 0 0-2 2v.2a2 2 0 0 1-1 1.7l-.4.2a2 2 0 0 1-2 0l-.2-.1a2 2 0 0 0-2.7.7l-.2.4a2 2 0 0 0 .7 2.7l.2.1a2 2 0 0 1 1 1.7v.6a2 2 0 0 1-1 1.7l-.2.1a2 2 0 0 0-.7 2.7l.2.4a2 2 0 0 0 2.7.7l.2-.1a2 2 0 0 1 2 0l.4.3a2 2 0 0 1 1 1.7v.2a2 2 0 0 0 2 2h.4a2 2 0 0 0 2-2v-.2a2 2 0 0 1 1-1.7l.4-.3a2 2 0 0 1 2 0l.2.1a2 2 0 0 0 2.7-.7l.2-.4a2 2 0 0 0-.7-2.7l-.2-.1a2 2 0 0 1-1-1.7v-.6a2 2 0 0 1 1-1.7l.2-.1a2 2 0 0 0 .7-2.7l-.2-.4a2 2 0 0 0-2.7-.7l-.2.1a2 2 0 0 1-2 0l-.4-.2a2 2 0 0 1-1-1.7V4a2 2 0 0 0-2-2z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg>\n<span data-kid=\"1-4-4-2\" data-name=\"settings tab label\">Settings</span>\n</button>\n</nav>\n</div>",
