        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n:root{\n  --ink:#0A1F17; --ink-border:#122E22;\n  --primary:#0D5C3A; --primary-hover:#094229;\n  --accent:#047857; --tint:#F0F9F5;\n  --gold:#F59E0B; --gold-tint:#FFFDF5; --gold-ink:#B45309;\n  --bg:#F7F6F2; --surface:#FFFFFF; --border:#E6E2DB; --muted:#EFECE7;\n  --text:#18181B; --secondary:#6B6560; --tertiary:#9C9590;\n  --danger:#DC2626; --danger-bg:#FEF2F2;\n  --ease:cubic-bezier(0.22,1,0.36,1);\n}\n*{box-sizing:border-box;}\nhtml,body{margin:0;padding:0;}\nbody{\n  background:var(--bg); color:var(--text);\n  font-family:'Inter','Noto Sans Tamil',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;\n  font-size:14px; line-height:1.45;\n  -webkit-font-smoothing:antialiased;\n}\n.tnum{font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\" 1;}\n.page{width:1440px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;}\n\n/* ── nav ─────────────────────────────────────── */\n.nav{\n  height:64px;flex:0 0 64px;background:var(--ink);border-bottom:1px solid var(--ink-border);\n  display:flex;align-items:center;gap:28px;padding:0 24px;\n}\n.brand{display:flex;align-items:center;gap:10px;}\n.brand-mark{\n  width:26px;height:26px;border-radius:7px;background:rgba(167,213,196,.13);\n  display:flex;align-items:center;justify-content:center;color:#A7D5C4;font-size:15px;\n}\n.brand-name{color:#F2F0EA;font-size:15px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;}\n.nav-links{display:flex;align-items:center;gap:2px;}\n.nav-link{\n  height:32px;padding:0 12px;border-radius:8px;display:inline-flex;align-items:center;\n  color:#A7D5C4;font-size:13.5px;font-weight:500;text-decoration:none;\n  transition:background 200ms var(--ease),color 200ms var(--ease);\n}\n.nav-link:hover{background:rgba(255,255,255,.06);color:#EAE7E0;}\n.nav-link.is-active{background:rgba(255,255,255,.09);color:#FFFFFF;font-weight:600;}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:4px;}\n.nav-quiet{\n  display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;\n  color:#A7D5C4;font-size:13px;text-decoration:none;transition:background 200ms var(--ease);\n}\n.nav-quiet:hover{background:rgba(255,255,255,.06);}\n.nav-quiet i{font-size:13px;}\n.nav-sep{width:1px;height:18px;background:rgba(167,213,196,.22);margin:0 8px;}\n\n/* ── title ───────────────────────────────────── */\n.title-region{padding:22px 24px 18px;display:flex;align-items:flex-end;justify-content:space-between;gap:24px;}\n.h1{font-size:28px;font-weight:600;letter-spacing:-0.02em;margin:0;line-height:1.15;}\n.sub{margin:6px 0 0;font-size:13px;color:var(--secondary);}\n\n/* ── buttons ─────────────────────────────────── */\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;gap:7px;\n  height:40px;padding:0 16px;border-radius:10px;border:1px solid transparent;\n  font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;\n  transition:background 200ms var(--ease),border-color 200ms var(--ease),color 200ms var(--ease);\n  white-space:nowrap;\n}\n.btn i{font-size:14px;}\n.btn-primary{background:var(--primary);color:#fff;}\n.btn-primary:hover{background:var(--primary-hover);}\n.btn-secondary{background:var(--surface);color:var(--text);border-color:var(--border);}\n.btn-secondary:hover{background:#FBFAF7;border-color:#D9D4CB;}\n.btn-quiet{background:transparent;color:var(--secondary);border-color:transparent;padding:0 10px;}\n.btn-quiet:hover{background:var(--muted);color:var(--text);}\n.btn-sm{height:34px;padding:0 12px;font-size:12.5px;border-radius:9px;}\n.btn-sm i{font-size:13px;}\n.btn:focus-visible,.link:focus-visible,.row:focus-visible{\n  outline:2px solid var(--accent);outline-offset:2px;\n}\n.link{\n  background:none;border:0;padding:0;font-family:inherit;font-size:12.5px;\n  color:var(--accent);cursor:pointer;display:inline-flex;align-items:center;gap:4px;\n}\n.link i{font-size:12px;}\n\n/* ── workspace ───────────────────────────────── */\n.workspace{\n  flex:1;padding:0 24px 24px;display:grid;\n  grid-template-columns:560px minmax(0,1fr);gap:20px;align-items:start;\n}\n.panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;}\n\n/* ── register ────────────────────────────────── */\n.register{display:flex;flex-direction:column;overflow:hidden;}\n.reg-head{padding:15px 16px 11px;display:flex;align-items:center;justify-content:space-between;gap:12px;}\n.reg-title{font-size:13px;font-weight:600;letter-spacing:-0.005em;}\n.sort{\n  display:inline-flex;align-items:center;gap:5px;border:0;background:none;\n  font-family:inherit;font-size:12px;color:var(--tertiary);cursor:pointer;padding:2px 0;\n}\n.sort i{font-size:12px;}\n.sort:hover{color:var(--secondary);}\n.reg-filters{padding:0 16px 13px;display:flex;flex-direction:column;gap:8px;}\n.search{position:relative;}\n.search i{\n  position:absolute;left:11px;top:50%;transform:translateY(-50%);\n  font-size:14px;color:var(--tertiary);pointer-events:none;\n}\n.search input{\n  width:100%;height:38px;border-radius:10px;border:1px solid var(--border);\n  background:#FBFAF7;padding:0 12px 0 32px;font-family:inherit;font-size:13px;color:var(--text);\n  transition:border-color 200ms var(--ease),background 200ms var(--ease);\n}\n.search input::placeholder{color:var(--tertiary);}\n.search input:focus{outline:none;border-color:#BFD9CC;background:#fff;box-shadow:0 0 0 3px rgba(4,120,87,.09);}\n.filter-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;}\n.select{position:relative;}\n.select i{\n  position:absolute;right:10px;top:50%;transform:translateY(-50%);\n  font-size:13px;color:var(--tertiary);pointer-events:none;\n}\n.select select{\n  width:100%;height:38px;border-radius:10px;border:1px solid var(--border);background:#FBFAF7;\n  padding:0 28px 0 11px;font-family:inherit;font-size:12.5px;color:var(--text);\n  appearance:none;-webkit-appearance:none;cursor:pointer;\n  transition:border-color 200ms var(--ease);\n}\n.select select:focus{outline:none;border-color:#BFD9CC;box-shadow:0 0 0 3px rgba(4,120,87,.09);}\n\n.reg-list{flex:1;overflow-y:auto;border-top:1px solid var(--border);}\n.reg-list::-webkit-scrollbar{width:9px;}\n.reg-list::-webkit-scrollbar-thumb{background:#DDD8CF;border-radius:9px;border:2px solid #fff;}\n\n.row{\n  position:relative;display:grid;grid-template-columns:minmax(0,1fr) 98px;align-items:center;\n  gap:12px;width:100%;text-align:left;padding:15px 16px;min-height:104px;\n  background:transparent;border:0;border-bottom:1px solid var(--border);\n  font-family:inherit;cursor:pointer;\n  transition:background 200ms var(--ease);\n}\n.row:last-child{border-bottom:0;}\n.row:hover{background:#FBFAF7;}\n.row::before{\n  content:\"\";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--primary);\n  opacity:0;transition:opacity 200ms var(--ease);\n}\n.row.is-selected{background:var(--tint);}\n.row::before{opacity:0;}\n.row.is-active::before{opacity:1;}\n.row-main{min-width:0;}\n.row-title{\n  font-size:13px;font-weight:600;line-height:1.4;letter-spacing:-0.005em;color:var(--text);\n  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;\n}\n.row-meta{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:5px;}\n.cat{font-size:12px;color:var(--secondary);}\n.chip{\n  font-size:9px;font-weight:700;letter-spacing:0.05em;line-height:1;\n  padding:2px 4px;border-radius:4px;border:1px solid var(--border);color:var(--tertiary);\n  text-transform:uppercase;\n}\n.flag-urgent{\n  display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;\n  letter-spacing:0.04em;text-transform:uppercase;color:var(--gold-ink);\n}\n.flag-urgent::before{content:\"\";width:5px;height:5px;border-radius:50%;background:var(--gold);}\n.evt{font-size:11px;color:var(--tertiary);font-variant-numeric:tabular-nums;}\n.row-side{text-align:right;white-space:nowrap;}\n.state{display:block;font-size:10.5px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--secondary);}\n.state.is-draft{color:var(--secondary);}\n.state.is-draft::before{\n  content:\"\";display:inline-block;width:5px;height:5px;border-radius:50%;\n  border:1.2px solid var(--tertiary);margin-right:5px;vertical-align:1px;\n}\n.push-time{display:block;font-size:10.5px;color:var(--tertiary);margin-top:5px;font-variant-numeric:tabular-nums;}\n\n.reg-foot{\n  margin-top:auto;border-top:1px solid var(--border);padding:11px 16px;\n  display:flex;align-items:center;justify-content:space-between;\n  font-size:11.5px;color:var(--tertiary);\n}\n\n/* ── editor ──────────────────────────────────── */\n.editor{display:flex;flex-direction:column;padding:20px;min-width:0;}\n.ed-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding-bottom:16px;border-bottom:1px solid var(--muted);}\n.ed-title{font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0;}\n.ed-state{display:flex;align-items:center;gap:7px;margin:5px 0 0;font-size:12px;color:var(--secondary);}\n.dot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex:0 0 auto;}\n\n.langs{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:16px;}\n.lang-head{\n  display:flex;align-items:center;gap:8px;padding-bottom:9px;border-bottom:1px solid var(--muted);\n}\n.lang-name{font-size:13px;font-weight:600;letter-spacing:-0.005em;}\n.lang-name.ta{font-family:'Noto Sans Tamil','Inter',sans-serif;font-size:14px;line-height:1.2;}\n.chip-lang{\n  font-size:9px;font-weight:700;letter-spacing:0.06em;padding:2px 5px;border-radius:4px;\n  background:var(--muted);color:var(--secondary);text-transform:uppercase;line-height:1.2;\n}\n.field{margin-top:12px;min-width:0;}\n.lbl{display:block;font-size:11.5px;font-weight:500;color:var(--secondary);margin-bottom:6px;letter-spacing:0.005em;}\n.input,.textarea{\n  width:100%;border-radius:10px;border:1px solid var(--border);background:#FBFAF7;\n  font-family:inherit;font-size:13.5px;color:var(--text);\n  transition:border-color 200ms var(--ease),background 200ms var(--ease),box-shadow 200ms var(--ease);\n}\n.input{height:40px;padding:0 12px;}\n.textarea{height:208px;padding:10px 12px;line-height:1.62;resize:none;}\n.input::placeholder,.textarea::placeholder{color:var(--tertiary);}\n.input:focus,.textarea:focus{outline:none;border-color:#BFD9CC;background:#fff;box-shadow:0 0 0 3px rgba(4,120,87,.09);}\n.textarea.ta{font-family:'Noto Sans Tamil','Inter',sans-serif;font-size:14px;line-height:1.75;}\n\n.meta-row{\n  display:grid;grid-template-columns:1fr 1.05fr 1fr 132px;gap:14px;\n  margin-top:18px;padding-top:16px;border-top:1px solid var(--muted);\n}\n.switch-field{min-width:0;}\n.switch{\n  display:inline-flex;align-items:center;gap:9px;height:40px;cursor:pointer;\n}\n.switch input{position:absolute;opacity:0;width:0;height:0;}\n.track{\n  position:relative;width:36px;height:20px;border-radius:99px;background:#D9D4CB;flex:0 0 auto;\n  transition:background 200ms var(--ease);\n}\n.track::after{\n  content:\"\";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;\n  background:#fff;box-shadow:0 1px 2px rgba(10,31,23,.22);\n  transition:transform 200ms var(--ease);\n}\n.switch input:checked + .track{background:var(--primary);}\n.switch input:checked + .track::after{transform:translateX(16px);}\n.switch input:focus-visible + .track{outline:2px solid var(--accent);outline-offset:2px;}\n.switch-text{font-size:12.5px;font-weight:500;color:var(--text);white-space:nowrap;}\n\n.pub{\n  margin-top:16px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;\n  background:#FBFAF7;display:flex;align-items:center;justify-content:space-between;gap:16px;\n}\n.pub-lbl{font-size:10px;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:var(--tertiary);}\n.pub-val{display:flex;align-items:center;gap:7px;margin-top:4px;font-size:13px;color:var(--text);font-variant-numeric:tabular-nums;}\n.pub-val i{font-size:13px;color:var(--secondary);}\n\n.ed-foot{\n  margin-top:auto;padding-top:16px;border-top:1px solid var(--muted);\n  display:flex;align-items:center;justify-content:space-between;gap:16px;\n}\n.saved{font-size:12px;color:var(--tertiary);font-variant-numeric:tabular-nums;}\n.actions{display:flex;align-items:center;gap:8px;}\n\n/* ── motion ──────────────────────────────────── */\n@keyframes rise{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}\n.anim{animation:rise 340ms var(--ease) backwards;}\n.d1{animation-delay:30ms;} .d2{animation-delay:80ms;} .d3{animation-delay:130ms;}\n.d4{animation-delay:180ms;} .d5{animation-delay:230ms;} .d6{animation-delay:280ms;}\n@media (prefers-reduced-motion: reduce){.anim{animation:none;}}\n</style>\n<div class=\"page\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- nav -->\n<nav class=\"nav anim d1\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand group with logo and name\">\n<span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark container\"><svg data-kid=\"1-1-1-1-1\" data-name=\"mosque arch logo icon\" fill=\"none\" height=\"15\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\" width=\"15\"><path d=\"M4 21V11a8 8 0 0 1 16 0v10\"></path><path d=\"M4 21h16\"></path><path d=\"M10 21v-4a2 2 0 0 1 4 0v4\"></path></svg></span>\n<span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">Masjidul Ihsaan</span>\n</div>\n<div class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"primary nav links group\">\n<a class=\"nav-link\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"#\">Dashboard</a>\n<a class=\"nav-link\" data-kid=\"1-1-2-2\" data-name=\"timetable nav link\" href=\"#\">Timetable</a>\n<a aria-current=\"page\" class=\"nav-link is-active\" data-kid=\"1-1-2-3\" data-name=\"announcements nav link (active page)\" href=\"#\">Announcements</a>\n<a class=\"nav-link\" data-kid=\"1-1-2-4\" data-name=\"settings nav link\" href=\"#\">Settings</a>\n</div>\n<div class=\"nav-right\" data-kid=\"1-1-3\" data-name=\"nav right actions group\">\n<a class=\"nav-quiet\" data-kid=\"1-1-3-1\" data-name=\"view public site link\" href=\"#\"><span data-kid=\"1-1-3-1-1\" data-name=\"view public site link label\">View public site</span><i class=\"icon-external-link\" data-kid=\"1-1-3-1-2\" data-name=\"external link icon\"></i></a>\n<span class=\"nav-sep\" data-kid=\"1-1-3-2\" data-name=\"nav vertical separator\"></span>\n<a class=\"nav-quiet\" data-kid=\"1-1-3-3\" data-name=\"sign out link\" href=\"#\">Sign out</a>\n</div>\n</nav>\n<!-- title -->\n<header class=\"title-region anim d2\" data-kid=\"1-2\" data-name=\"page title region\">\n<div data-kid=\"1-2-1\" data-name=\"page title and subtitle group\">\n<h1 class=\"h1\" data-kid=\"1-2-1-1\" data-name=\"page headline text\">Announcements</h1>\n<p class=\"sub\" data-kid=\"1-2-1-2\" data-name=\"page record count subtitle\">5 records · 1 draft</p>\n</div>\n<button class=\"btn btn-primary\" data-kid=\"1-2-2\" data-name=\"primary new announcement button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-2-2-1\" data-name=\"add plus icon\"></i><span data-kid=\"1-2-2-2\" data-name=\"button label text\">New announcement</span></button>\n</header>\n<!-- workspace -->\n<main class=\"workspace\" data-kid=\"1-3\" data-name=\"workspace grid with register and editor\">\n<!-- register -->\n<section aria-label=\"Announcements\" class=\"panel register anim d3\" data-kid=\"1-3-1\" data-name=\"announcements register panel\">\n<div class=\"reg-head\" data-kid=\"1-3-1-1\" data-name=\"register header with title and sort\">\n<span class=\"reg-title\" data-kid=\"1-3-1-1-1\" data-name=\"register section title\">All announcements</span>\n<button class=\"sort\" data-kid=\"1-3-1-1-2\" data-name=\"sort order toggle button\" type=\"button\">Newest first<i class=\"icon-chevron-down\" data-kid=\"1-3-1-1-2-1\" data-name=\"sort chevron down icon\"></i></button>\n</div>\n<div class=\"reg-filters\" data-kid=\"1-3-1-2\" data-name=\"register filters group\">\n<div class=\"search\" data-kid=\"1-3-1-2-1\" data-name=\"search box wrapper\">\n<i class=\"icon-search\" data-kid=\"1-3-1-2-1-1\" data-name=\"search magnifier icon\"></i>\n<input aria-label=\"Search announcements\" data-kid=\"1-3-1-2-1-2\" data-name=\"search announcements input field\" placeholder=\"Search title or body\" type=\"search\"/>\n</div>\n<div class=\"filter-row\" data-kid=\"1-3-1-2-2\" data-name=\"filter dropdowns row\">\n<div class=\"select\" data-kid=\"1-3-1-2-2-1\" data-name=\"category filter wrapper\">\n<select aria-label=\"Filter by category\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"category filter select\">\n<option data-kid=\"1-3-1-2-2-1-1-1\" data-name=\"filter option all categories\">All categories</option>\n<option data-kid=\"1-3-1-2-2-1-1-2\" data-name=\"filter option bayan lecture\">Bayan / Lecture</option>\n<option data-kid=\"1-3-1-2-2-1-1-3\" data-name=\"filter option schedule change\">Schedule Change</option>\n<option data-kid=\"1-3-1-2-2-1-1-4\" data-name=\"filter option community welfare\">Community / Welfare</option>\n<option data-kid=\"1-3-1-2-2-1-1-5\" data-name=\"filter option general\">General</option>\n<option data-kid=\"1-3-1-2-2-1-1-6\" data-name=\"filter option ramadan\">Ramadan</option>\n<option data-kid=\"1-3-1-2-2-1-1-7\" data-name=\"filter option janazah\">Janazah</option>\n</select>\n<i class=\"icon-chevron-down\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"category dropdown chevron icon\"></i>\n</div>\n<div class=\"select\" data-kid=\"1-3-1-2-2-2\" data-name=\"state filter wrapper\">\n<select aria-label=\"Filter by state\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"state filter select\">\n<option data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"filter option all states\">All states</option>\n<option data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"filter option published\">Published</option>\n<option data-kid=\"1-3-1-2-2-2-1-3\" data-name=\"filter option draft\">Draft</option>\n</select>\n<i class=\"icon-chevron-down\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"state dropdown chevron icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"reg-list\" data-kid=\"1-3-1-3\" data-name=\"announcement list\">\n<button aria-current=\"true\" class=\"row is-active\" data-kid=\"1-3-1-3-1\" data-name=\"announcement row (active selected)\" type=\"button\">\n<span class=\"row-main\" data-kid=\"1-3-1-3-1-1\" data-name=\"announcement row main content\">\n<span class=\"row-title\" data-kid=\"1-3-1-3-1-1-1\" data-name=\"announcement title\">Isha Iqamah moved to 8:15 PM from this week</span>\n<span class=\"row-meta\" data-kid=\"1-3-1-3-1-1-2\" data-name=\"announcement meta row\">\n<span class=\"cat\" data-kid=\"1-3-1-3-1-1-2-1\" data-name=\"meta category label\">Schedule change</span>\n<span class=\"chip\" data-kid=\"1-3-1-3-1-1-2-2\" data-name=\"language chip EN\">EN</span>\n<span class=\"chip\" data-kid=\"1-3-1-3-1-1-2-3\" data-name=\"language chip TA\">TA</span>\n<span class=\"flag-urgent\" data-kid=\"1-3-1-3-1-1-2-4\" data-name=\"urgent flag badge\">Urgent</span>\n</span>\n</span>\n<span class=\"row-side\" data-kid=\"1-3-1-3-1-2\" data-name=\"announcement row side info\">\n<span class=\"state\" data-kid=\"1-3-1-3-1-2-1\" data-name=\"state published label\">Published</span>\n<span class=\"push-time\" data-kid=\"1-3-1-3-1-2-2\" data-name=\"push time text\">Push 8:14 PM</span>\n</span>\n</button>\n<button class=\"row\" data-kid=\"1-3-1-3-2\" data-name=\"announcement row false\" type=\"button\">\n<span class=\"row-main\" data-kid=\"1-3-1-3-2-1\" data-name=\"announcement row main content\">\n<span class=\"row-title\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"announcement title\">Weekly Jumu'ah Baya