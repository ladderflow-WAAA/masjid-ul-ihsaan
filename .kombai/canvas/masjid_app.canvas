\"announcement title\">Ramadan Timetable Preparation Meeting</span>\n<span class=\"row-meta\" data-kid=\"1-3-1-3-4-1-2\" data-name=\"announcement meta row\">\n<span class=\"cat\" data-kid=\"1-3-1-3-4-1-2-1\" data-name=\"meta category label\">Ramadan</span>\n<span class=\"chip\" data-kid=\"1-3-1-3-4-1-2-2\" data-name=\"language chip EN\">EN</span>\n<span class=\"chip\" data-kid=\"1-3-1-3-4-1-2-3\" data-name=\"language chip TA\">TA</span>\n</span>\n</span>\n<span class=\"row-side\" data-kid=\"1-3-1-3-4-2\" data-name=\"announcement row side info\">\n<span class=\"state is-draft\" data-kid=\"1-3-1-3-4-2-1\" data-name=\"state draft label\">Draft</span>\n</span>\n</button>\n<button class=\"row\" data-kid=\"1-3-1-3-5\" data-name=\"announcement row\" type=\"button\">\n<span class=\"row-main\" data-kid=\"1-3-1-3-5-1\" data-name=\"announcement row main content\">\n<span class=\"row-title\" data-kid=\"1-3-1-3-5-1-1\" data-name=\"announcement title\">Madrasa winter break dates</span>\n<span class=\"row-meta\" data-kid=\"1-3-1-3-5-1-2\" data-name=\"announcement meta row\">\n<span class=\"cat\" data-kid=\"1-3-1-3-5-1-2-1\" data-name=\"meta category label\">General</span>\n<span class=\"chip\" data-kid=\"1-3-1-3-5-1-2-2\" data-name=\"language chip EN\">EN</span>\n</span>\n</span>\n<span class=\"row-side\" data-kid=\"1-3-1-3-5-2\" data-name=\"announcement row side info\">\n<span class=\"state\" data-kid=\"1-3-1-3-5-2-1\" data-name=\"state published label\">Published</span>\n</span>\n</button>\n</div>\n<div class=\"reg-foot\" data-kid=\"1-3-1-4\" data-name=\"register footer\">\n<span data-kid=\"1-3-1-4-1\" data-name=\"total records count\">5 records</span>\n<span data-kid=\"1-3-1-4-2\" data-name=\"draft count\">1 draft</span>\n</div>\n</section>\n<!-- editor -->\n<section aria-label=\"Edit announcement\" class=\"panel editor anim d4\" data-kid=\"1-3-2\" data-name=\"announcement editor panel\">\n<div class=\"ed-head\" data-kid=\"1-3-2-1\" data-name=\"editor header\">\n<div data-kid=\"1-3-2-1-1\" data-name=\"editor title and status group\">\n<h2 class=\"ed-title\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-1\" data-name=\"editor heading\" data-reason=\"editor content is populated by JS based on selected row\">Edit announcement</h2>\n<p class=\"ed-state\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2\" data-name=\"editor publication status row\" data-reason=\"status text and dot reflect selected row, updated by script\"><span class=\"dot\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"status indicator dot\"></span><span data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"publication date text\" data-reason=\"text reflects selected announcement, updated by script\">Published 4 November 2026</span></p>\n</div>\n<button class=\"btn btn-secondary btn-sm\" data-kid=\"1-3-2-1-2\" data-name=\"preview button\" type=\"button\"><i class=\"icon-eye\" data-kid=\"1-3-2-1-2-1\" data-name=\"eye preview icon\"></i><span data-kid=\"1-3-2-1-2-2\" data-name=\"preview button label\">Preview</span></button>\n</div>\n<div class=\"langs\" data-kid=\"1-3-2-2\" data-name=\"language translation grid\">\n<!-- English -->\n<div class=\"lang-col\" data-kid=\"1-3-2-2-1\" data-name=\"English language column\">\n<div class=\"lang-head\" data-kid=\"1-3-2-2-1-1\" data-name=\"language column header\">\n<span class=\"lang-name\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"English language name\">English</span>\n<span class=\"chip-lang\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"language code chip EN\">EN</span>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-2-1-2\" data-name=\"title form field\">\n<label class=\"lbl\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"title field label\" for=\"title-en\">Title</label>\n<input class=\"input\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2-2\" data-name=\"English title input field\" data-reason=\"value populated by JS from selected row\" id=\"title-en\" type=\"text\" value=\"Isha Iqamah moved to 8:15 PM from this week\"/>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-2-1-3\" data-name=\"body form field\">\n<label class=\"lbl\" data-kid=\"1-3-2-2-1-3-1\" data-name=\"body field label\" for=\"body-en\">Body</label>\n<textarea class=\"textarea\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-3-2\" data-name=\"English body textarea\" data-reason=\"value populated by JS from selected row\" id=\"body-en\">From Sunday 8 November, the Isha Iqamah moves from 7:45 PM to 8:15 PM. The change follows the updated timetable issued for this month. Please reach the masjid a few minutes before the Iqamah so the congregation can begin together.</textarea>\n</div>\n</div>\n<!-- Tamil -->\n<div class=\"lang-col\" data-kid=\"1-3-2-2-2\" data-name=\"Tamil language column\">\n<div class=\"lang-head\" data-kid=\"1-3-2-2-2-1\" data-name=\"language column header\">\n<span class=\"lang-name ta\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"Tamil language name\">தமிழ்</span>\n<span class=\"chip-lang\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"language code chip TA\">TA</span>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-2-2-2\" data-name=\"title form field\">\n<label class=\"lbl\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"title field label (Tamil)\" for=\"title-ta\">தலைப்பு</label>\n<input class=\"input ta\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"Tamil title input field\" data-reason=\"value populated by JS from selected row\" id=\"title-ta\" type=\"text\" value=\"இஷா இகாமத் இன்று முதல் இரவு 8:15\"/>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-2-2-3\" data-name=\"body form field\">\n<label class=\"lbl\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"body field label (Tamil)\" for=\"body-ta\">விவரம்</label>\n<textarea class=\"textarea ta\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"Tamil body textarea\" data-reason=\"value populated by JS from selected row\" id=\"body-ta\">நவம்பர் 8 ஞாயிற்றுக்கிழமை முதல் இஷா இகாமத் இரவு 8:15 மணிக்கு நடைபெறும். இந்த மாதத்திற்கான புதுப்பிக்கப்பட்ட நேர அட்டவணையின்படி இந்த மாற்றம் செய்யப்பட்டுள்ளது. இகாமத்திற்கு சில நிமிடங்கள் முன்பே வந்து சேருமாறு கேட்டுக்கொள்கிறோம்.</textarea>\n</div>\n</div>\n</div>\n<!-- metadata -->\n<div class=\"meta-row\" data-kid=\"1-3-2-3\" data-name=\"metadata fields row\">\n<div class=\"field\" data-kid=\"1-3-2-3-1\" data-name=\"category field\" style=\"margin-top:0;\">\n<label class=\"lbl\" data-kid=\"1-3-2-3-1-1\" data-name=\"category field label\" for=\"cat\">Category</label>\n<div class=\"select\" data-kid=\"1-3-2-3-1-2\" data-name=\"category select wrapper\">\n<select data-dynamic=\"true\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"category select\" data-reason=\"selected option updated by JS from selected row\" id=\"cat\">\n<option data-kid=\"1-3-2-3-1-2-1-1\" data-name=\"category option general\">General</option>\n<option data-kid=\"1-3-2-3-1-2-1-2\" data-name=\"category option bayan lecture\">Bayan / Lecture</option>\n<option data-kid=\"1-3-2-3-1-2-1-3\" data-name=\"category option schedule change\" selected=\"\">Schedule change</option>\n<option data-kid=\"1-3-2-3-1-2-1-4\" data-name=\"category option community welfare\">Community / Welfare</option>\n<option data-kid=\"1-3-2-3-1-2-1-5\" data-name=\"category option ramadan\">Ramadan</option>\n<option data-kid=\"1-3-2-3-1-2-1-6\" data-name=\"category option janazah\">Janazah</option>\n</select>\n<i class=\"icon-chevron-down\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"category dropdown chevron icon\"></i>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-3-2\" data-name=\"speaker field\" style=\"margin-top:0;\">\n<label class=\"lbl\" data-kid=\"1-3-2-3-2-1\" data-name=\"speaker field label\" for=\"speaker\">Speaker</label>\n<input class=\"input\" data-dynamic=\"true\" data-kid=\"1-3-2-3-2-2\" data-name=\"speaker input field\" data-reason=\"value populated by JS from selected row\" id=\"speaker\" placeholder=\"Moulavi Abdul Rahman\" type=\"text\"/>\n</div>\n<div class=\"field\" data-kid=\"1-3-2-3-3\" data-name=\"event date field\" style=\"margin-top:0;\">\n<label class=\"lbl\" data-kid=\"1-3-2-3-3-1\" data-name=\"event date field label\" for=\"event\">Event date and time</label>\n<input class=\"input tnum\" data-dynamic=\"true\" data-kid=\"1-3-2-3-3-2\" data-name=\"event date input field\" data-reason=\"value populated by JS from selected row\" id=\"event\" placeholder=\"dd/mm/yyyy, --:--\" type=\"text\"/>\n</div>\n<div class=\"switch-field\" data-kid=\"1-3-2-3-4\" data-name=\"urgent notice field\">\n<span class=\"lbl\" data-kid=\"1-3-2-3-4-1\" data-name=\"urgent notice field label\">Urgent notice</span>\n<label class=\"switch\" data-kid=\"1-3-2-3-4-2\" data-name=\"urgent toggle switch\">\n<input aria-label=\"Mark as urgent notice\" checked=\"\" data-dynamic=\"true\" data-kid=\"1-3-2-3-4-2-1\" data-name=\"urgent checkbox input\" data-reason=\"checked state updated by JS from selected row\" type=\"checkbox\"/>\n<span class=\"track\" data-kid=\"1-3-2-3-4-2-2\" data-name=\"switch track\"></span>\n</label>\n</div>\n</div>\n<!-- publication -->\n<div class=\"pub\" data-kid=\"1-3-2-4\" data-name=\"publication delivery section\">\n<div data-kid=\"1-3-2-4-1\" data-name=\"delivery info group\">\n<span class=\"pub-lbl\" data-kid=\"1-3-2-4-1-1\" data-name=\"delivery label\">Delivery</span>\n<span class=\"pub-val\" data-dynamic=\"true\" data-kid=\"1-3-2-4-1-2\" data-name=\"delivery value text\" data-reason=\"value reflects selected announcement, updated by script\"><i class=\"icon-send\" data-kid=\"1-3-2-4-1-2-1\" data-name=\"send icon\"></i><span data-dynamic=\"true\" data-kid=\"1-3-2-4-1-2-2\" data-name=\"push sent timestamp text\" data-reason=\"text reflects selected announcement, updated by script\">Push sent 4 Nov 2026, 8:14 PM</span></span>\n</div>\n<button class=\"btn btn-secondary btn-sm\" data-kid=\"1-3-2-4-2\" data-name=\"resend push button\" type=\"button\"><i class=\"icon-repeat\" data-kid=\"1-3-2-4-2-1\" data-name=\"repeat/resend icon\"></i><span data-kid=\"1-3-2-4-2-2\" data-name=\"resend button label\">Resend push</span></button>\n</div>\n<!-- footer -->\n<div class=\"ed-foot\" data-kid=\"1-3-2-5\" data-name=\"editor footer\">\n<span class=\"saved\" data-dynamic=\"true\" data-kid=\"1-3-2-5-1\" data-name=\"last saved timestamp\" data-reason=\"text updated by JS on save interactions\">Last saved 4 Nov 2026, 8:14 PM</span>\n<div class=\"actions\" data-kid=\"1-3-2-5-2\" data-name=\"action buttons group\">\n<button class=\"btn btn-secondary\" data-kid=\"1-3-2-5-2-1\" data-name=\"save draft button\" type=\"button\">Save Draft</button>\n<button class=\"btn btn-primary\" data-kid=\"1-3-2-5-2-2\" data-name=\"publish now button\" type=\"button\">Publish Now</button>\n</div>\n</div>\n</section>\n</main>\n</div>\n<script>\n(function(){\n  var rows = Array.prototype.slice.call(document.querySelectorAll('.row'));\n  rows.forEach(function(row){\n    row.addEventListener('click', function(){\n      rows.forEach(function(r){ r.classList.remove('is-active'); r.removeAttribute('aria-current'); });\n      row.classList.add('is-active');\n      row.setAttribute('aria-current','true');\n    });\n  });\n})();\n</script>\n",
